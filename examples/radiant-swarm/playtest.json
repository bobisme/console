{
  "version": 1,
  "seed": 11,
  "stages": [
    {"op": "hook", "name": "title", "hook": "status", "expect": {"op": "equals", "field": "phase", "value": "title"}},
    {"op": "hook", "name": "dense_setup", "hook": "stress"},
    {"op": "hook", "name": "playing", "hook": "status", "expect": {"op": "equals", "field": "phase", "value": "play"}},
    {"op": "input", "name": "focus_fire", "frames": 180, "buttons": "A"},
    {"op": "hook", "name": "dense_entities", "hook": "status", "expect": {"op": "at_least", "field": "peak_alive", "value": 250}},
    {"op": "hook", "name": "dense_bullets", "hook": "status", "expect": {"op": "at_least", "field": "peak_bullets", "value": 120}},
    {"op": "hook", "name": "formation_language", "hook": "status", "expect": {"op": "not_equals", "field": "formation", "value": ""}},
    {"op": "hook", "name": "within_capacity", "hook": "status", "expect": {"op": "equals", "field": "dropped_spawns", "value": 0}},
    {
      "op": "capture",
      "name": "storm_frame",
      "screenshot": "storm.png",
      "zoom": 2,
      "audio_stats": "storm-audio-stats.json"
    },
    {"op": "input", "name": "nova", "frames": 1, "buttons": "B"},
    {"op": "hook", "name": "nova_feedback", "hook": "status", "expect": {"op": "greater_than", "field": "nova_flash", "value": 0}},
    {"op": "input", "name": "release", "frames": 20, "buttons": ""},
    {"op": "hook", "name": "bomb_spent", "hook": "status", "expect": {"op": "equals", "field": "bombs", "value": 2}},
    {
      "op": "sequence",
      "name": "swarm_motion",
      "frames": 90,
      "every": 15,
      "buttons": "LA",
      "crop": [0, 20, 192, 300],
      "zoom": 2,
      "gif": "swarm.gif",
      "strip": "swarm-contact.png"
    },
    {
      "op": "capture",
      "name": "post_nova",
      "screenshot": "post-nova.png",
      "zoom": 2,
      "screen_text": "dense.txt",
      "wav": "dense.wav",
      "audio_events": "audio-events.json",
      "audio_stats": "audio-stats.json"
    },
    {"op": "input", "name": "advance_to_boss", "frames": 249, "buttons": ""},
    {"op": "hook", "name": "choir_arrives", "hook": "status", "expect": {"op": "equals", "field": "boss_phase", "value": 1}},
    {"op": "capture", "name": "choir_phase_one", "screenshot": "choir-phase-one.png", "zoom": 2},
    {"op": "hook", "name": "force_counterpoint", "hook": "damage_boss", "args": 90},
    {"op": "input", "name": "enter_counterpoint", "frames": 1, "buttons": ""},
    {"op": "hook", "name": "counterpoint_phase", "hook": "status", "expect": {"op": "equals", "field": "boss_phase", "value": 2}},
    {"op": "hook", "name": "counterpoint_clears_field", "hook": "status", "expect": {"op": "equals", "field": "enemy_bullets", "value": 0}},
    {"op": "capture", "name": "choir_transition", "screenshot": "choir-transition.png", "zoom": 2}
  ]
}
