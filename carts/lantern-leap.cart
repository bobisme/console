__meta__
title=Lantern Leap
author=OpenAI Codex
version=2
preview_palette=48,41,36,38,31,14,11,4,1,2,5,7,63,59,55,52

__lua__
-- LANTERN LEAP
-- A compact vertical platformer built as a console authoring stress test.
-- Same seed + same input remains deterministic: no wall clock, pairs(), or math.random.

local STONE, MOSS, CRUMBLE = 128, 129, 130
local SPIKE, EMBER, GATE = 131, 68, 133
local EXIT, SPRING, VINE, LAVA = 134, 135, 136, 137
local SHRINE = 138
local STONE_CHIP, STONE_RUNE = 139, 140
local MOSS_TUFT, MOSS_BLOOM, LAVA_BUBBLE = 141, 142, 143
local PW, PH = 7, 15
local GRAVITY, MAX_FALL = 0.24, 4.8
local SW, SH, HUD_H = 192, 320, 12
local TOWER_X, TOWER_W, WORLD_H = 24, 144, 512
local MAX_CAM, FOLLOW_Y = WORLD_H - (SH-HUD_H), 144
local CX = SW / 2

-- The sprite sheet keeps a compact 0-f ink vocabulary, but each ink has a
-- stable visual job. Keep this map semantic rather than spreading arbitrary
-- Apollo64 indices through the authored art:
--   shadow, violet, red, orange, lantern gold, moss light, moss dark, teal,
--   midnight, blue, sky, cyan, moon white, mist, stone, stone shadow.
local INK_MAP = {
  48, 41, 36, 38, 31, 14, 11, 4,
   1,  2,  5,  7, 63, 59, 55, 52
}

game_scene = "title"
player_x, player_y = 104, 480
embers, gate_open, deaths = 0, false, 0
game_camera = MAX_CAM
player_mode = "normal"

local vx, vy = 0, 0
local face_left, grounded, on_vine = false, false, false
local coyote, jump_buffer = 0, 0
local dash_ready, dash_timer, dash_t0 = true, 0, 0
local hurt_timer, hurt_t0 = 0, 0
local checkpoint_x, checkpoint_y = 104, 480
local transition, flash, shake, land_pulse = 0, 0, 0, 0
local paused, show_help = false, true
local particles, stars = {}, {}
local frame_now = 0

local ember_cells = {{6,57}, {14,45}, {3,17}}
local crumble_cells = {{6,50}, {7,50}, {7,30}, {8,30}, {9,30}, {12,14}, {13,14}}
local shrine_cells = {{2,9}, {13,41}, {3,55}}
local moths = {{20,433,0}, {116,372,19}, {31,276,37}, {108,205,11}, {28,92,53}}

local function frame_count()
  return flr(t() * 60)
end

local function stone_tile(tile)
  return tile == STONE or tile == STONE_CHIP or tile == STONE_RUNE
end

local function moss_tile(tile)
  return tile == MOSS or tile == MOSS_TUFT or tile == MOSS_BLOOM
end

local function lava_tile(tile)
  return tile == LAVA or tile == LAVA_BUBBLE
end

local function solid(tile)
  return stone_tile(tile) or moss_tile(tile) or tile == CRUMBLE
      or tile == GATE or tile == SPRING
end

local function apply_tile_variants()
  for cy = 0, 63 do
    for cx = 0, 17 do
      local tile = mget(cx, cy)
      local h = (cx*17 + cy*29 + cx*cy*3) % 17
      if stone_tile(tile) then
        mset(cx, cy, h == 0 and STONE_RUNE or h < 5 and STONE_CHIP or STONE)
      elseif moss_tile(tile) then
        mset(cx, cy, h == 0 and MOSS_BLOOM or h < 6 and MOSS_TUFT or MOSS)
      elseif lava_tile(tile) then
        mset(cx, cy, h < 6 and LAVA_BUBBLE or LAVA)
      end
    end
  end
end

local function tile_at(x, y)
  return mget(flr(x / 8), flr(y / 8))
end

local function solid_box(x, y)
  local x0, x1 = flr(x / 8), flr((x + PW - 1) / 8)
  local y0, y1 = flr(y / 8), flr((y + PH - 1) / 8)
  for cy = y0, y1 do
    for cx = x0, x1 do
      local tile = mget(cx, cy)
      if solid(tile) then return tile, cx, cy end
    end
  end
  return nil, nil, nil
end

local function touches(tile_wanted)
  local x0, x1 = flr(player_x / 8), flr((player_x + PW - 1) / 8)
  local y0, y1 = flr(player_y / 8), flr((player_y + PH - 1) / 8)
  for cy = y0, y1 do
    for cx = x0, x1 do
      if mget(cx, cy) == tile_wanted then return true, cx, cy end
    end
  end
  return false, nil, nil
end

local function spawn_sparks(x, y, color, count, force)
  for i = 1, count do
    local a = rnd(1)
    local speed = 0.35 + rnd(force)
    particles[#particles + 1] = {
      x=x, y=y, dx=cos(a)*speed, dy=sin(a)*speed-0.45,
      life=16+flr(rnd(18)), color=color + flr(rnd(2))
    }
  end
end

local function reset_player()
  player_x, player_y = checkpoint_x, checkpoint_y
  vx, vy = 0, 0
  player_mode = "normal"
  grounded, on_vine, dash_ready = false, false, true
  coyote, jump_buffer = 0, 0
  transition, flash = 10, 0
  master(1, 1, 0)
  echo(12, 4, 3)
end

local function open_gate()
  if gate_open then return end
  gate_open = true
  for cy = 3, 5 do
    if mget(8, cy) == GATE then mset(8, cy, 0) end
  end
  sfx(14)
  shake, flash = 12, 3
  spawn_sparks(68, 40, 4, 28, 2.2)
  printh("gate opened at frame " .. frame_count())
end

local function start_game()
  game_scene = "play"
  player_x, player_y = 104, 480
  checkpoint_x, checkpoint_y = 104, 480
  vx, vy = 0, 0
  embers, gate_open, deaths = 0, false, 0
  player_mode, paused = "normal", false
  dash_ready, grounded = true, false
  transition, flash, shake = 12, 0, 0
  game_camera = MAX_CAM
  particles = {}
  -- Reset every authored mutation so RESET and deterministic replays agree.
  for i = 1, #ember_cells do
    mset(ember_cells[i][1], ember_cells[i][2], EMBER)
  end
  for cy = 3, 5 do mset(8, cy, GATE) end
  for i = 1, #crumble_cells do
    mset(crumble_cells[i][1], crumble_cells[i][2], CRUMBLE)
  end
  apply_tile_variants()
  music(0)
  master(1, 1, 0)
  echo(12, 4, 3)
  printh("lantern leap start")
end

local function begin_hurt(reason)
  if player_mode == "hurt" then return end
  deaths = deaths + 1
  player_mode, hurt_timer, hurt_t0 = "hurt", 28, frame_now
  vx, vy = 0, -2.6
  flash, shake = 4, 10
  echo(0)
  sfx(12)
  printh("hurt " .. reason .. " at frame " .. frame_now)
end

local function win_game()
  if game_scene == "win" then return end
  game_scene, transition = "win", 0
  music(-1)
  master(4, 2, 0)
  echo(18, 6, 6)
  sfx(15)
  spawn_sparks(player_x+3, player_y+7, 4, 64, 3.0)
  printh("tower lit in " .. frame_now .. " frames with " .. deaths .. " falls")
end

local function move_x(amount)
  local remain, dir = abs(amount), amount < 0 and -1 or 1
  while remain > 0 do
    local step = min(1, remain) * dir
    local hit = solid_box(player_x + step, player_y)
    if hit then
      vx = 0
      return dir
    end
    player_x = player_x + step
    remain = remain - abs(step)
  end
  return 0
end

local function break_crumble(cx, cy)
  local broke = false
  for tx = flr(player_x/8), flr((player_x+PW-1)/8) do
    if mget(tx, cy) == CRUMBLE then
      mset(tx, cy, 0)
      spawn_sparks(tx*8+4, cy*8+2, 3, 8, 1.5)
      broke = true
    end
  end
  if broke then
    sfx(11)
    shake = 7
  end
  return broke
end

local function move_y(amount)
  grounded = false
  local remain, dir = abs(amount), amount < 0 and -1 or 1
  while remain > 0 do
    local step = min(1, remain) * dir
    local hit, cx, cy = solid_box(player_x, player_y + step)
    if hit then
      if dir > 0 and player_mode == "stomp" and hit == CRUMBLE
          and break_crumble(cx, cy) then
        -- Keep falling through the newly opened tiles.
      elseif dir > 0 and hit == SPRING then
        player_y = cy * 8 - PH
        vy, grounded, dash_ready = -7.2, false, true
        player_mode = "normal"
        sfx(13)
        spawn_sparks(player_x+3, player_y+PH, 5, 12, 1.7)
        return
      else
        vy = 0
        if dir > 0 then
          grounded, dash_ready = true, true
          if player_mode == "stomp" then
            player_mode, shake = "normal", 5
            sfx(11)
          end
        end
        return
      end
    else
      player_y = player_y + step
    end
    remain = remain - abs(step)
  end
end

local function wisp_position(index, lag)
  local tt = t() - (lag or 0)
  if index == 1 then
    return 24 + sin(tt*0.17)*34, 283 + sin(tt*0.31)*10
  end
  return 76 + sin(tt*0.11+0.3)*42, 126 + cos(tt*0.23)*12
end

local function update_particles()
  for i = #particles, 1, -1 do
    local p = particles[i]
    p.x, p.y = p.x+p.dx, p.y+p.dy
    p.dy, p.life = p.dy+0.055, p.life-1
    if p.life <= 0 then table.remove(particles, i) end
  end
end

local function update_play()
  if btnp(6) then
    paused = not paused
    if paused then sfx(-1) else sfx(10) end
    printh(paused and "paused" or "resumed")
  end
  if paused then return end

  local was_airborne = not grounded

  if player_mode == "hurt" then
    hurt_timer = hurt_timer - 1
    vy = min(MAX_FALL, vy + GRAVITY)
    move_y(vy)
    -- One-shot animation state is inspected even though recovery has a longer hold.
    if anim_done("player.hurt", hurt_t0) and hurt_timer <= 0 then reset_player() end
    return
  end

  if btnp(4) then jump_buffer = 7 end
  if jump_buffer > 0 then jump_buffer = jump_buffer - 1 end
  if grounded then coyote = 6 elseif coyote > 0 then coyote = coyote - 1 end

  local vine_touch = touches(VINE)
  on_vine = vine_touch and (btn(2) or btn(3)) and player_mode ~= "dash"
  if on_vine then
    vx = vx * 0.7
    vy = (btn(2) and -1.25 or 0) + (btn(3) and 1.25 or 0)
    dash_ready = true
    if btnp(4) then
      on_vine, vy, jump_buffer = false, -4.5, 0
      vx = face_left and 2.3 or -2.3
      sfx(8)
    end
  elseif player_mode ~= "dash" then
    local accel = grounded and 0.22 or 0.14
    if btn(0) then vx, face_left = max(-1.65, vx-accel), true end
    if btn(1) then vx, face_left = min(1.65, vx+accel), false end
    if not btn(0) and not btn(1) then vx = vx * (grounded and 0.72 or 0.94) end

    if jump_buffer > 0 and coyote > 0 then
      vy, grounded, coyote, jump_buffer = -4.75, false, 0, 0
      sfx(8)
      spawn_sparks(player_x+3, player_y+PH, 5, 5, 0.8)
    end
    local gravity = (vy < 0 and btn(4)) and GRAVITY*0.48 or GRAVITY
    vy = min(MAX_FALL, vy + gravity)
    if btnp(3) and not grounded and vy > -1 then
      player_mode, vy = "stomp", 5.2
      sfx(11)
    end
  end

  if btnp(5) and dash_ready and player_mode ~= "dash" then
    local dx = (btn(0) and -1 or 0) + (btn(1) and 1 or 0)
    local dy = (btn(2) and -1 or 0) + (btn(3) and 1 or 0)
    if dx == 0 and dy == 0 then dx = face_left and -1 or 1 end
    if dx ~= 0 and dy ~= 0 then dx, dy = dx*0.72, dy*0.72 end
    vx, vy = dx*4.2, dy*4.2
    face_left = dx < 0
    player_mode, dash_ready, dash_timer, dash_t0 = "dash", false, 9, frame_now
    echo(4, 3, 5)
    sfx(9)
    spawn_sparks(player_x+3, player_y+7, 10, 10, 1.3)
  end

  if player_mode == "dash" then
    dash_timer = dash_timer - 1
    move_x(vx)
    move_y(vy)
    if dash_timer <= 0 or anim_done("player.dash", dash_t0) then
      player_mode = "normal"
      vx, vy = vx*0.45, vy*0.35
      echo(12, 4, 3)
    end
  else
    move_x(vx)
    move_y(vy)
  end

  if was_airborne and grounded then
    land_pulse = 8
    spawn_sparks(player_x+3, player_y+PH, 13, 5, 0.55)
  elseif grounded and abs(vx) > 1 and frame_now%7 == 0 then
    spawn_sparks(player_x+3-(face_left and -2 or 2), player_y+PH, 13, 1, 0.25)
  end

  -- Collect authored map objects by mutating the live tile map.
  local got, cx, cy = touches(EMBER)
  if got then
    mset(cx, cy, 0)
    embers = embers + 1
    checkpoint_x, checkpoint_y = max(9, cx*8-2), max(10, cy*8-PH)
    dash_ready, flash, shake = true, 2, 4
    sfx(10)
    spawn_sparks(cx*8+4, cy*8+4, 4, 22, 2.1)
    printh("ember " .. embers .. "/" .. #ember_cells)
  end

  if embers >= #ember_cells and player_y < 60 then open_gate() end
  local at_exit = touches(EXIT)
  if at_exit and gate_open then win_game() end

  local spike = touches(SPIKE)
  local lava = touches(LAVA) or touches(LAVA_BUBBLE)
  if spike or lava or player_y > 506 then begin_hurt(spike and "spike" or "lava") end
  for i = 1, 2 do
    local wx, wy = wisp_position(i)
    if abs((player_x+3)-wx) < 7 and abs((player_y+7)-wy) < 11 then
      begin_hurt("wisp")
    end
  end

  local target = mid(0, player_y - FOLLOW_Y, MAX_CAM)
  game_camera = game_camera + (target-game_camera) * 0.12
end

function _init()
  srand(424242)
  for i = 1, 58 do
    stars[i] = {x=flr(rnd(SW)), y=flr(rnd(WORLD_H)), phase=flr(rnd(80)), c=10+flr(rnd(4))}
  end
  game_camera = MAX_CAM
  printh("lantern leap init; player anims=" .. anim_len("player.run"))
end

function _update()
  frame_now = frame_count()
  if flash > 0 then flash = flash - 1 end
  if shake > 0 then shake = shake - 1 end
  if transition > 0 then transition = transition - 1 end
  if land_pulse > 0 then land_pulse = land_pulse - 1 end
  update_particles()

  if game_scene == "title" then
    if btnp(6) then show_help = not show_help end
    if btnp(4) or btnp(5) then start_game() end
  elseif game_scene == "play" then
    update_play()
  elseif game_scene == "win" then
    if btnp(4) or btnp(5) then
      music(-1)
      echo(0)
      game_scene, game_camera = "title", MAX_CAM
    end
  end
end

local function reset_draw_state()
  camera()
  clip()
  pal()
  -- Draw remaps put the expanded indices into the framebuffer, so renderers
  -- and authoring tools see real Apollo64 data rather than a scanout-only tint.
  for ink = 0, 15 do pal(ink, INK_MAP[ink+1]) end
  fillp()
  mosaic()
  rshift()
end

local function draw_stars(cam)
  for i = 1, #stars do
    local s = stars[i]
    local sy = s.y - cam + 12
    if sy >= HUD_H+1 and sy < SH-1 and (frame_now+s.phase)%70 < 53 then
      pset(s.x, sy, s.c)
      -- pget is screen-space: copy the real rendered palette index into a tiny glint.
      local sampled = pget(s.x, sy)
      if i%7 == 0 then pset(s.x+1, sy, sampled) end
      if (frame_now+s.phase)%70 < 4 and i%5 == 0 then
        pset(s.x-1, sy, s.c)
        pset(s.x, sy-1, s.c+1)
        pset(s.x, sy+1, s.c+1)
      end
    end
  end
end

local function draw_distant_ruins(cam)
  local drift = flr(cam/11)
  for i = 0, 6 do
    local x = (i*37-drift) % (SW+52) - 25
    local h = 20 + (i*13)%31
    local base = SH-12 - (i%2)*9
    rectfill(x, base-h, x+17, base, 50)
    rect(x+2, base-h+3, x+14, base, 52)
    circfill(x+8, base-h+8, 4, 49)
    rectfill(x+5, base-h+8, x+11, base, 49)
    if (frame_now/30+i)%4 < 2 then pset(x+4, base-h+6, 31) end
  end
  for i = 0, 4 do
    local x = (i*53+21-flr(cam/7)) % (SW+58) - 29
    line(x, SH-26, x+18, SH-60, 54)
    line(x+18, SH-60, x+36, SH-26, 54)
  end
end

local function draw_cloud_banks(cam)
  if cam > 220 then return end
  fillp(0x8888, 49)
  for i = 0, 5 do
    local x = (i*47-flr(t()*3)-flr(cam/9)) % (SW+52) - 26
    local y = 35 + i*39 + flr(cam/18)
    circfill(x, y, 8+(i%2)*3, 52)
    circfill(x+10, y-3, 6, 52)
    rectfill(x, y, x+23, y+5, 52)
  end
  fillp()
end

local function draw_backdrop()
  cls(49)
  rectfill(0, HUD_H, SW-1, 116, 51)
  fillp(0x5a5a, 51)
  rectfill(0, 94, SW-1, 236, 8)
  fillp(0x8888, 49)
  rectfill(0, 218, SW-1, SH-1, 1)
  fillp()
  draw_distant_ruins(game_camera)
  draw_cloud_banks(game_camera)
  draw_stars(game_camera)
  fillp(0xeeee)
  circfill(151, 49 + flr(game_camera/20), 24, 30)
  fillp()
  circfill(151, 49 + flr(game_camera/20), 20, 4)
  circfill(143, 42 + flr(game_camera/20), 15, 15)
  circ(151, 49 + flr(game_camera/20), 20, 12)
  circfill(165, 49 + flr(game_camera/20), 2, 29)
  pset(158, 59 + flr(game_camera/20), 29)
  pset(169, 41 + flr(game_camera/20), 31)
  for i = 0, 7 do
    local x = (i*31 - flr(game_camera/7)) % (SW+30) - 15
    line(x, 138+i*16, x+22, 134+i*16, 13)
    if i%2 == 0 then line(x+7, 136+i*16, x+17, 132+i*16, 14) end
  end

  -- The 24px gutters frame the authored 18-tile tower instead of widening
  -- its collision map. Broken buttresses sell the extra space as scenery.
  for side = 0, 1 do
    local edge = side == 0 and TOWER_X-1 or TOWER_X+TOWER_W
    line(edge, HUD_H, edge, SH-1, 52)
    line(edge+(side == 0 and -2 or 2), HUD_H+18, edge+(side == 0 and -2 or 2), SH-1, 50)
    for y = 35, SH-1, 47 do
      local tip = edge + (side == 0 and -10 or 10)
      line(edge, y, tip, y+13, 52)
      pset(tip, y+13, 55)
    end
  end
end

local function draw_particles()
  for i = 1, #particles do
    local p = particles[i]
    local sy = p.y - game_camera + 12
    if sy >= HUD_H and sy < SH then
      local sx = TOWER_X + p.x
      if p.life > 8 then circfill(sx, sy, 1, p.color)
      else pset(sx, sy, p.color) end
    end
  end
end

local function draw_world_details()
  local cy0 = max(0, flr((game_camera-20)/8))
  local cy1 = min(63, cy0+43)
  for cy = cy0, cy1 do
    for cx = 0, 17 do
      local tile = mget(cx, cy)
      local x, y = cx*8, cy*8
      local h = (cx*19 + cy*23 + cx*cy*5) % 31
      if stone_tile(tile) then
        if h%7 == 0 then pset(x+2+h%4, y+2+(h/3)%4, 13) end
        if h%11 == 0 then line(x+1, y+6, x+3, y+4, 15) end
      elseif moss_tile(tile) and mget(cx, cy-1) == 0 and h%3 == 0 then
        aspr("grass.sway", x+4, y+2, -h*3)
      elseif tile == CRUMBLE then
        if (frame_now+h*7)%43 < 2 then pset(x+2+h%5, y+7, 13) end
      elseif tile == SPIKE and (frame_now+h)%50 < 4 then
        pset(x+3, y+2, 12)
      elseif tile == VINE then
        local sway = flr(sin(t()*0.6+cy/7)*2)
        if cy%2 == 0 then line(x+4, y+3, x+1+sway, y+1, 5) end
        if cy%3 == 0 then line(x+4, y+5, x+7+sway, y+3, 6) end
      elseif lava_tile(tile) then
        line(x, y+1, x+7, y+1, 4)
        if (frame_now+h*5)%37 < 3 then circ(x+2+h%4, y-1, 1, 3) end
      elseif tile == GATE then
        if (frame_now/12+cy)%4 < 2 then pset(x+4, y+3, 11) end
      elseif tile == SPRING then
        local bounce = flr((sin(t()*2)+1)*0.5)
        line(x+1, y+1-bounce, x+6, y+1-bounce, 5)
      end
    end
  end

  for i = 1, #shrine_cells do
    local cx, cy = shrine_cells[i][1], shrine_cells[i][2]
    local x, y = cx*8+4, cy*8+1
    fillp(0xeeee)
    circfill(x, y-2, 5+flr((sin(t()*0.7+i/5)+1)*0.5), 30)
    fillp()
    aspr("flame.flicker", x, y+2, -i*9)
  end

  for i = 1, #moths do
    local m = moths[i]
    local mx = m[1] + sin(t()*0.16+m[3]/60)*7
    local my = m[2] + cos(t()*0.23+m[3]/45)*4
    aspr("moth.flap", mx, my, -m[3], i%2 == 0, false)
  end

  for i = 0, 11 do
    local wy = (i*47-flr(frame_now/(3+i%3))) % 512
    local wx = (i*31+flr(sin(t()*0.1+i/9)*9)) % 140 + 2
    if wy > game_camera-16 and wy < game_camera+(SH-HUD_H) then
      pset(wx, wy, i%4 == 0 and 4 or 10)
    end
  end
end

local function draw_world()
  local shake_x = shake > 0 and flr(rnd(3))-1 or 0
  local shake_y = shake > 0 and flr(rnd(3))-1 or 0
  clip(0, HUD_H, SW, SH-HUD_H)
  camera(-TOWER_X-shake_x, game_camera-HUD_H-shake_y)
  map()
  draw_world_details()

  for i = 1, #ember_cells do
    local cx, cy = ember_cells[i][1], ember_cells[i][2]
    if mget(cx, cy) == EMBER then
      local ex, ey = cx*8+4, cy*8+4
      fillp(0xeeee)
      circfill(ex, ey, 7+flr((sin(t()*1.2+i/3)+1)*0.5), 30)
      fillp()
      circ(ex+flr(sin(t()+i/4)*6), ey+flr(cos(t()+i/4)*5), 1, 4)
      aspr("ember.spin", ex, ey)
    end
  end

  for i = 1, 2 do
    local wx, wy = wisp_position(i)
    fillp(0xeeee)
    circfill(wx, wy, 7, 5)
    fillp()
    for trail = 3, 1, -1 do
      local tx, ty = wisp_position(i, trail/45)
      circfill(tx, ty, 1, 10-trail)
    end
    aspr("wisp.float", wx, wy, i*13)
  end

  -- A scaled portal core exercises sspr in the actual playfield.
  if gate_open then
    local pulse = 10 + flr((sin(t()*0.8)+1)*2)
    for ring = 1, 3 do circ(120, 40, pulse+ring*4, 4+ring) end
    for i = 0, 5 do
      local a = t()*0.25+i/6
      pset(120+cos(a)*(pulse+7), 40+sin(a)*(pulse+7), 11)
    end
    aspr("portal.bloom", 124, 40)
    sspr(48, 32, 8, 8, 116-pulse/2, 36-pulse/2, pulse, pulse)
  end

  if land_pulse > 0 then
    local r = 9-land_pulse
    fillp(0x5a5a)
    circ(player_x+3, player_y+PH, r+2, 13)
    fillp()
  end

  fillp(0xeeee)
  circfill(player_x+3, player_y+6, 5+flr((sin(t()*1.4)+1)*0.5), 30)
  fillp()
  if player_mode == "dash" then
    local ghost_colors = {1, 2, 4}
    for trail = 3, 1, -1 do
      for ink = 1, 15 do pal(ink, ghost_colors[trail]) end
      aspr("player.dash", player_x+4-vx*trail, player_y+15-vy*trail, dash_t0, face_left, false)
    end
    for ink = 0, 15 do pal(ink, INK_MAP[ink+1]) end
    -- Push the player's sky-blue highlight to luminous cyan during a dash.
    pal(10, 7)
    aspr("player.dash", player_x+4, player_y+15, dash_t0, face_left, false)
    pal(10, INK_MAP[11])
  elseif player_mode == "hurt" then
    aspr("player.hurt", player_x+4, player_y+15, hurt_t0, face_left, false)
  elseif player_mode == "stomp" then
    aspr("player.stomp", player_x+4, player_y+15, 0, face_left, false)
  elseif on_vine then
    aspr("player.climb", player_x+4, player_y+15, 0, face_left, false)
  elseif not grounded then
    if vy < -1.2 then
      aspr("player.rise", player_x+4, player_y+15, 0, face_left, false)
    elseif vy < 1.2 then
      aspr("player.apex", player_x+4, player_y+15, 0, face_left, false)
    else
      aspr("player.fall", player_x+4, player_y+15, 0, face_left, false)
    end
  elseif abs(vx) > 0.18 then
    aspr("player.run", player_x+4, player_y+15, 0, face_left, false)
  else
    local idle_bob = flr((sin(t()*0.45)+1)*0.5)
    aspr("player.idle", player_x+4, player_y+15-idle_bob, 0, face_left, false)
  end
  local flame_y = player_y + (frame_now%10 < 5 and 1 or 2)
  pset(player_x+3, flame_y, 4)
  pset(player_x+4, flame_y+1, 12)
  camera()
  clip()
  draw_particles()
end

local function draw_hud()
  clip(0, 0, SW, HUD_H)
  cls(48)
  clip()
  line(1, 10, SW-2, 10, 52)
  spr(EMBER, 3, 2)
  print("X" .. embers, 12, 3, 4)
  for i = 1, #ember_cells do
    circfill(27+(i-1)*5, 5, 1, i <= embers and 4 or 15)
    if i <= embers then pset(27+(i-1)*5, 4, 12) end
  end
  print("DASH", 66, 3, dash_ready and 5 or 14)
  rect(87, 3, 121, 7, 15)
  if dash_ready then rectfill(89, 5, 119, 5, 5)
  else rectfill(89, 5, 97, 5, 14) end
  print("FALLS " .. deaths, 151, 3, 13)
  rect(1, 1, SW-2, 10, 15)
end

local function draw_pause()
  clip(30, 94, 132, 132)
  cls(40)
  fillp(0x8888, 41)
  rectfill(30, 94, 161, 225, 48)
  fillp()
  clip()
  rect(30, 94, 161, 225, 4)
  rect(32, 96, 159, 223, 15)
  for i = 0, 3 do
    pset(38+i*38, 102, i%2 == 0 and 4 or 11)
    pset(38+i*38, 216, i%2 == 0 and 11 or 4)
  end
  print("LANTERN PAUSED", 68, 108, 4)
  line(42, 120, 149, 120, 52)
  print("A  JUMP / HOLD HIGH", 49, 132, 12)
  print("B  AIR DASH", 49, 146, 12)
  print("DOWN  STOMP", 49, 160, 12)
  print("UP/DOWN  CLIMB VINES", 49, 174, 12)
  print("MENU  RESUME", 69, 202, 5)
end

local function draw_title()
  cls(40)
  fillp(0x5a5a, 8)
  rectfill(0, 0, SW-1, SH-1, 1)
  fillp()
  for i = 0, 14 do
    local x = (i*19 + flr(t()*7)) % (SW+16) - 8
    line(x, 0, x-35, SH-1, i%2 == 0 and 8 or 15)
  end
  local pulse = flr((sin(t()*0.55)+1)*2)
  fillp(0xeeee)
  circfill(CX, 78, 50+pulse, 30)
  fillp()
  circfill(CX, 78, 44, 8)
  circ(CX, 78, 44, 10)
  line(CX-4, 0, CX-4, 34, 52)
  line(CX+4, 0, CX+4, 34, 52)
  for y = 4, 32, 8 do
    line(CX-4, y, CX+4, y+4, 55)
    line(CX+4, y+4, CX-4, y+8, 55)
  end
  palt(12, true)
  local logo = 50+pulse
  sspr(32, 16, 8, 8, CX-logo/2, 74-logo/2, logo, logo)
  palt()
  for i = 0, 7 do
    local a = t()*0.12+i/8
    aspr("spark.twinkle", CX+cos(a)*52, 78+sin(a)*43, -i*5)
  end
  print("LANTERN", 82, 112, 4)
  print("L E A P", 82, 123, 11)
  rect(43, 139, 148, 142, 10)
  print(frame_now%80 < 58 and "A/B  LIGHT THE TOWER" or "    PRESS TO BEGIN", 58, 161, 12)
  print("MENU  TOGGLE GUIDE", 62, 174, 13)
  if show_help then
    fillp(0x8888, 51)
    rectfill(24, 194, 167, 276, 0)
    fillp()
    rect(24, 194, 167, 276, 15)
    print("3 EMBERS OPEN THE GATE", 51, 207, 5)
    print("D-PAD MOVE + VINE CLIMB", 48, 222, 11)
    print("A JUMP  B AIR DASH", 58, 237, 3)
    print("DOWN STOMP CRACKED STONE", 44, 252, 4)
    aspr("flame.flicker", 32, 268, 0)
    aspr("flame.flicker", 160, 268, -7, true, false)
  end
  print("AGENT-AUTHORED CART 01", 52, 305, 14)
end

local function draw_win()
  draw_backdrop()
  draw_world()
  fillp(0x5a5a, 1)
  rectfill(24, 88, 167, 239, 0)
  fillp()
  rect(24, 88, 167, 239, 4)
  rect(26, 90, 165, 237, 12)
  for i = 0, 15 do
    local a = i/16
    line(CX, 146, CX+cos(a)*(43+i%4), 146+sin(a)*(43+i%4), i%2 == 0 and 30 or 11)
  end
  print("TOWER LIT!", 76, 104, 4)
  circfill(CX, 145, 27 + flr(sin(t())*2), 8)
  sspr(48, 32, 8, 8, CX-28, 117, 56, 56)
  for i = 0, 11 do
    local sx = 36+(i*19+frame_now)%120
    local sy = 96+(i*23+frame_now*(1+i%2))%126
    aspr("spark.twinkle", sx, sy, -i*4)
  end
  print("FRAMES " .. frame_now, 67, 194, 11)
  print("FALLS  " .. deaths, 67, 207, 13)
  print("A/B  AGAIN", 76, 224, 5)
end

function _draw()
  reset_draw_state()
  if game_scene == "title" then
    draw_title()
  elseif game_scene == "win" then
    draw_win()
  else
    draw_backdrop()
    draw_world()
    draw_hud()
    if paused then draw_pause() end

    -- Wobbling lava below and high-altitude wind above are framebuffer effects.
    if game_camera > 170 then
      local lava_line = max(HUD_H, flr(500-game_camera+HUD_H))
      for sy = lava_line, SH-1 do rshift(sy, 2*sin(t()*1.7+sy/19)) end
    elseif game_camera < 60 then
      for sy = HUD_H, 108 do rshift(sy, 2*sin(t()*0.7+sy/31)) end
    end
  end

  if transition > 0 then
    local factor = transition > 9 and 8 or transition > 6 and 4 or transition > 3 and 2 or 1
    mosaic(factor)
  end
  if flash > 0 then
    for c = 0, 63 do pal(c, flash%2 == 0 and 63 or 31, 1) end
  end
end

-- Deliberate headless hooks: these make eval/RPC a first-class playtest surface.
function dev_status()
  return {scene=game_scene, x=player_x, y=player_y, embers=embers,
    gate=gate_open, deaths=deaths, mode=player_mode, paused=paused,
    camera=game_camera, dash=dash_ready, vx=vx, vy=vy,
    grounded=grounded, vine=on_vine, land=land_pulse}
end

function dev_warp(x, y)
  player_x, player_y, vx, vy = x, y, 0, 0
  grounded, on_vine = false, false
  player_mode, paused = "normal", false
  game_camera = mid(0, y-FOLLOW_Y, MAX_CAM)
  transition, flash, shake = 0, 0, 0
end

function dev_unlock()
  embers = #ember_cells
  open_gate()
end

