    rect(ox+157,404,ox+181,479,43)
    env_billboard(ox+12,414,22,50,accent,1)
    env_billboard(ox+158,414,22,50,accent,1)
    rectfill(ox+44,411,ox+148,480,49)
    rectfill(ox+49,416,ox+143,475,48)
    for py=424,466,14 do
      rectfill(ox+51,py,ox+141,py+3,50)
      line(ox+53,py,ox+139,py,54)
      for px=ox+57,ox+135,13 do
        if (px+py)%4<2 then
          rectfill(px,py+6,px+2,py+9,(px+py)%3==0 and 31 or 36)
        else pset(px+1,py+7,52) end
      end
    end
    env_fan(ox+96,385,19,accent)
    for px=ox+46,ox+146,20 do
      line(px,359,px,480,52)
      pset(px,356,(px+frame_now)%8<4 and 36 or 31)
    end
  end
end

function env_foreground_service_trench()
  local x0=flr(camera_x)-2
  local x1=flr(camera_x)+SW+2
  -- A continuous 22px near plane hides the repeated lower tile faces while
  -- leaving the collision lip at y=488 visible. It is solid architecture, not
  -- a moving water/wave overlay.
  rectfill(x0,490,x1,511,48)
  line(x0,490,x1,490,50)
  line(x0,492,x1,492,49)
  for panel=flr(x0/32)*32,x1,32 do
    line(panel,496,panel,511,49)
    line(panel+1,498,panel+1,509,50)
    pset(panel+4,499,52)
    rectfill(panel+19,506,panel+28,510,49)
    line(panel+20,507,panel+27,507,50)
  end
  -- Fixed-world drain mouths and pipe elbows supply foreground occlusion.
  for x=48,944,128 do
    if x>camera_x-20 and x<camera_x+SW+20 then
      rectfill(x-11,497,x+11,511,49)
      rectfill(x-8,494,x+8,511,49)
      rectfill(x-5,497,x+5,511,48)
      line(x-8,494,x+8,494,52)
      for gx=x-4,x+4,4 do line(gx,499,gx,511,50) end
      pset(x,502,10)
    end
  end
  for x=18,930,96 do
    if x>camera_x-28 and x<camera_x+SW+28 then
      rectfill(x,503,x+30,508,49)
      rectfill(x+25,499,x+30,508,49)
      line(x+2,503,x+26,503,52)
      line(x+29,500,x+29,507,50)
      pset(x+5,505,54) pset(x+27,501,54)
    end
  end
  -- Broken, static puddle reflections: short clusters with empty gaps, never
  -- a full-width or animated wave. Accent follows the real world zone.
  for x=8,950,47 do
    if x>camera_x-18 and x<camera_x+SW+18 then
      local z=mid(0,flr(x/128),6)
      local accent=z==1 and 5 or z==3 and 45 or z==5 and 10 or z==6 and 38 or 2
      local w=7+(flr(x/47)%4)*3
      line(x,498,x+w,498,accent)
      line(x+3,501,x+w-2,501,z==1 and 3 or z==5 and 7 or 1)
      pset(x+w+3,500,accent)
    end
  end
  -- Sparse fence posts live in the near plane and break the bottom silhouette.
  for x=88,920,176 do
    if x>camera_x-8 and x<camera_x+SW+8 then
      rectfill(x,486,x+2,500,49)
      line(x+1,486,x+1,498,52)
      line(x-5,489,x+7,501,50)
      pset(x+1,485,54)
    end
  end
  -- Three authored near-plane vocabularies repeat only at district scale.
  for z=0,6 do
    local ox=z*128
    if ox+128>camera_x-24 and ox<camera_x+SW+24 then
      if z<=1 then
        -- Waterworks: sewer header, square elbow, grate and cyan fragments.
        rectfill(ox+8,501,ox+54,506,49)
        rectfill(ox+49,496,ox+54,506,49)
        line(ox+10,501,ox+51,501,52)
        rectfill(ox+73,494,ox+91,511,49)
        rectfill(ox+77,498,ox+87,511,48)
        for gx=ox+78,ox+86,4 do line(gx,499,gx,511,50) end
        line(ox+16,497,ox+34,497,5)
        line(ox+22,500,ox+29,500,3)
      elseif z<=4 then
        -- Commercial roofs: inset service door and neon puddle fragments.
        rectfill(ox+18,493,ox+39,511,49)
        rectfill(ox+22,497,ox+35,511,40)
        rect(ox+21,496,ox+36,511,52)
        pset(ox+33,503,z==3 and 45 or 31)
        local neon=z==3 and 45 or z==2 and 36 or 10
        line(ox+51,498,ox+78,498,neon)
        line(ox+58,501,ox+70,501,z==3 and 42 or 1)
        pset(ox+82,500,neon)
      else
        -- Mutagen/arena: dented plates, torn seams and foreground debris.
        rectfill(ox+10,495,ox+51,510,49)
        line(ox+12,496,ox+49,496,52)
        line(ox+24,496,ox+36,509,50)
        line(ox+37,497,ox+30,508,54)
        rectfill(ox+67,504,ox+73,509,50)
        rectfill(ox+76,501,ox+86,509,49)
        rectfill(ox+90,506,ox+96,510,50)
        local spill=z==5 and 10 or 38
        line(ox+13,493,ox+29,493,spill)
        pset(ox+33,494,spill) pset(ox+82,500,spill)
      end
    end
  end
end

function env_zone_atmosphere(zone,accent)
  local ox=zone*128
  if zone==0 then
    circfill(ox+151,420,7,50)
    circfill(ox+158,410,5,49)
    circ(ox+151,420,8,54)
    line(ox+151,432,ox+151,471,52)
  elseif zone==1 then
    rectfill(ox+82,417,ox+96,431,49)
    line(ox+84,418,ox+94,418,58)
    for py=431,488 do
      local wob=(flr(py/6)%3)-1
      line(ox+87+wob,py,ox+91+(py%2),py,5)
      if py%7==0 then pset(ox+85-wob,py,6) end
    end
    line(ox+73,486,ox+105,486,5)
    line(ox+79,483,ox+100,483,3)
    line(ox+84,480,ox+94,480,2)
    pset(ox+87,477,6) pset(ox+97,487,5)
  elseif zone==2 then
    rect(ox+27,350,ox+119,433,40)
    rect(ox+31,354,ox+115,429,41)
    for py=364,420,14 do
      pset(ox+33,py,accent) pset(ox+113,py,45)
    end
    line(ox+31,430,ox+115,430,45)
  elseif zone==3 then
    line(ox+31,389,ox+162,389,46)
    line(ox+42,392,ox+151,392,43)
    for px=ox+39,ox+155,19 do
      pset(px,395,accent)
      line(px-2,456,px+3,456,31)
    end
    line(ox+48,459,ox+145,459,43)
    line(ox+61,462,ox+132,462,42)
    pset(ox+72,465,31) pset(ox+119,465,45)
  elseif zone==4 then
    for py=337,427,12 do
      pset(ox+94,py,(py+frame_now)%24<12 and 36 or 31)
      line(ox+91,py+4,ox+97,py+4,52)
    end
    circ(ox+94,331,7,36)
    circfill(ox+94,331,2,31)
  elseif zone==5 then
    rectfill(ox+69,405,ox+85,444,49)
    rect(ox+70,406,ox+84,443,accent)
    rectfill(ox+73,416,ox+81,443,10)
    for py=419,440,6 do line(ox+72,py,ox+82,py,7) end
    rectfill(ox+76,444,ox+79,488,10)
    line(ox+60,486,ox+94,486,10)
    line(ox+67,483,ox+89,483,7)
    pset(ox+75,479,6) pset(ox+86,487,6)
    circfill(ox+78,399,4,50)
    circfill(ox+83,391,3,49)
    circ(ox+78,399,5,10)
    pset(ox+86,386,7)
    line(ox+69,407,ox+88,407,10)
    line(ox+73,409,ox+85,409,7)
  else
    circfill(ox+25,364,5,31)
    circfill(ox+167,364,5,36)
    line(ox+21,361,ox+29,361,61)
    line(ox+163,361,ox+171,361,61)
    line(ox+25,370,ox+32,391,30)
    line(ox+167,370,ox+160,391,38)
    line(ox+20,376,ox+34,376,52)
    line(ox+158,376,ox+172,376,52)
  end
end

-- Half-open world extents for focal props. Keeping these next to the culling
-- helper makes the inclusive primitive endpoints explicit and reviewable.
ENV_FOCAL_BOUNDS={
  lick_lab={73,130},
  loading_pipes={153,185},
  waterworks_machine={267,328},
  molt_sign={317,392},
  gene_pipes={416,448},
  gene_bar={465,546},
  croak_machine={531,592},
  water_tower={601,646},
  croak_sign={654,729},
  hr_hive={786,851}
}

ENV_LANDMARK_BOUNDS={
  {-10,196}, {121,326}, {247,458}, {377,574},
  {500,717}, {630,845}, {766,963}
}

function env_world_visible(left,right)
  return right>camera_x and left<camera_x+SW
end

function env_draw_focal(name)
  local bounds=ENV_FOCAL_BOUNDS[name]
  if not bounds or not env_world_visible(bounds[1],bounds[2]) then return false end
  if name=="lick_lab" then draw_rooftop_room(74,454,54,"LICK LAB",10)
  elseif name=="loading_pipes" then draw_pipe_cluster(157,472)
  elseif name=="waterworks_machine" then draw_fenced_machine(294,472,10)
  elseif name=="molt_sign" then draw_neon_billboard(354,450,"MOLT!",4)
  elseif name=="gene_pipes" then draw_pipe_cluster(420,472)
  elseif name=="gene_bar" then draw_rooftop_room(474,452,62,"GENE BAR",45)
  elseif name=="croak_machine" then draw_fenced_machine(558,472,4)
  elseif name=="water_tower" then draw_water_tower(623,455)
  elseif name=="croak_sign" then draw_neon_billboard(691,438,"CROAK",10)
  elseif name=="hr_hive" then draw_rooftop_room(787,448,62,"HR HIVE",36)
  end
  return true
end

function dev_draw_environment_focal(name)
  return env_draw_focal(name)
end

local function draw_zone_architecture()
  env_begin_dim_palette()
  -- World landmarks are persistent authored objects. Drawing only the
  -- camera-selected zone made whole buildings pop in and out at x boundaries.
  for landmark_zone=0,6 do
    local landmark_bounds=ENV_LANDMARK_BOUNDS[landmark_zone+1]
    if env_world_visible(landmark_bounds[1],landmark_bounds[2]) then
      env_world_landmark(landmark_zone,ZONE_ACCENT[landmark_zone+1])
      env_zone_atmosphere(landmark_zone,ZONE_ACCENT[landmark_zone+1])
    end
  end
  if env_world_visible(188,260) then env_waterworks_chunk() end
  if env_world_visible(712,792) then env_mutagen_chunk() end
  if env_world_visible(800,929) then env_arena_canopy() end
  -- Floating routes alternate between suspended catwalks, façades, and short trusses.
  for i=1,#level.platforms do
    local p=level.platforms[i]
    local x,y,w=p[1]*8,p[2]*8,p[3]*8
    if p[4]==1 and p[5]~=ACID and x+w>camera_x-24 and x<camera_x+SW+24 then
      local zone=mid(0,flr((x+w/2)/128),6)
      local accent=ZONE_ACCENT[zone+1]
      local depth=mid(16,22+(i*11)%27,WORLD_H-y-1)
      fillp(0xaaaa,49)
      rectfill(x+3,y+8,x+w-4,y+12,48)
      fillp()
      if p[5]==MUD then
        rectfill(x+3,y+8,x+w-4,y+depth,40)
        rectfill(x+6,y+12,x+w-7,y+depth,49)
        line(x+4,y+7,x+1,y+depth,54)
        line(x+w-5,y+7,x+w-2,y+depth,52)
        for root=x+10,x+w-8,16 do
          line(root,y+6,root-3+(root%7),y+14+(root%13),12)
          pset(root+1,y+11,14)
        end
      elseif p[5]==GIRDER then
        rectfill(x+3,y+9,x+w-4,y+depth,49)
        rectfill(x+6,y+13,x+w-7,y+depth-3,48)
        rectfill(x+2,y+6,x+w-3,y+9,50)
        local spacing=zone==2 and 32 or zone>=5 and 36 or 27+(i%2)*5
        for bx=x+4,x+w-9,spacing do
          if zone==1 then
            rectfill(bx,y+9,bx+5,y+depth,49)
            line(bx+1,y+10,bx+1,y+depth,54)
            pset(bx+3,y+14,10)
          elseif zone==3 then
            line(bx,y+9,bx,y+depth,52)
            line(bx+6,y+9,bx+6,y+depth-4,50)
            circ(bx+3,y+depth-2,3,45)
          elseif zone==4 then
            line(bx,y+9,bx+spacing-4,y+depth,52)
            line(bx+spacing-4,y+9,bx,y+depth,50)
          elseif zone>=5 then
            rectfill(bx,y+9,bx+7,y+15,49)
            line(bx,y+16,bx+7,y+depth,52)
            line(bx+7,y+16,bx,y+depth,50)
          else
            line(bx,y+9,bx,y+depth,52)
            line(bx+spacing-5,y+9,bx+spacing-5,y+depth,52)
            line(bx,y+10,bx+spacing-5,y+depth-1,54)
            line(bx+spacing-5,y+10,bx,y+depth-1,51)
          end
        end
      else
        rectfill(x+2,y+6,x+w-3,y+depth,50)
        rect(x+4,y+9,x+w-5,y+depth,52)
        line(x+5,y+12,x+w-6,y+12,54)
        for wx=x+8,x+w-10,12 do
          line(wx,y+13,wx,y+depth,51)
          for wy=y+18,y+depth-5,12 do
            if (wx+wy+i)%3==0 then rectfill(wx+2,wy,wx+4,wy+3,accent) end
          end
        end
      end
      if y<424 and (i+zone)%5==0 then
        line(x+5,y+7,x+5,y-18,50)
        line(x+w-6,y+7,x+w-6,y-13,50)
        line(x+5,y-18,x+15,y-24,52)
        pset(x+5,y-19,58) pset(x+w-6,y-14,54)
      end
      if y<424 and i%4==0 then
        line(x+3,y-7,x+w-4,y-7,52)
        for rx=x+5,x+w-6,24 do
          line(rx,y-7,rx,y-1,50)
          pset(rx,y-8,58)
        end
      elseif y<424 and i%4==1 then
        line(x+4,y+10,x-8,y+depth,50)
        line(x+w-5,y+10,x+w+7,y+depth,52)
        rectfill(x-10,y+depth-3,x-5,y+depth,49)
        rectfill(x+w+4,y+depth-3,x+w+9,y+depth,49)
      end
    end
  end
  -- Lamps are tied to actual roof surfaces. Each cone has empty darkness around
  -- it, so lighting groups architecture instead of forming a repeated screen-wide band.
  for i=1,#ENV_LAMPS do
    local lamp=ENV_LAMPS[i]
    if lamp[1]>camera_x-24 and lamp[1]<camera_x+SW+24 then
      draw_light_pool(lamp[1],lamp[2],lamp[3])
    end
  end

  -- Persistent focal props. The camera clip makes this cheap while allowing
  -- adjacent-zone silhouettes to enter and leave the frame naturally.
  env_draw_focal("lick_lab")
  env_draw_focal("loading_pipes")
  env_draw_focal("waterworks_machine")
  env_draw_focal("molt_sign")
  env_draw_focal("gene_pipes")
  env_draw_focal("gene_bar")
  env_draw_focal("croak_machine")
  env_draw_focal("water_tower")
  env_draw_focal("croak_sign")
  env_draw_focal("hr_hive")

  -- A single filled arena composition centered on Buzzkill's encounter space.
  -- Dark under-tier cavities and a central aisle replace the old wireframe box.
  local arena_cx=864
  if env_world_visible(arena_cx-64,arena_cx+64) then
    rectfill(arena_cx-56,397,arena_cx+56,472,48)
    rect(arena_cx-54,401,arena_cx+54,468,50)
    line(arena_cx-50,405,arena_cx+50,405,52)
    rectfill(arena_cx-58,397,arena_cx-50,472,49)
    rectfill(arena_cx+50,397,arena_cx+58,472,49)
    for y=414,460,12 do
      pset(arena_cx-53,y,36) pset(arena_cx+53,y,31)
    end
    circ(arena_cx,411,12,35) circ(arena_cx,411,8,52)
    line(arena_cx-8,411,arena_cx+8,411,50)
    line(arena_cx,403,arena_cx,419,50)
    rectfill(arena_cx-46,412,arena_cx-17,424,49)
    line(arena_cx-45,412,arena_cx-18,412,54)
    rectfill(arena_cx-42,416,arena_cx-21,421,48)
    rectfill(arena_cx+17,412,arena_cx+46,424,49)
    line(arena_cx+18,412,arena_cx+45,412,54)
    rectfill(arena_cx+21,416,arena_cx+42,421,48)
    env_pal(58,54) env_pal(61,58) env_pal(63,61)
    spr(LAB_FACE,arena_cx-42,413) spr(CAVITY,arena_cx-34,413)
    spr(LAB_FACE,arena_cx-26,413)
    spr(LAB_FACE,arena_cx+18,413) spr(CAVITY,arena_cx+26,413)
    spr(LAB_FACE,arena_cx+34,413)
    env_begin_dim_palette()
    for x=arena_cx-39,arena_cx-25,7 do rectfill(x,417,x+2,420,x%2==0 and 30 or 31) end
    for x=arena_cx+23,arena_cx+37,7 do rectfill(x,417,x+2,420,x%2==0 and 36 or 38) end
    line(arena_cx-47,424,arena_cx-55,439,50)
    line(arena_cx+47,424,arena_cx+55,439,50)
    for y=426,463,13 do
      rectfill(arena_cx-46,y,arena_cx-9,y+10,49)
      rectfill(arena_cx+9,y,arena_cx+46,y+10,49)
      line(arena_cx-46,y,arena_cx-9,y,54)
      line(arena_cx+9,y,arena_cx+46,y,54)
      line(arena_cx-43,y+3,arena_cx-12,y+3,50)
      line(arena_cx+12,y+3,arena_cx+43,y+3,50)
      for x=arena_cx-39,arena_cx+39,13 do
        pset(x,y+5,(x+y)%3==0 and 31 or 36)
        rectfill(x-3,y+7,x+3,y+10,48)
        line(x-2,y+7,x+2,y+7,50)
      end
      local falloff=flr((y-426)/13)*3
      rectfill(arena_cx-45+falloff,y+1,arena_cx-27-falloff,y+4,26)
      line(arena_cx-43+falloff,y+1,arena_cx-29-falloff,y+1,30)
      rectfill(arena_cx+27+falloff,y+1,arena_cx+45-falloff,y+4,34)
      line(arena_cx+29+falloff,y+1,arena_cx+43-falloff,y+1,38)
    end
    rectfill(arena_cx-8,421,arena_cx+8,468,48)
    line(arena_cx-8,421,arena_cx-8,468,50)
    line(arena_cx+8,421,arena_cx+8,468,50)
    for y=429,460,9 do line(arena_cx-5,y,arena_cx+5,y,52) end
    line(arena_cx-44,469,arena_cx+44,469,52)
  end
  restore_legacy_palette()
end

local function draw_prop(p)
  local kind,x,y,w=p[1],p[2],p[3],p[4]
  if kind=="pipe" then
    begin_authored_sprite_scope(false)
    for px=x,x+w-8,8 do
      spr((px-x)%32==24 and PIPE_JUNCTION or PIPE_H,px,y-8)
    end
    for py=y-32,y-16,8 do spr(PIPE_V,x-4,py) end
    spr(PIPE_ELBOW,x-4,y-16)
    restore_legacy_palette()
    for px=x+12,x+w-4,24 do
      pset(px,y-5,31) pset(px+1,y-4,13)
    end
  elseif kind=="fence" then
    begin_authored_sprite_scope(false)
    pal(59,52) pal(52,50) pal(31,13)
    for py=y-32,y-8,8 do
      for px=x,x+w-8,8 do
        local damaged=(px+py+flr(x/8))%40==0
        spr(damaged and FENCE_DAMAGED or FENCE_WIRE,px,py)
      end
    end
    for px=x,x+w,16 do spr(FENCE_POST,px,y-32) end
    restore_legacy_palette()
    line(x,y-33,x+w,y-33,59)
  elseif kind=="sign" then
    fillp(0xaaaa,p[4]==1 and 36 or 45)
    rectfill(x-17,y-31,x+17,y+2,p[4]==1 and 36 or 45)
    fillp()
    begin_authored_sprite_scope(false)
    sspr((PROP_SIGN%16)*8,flr(PROP_SIGN/16)*8,8,8,x-12,y-28,24,24)
    restore_legacy_palette()
    line(x-9,y-3,x-6,y+7,52) line(x+9,y-3,x+6,y+7,52)
    line(x-16,y+2,x+16,y+2,p[4]==1 and 36 or 45)
  elseif kind=="vent" then
    rectfill(x-17,y-25,x+17,y+2,48)
    begin_authored_sprite_scope(false)
    sspr((PROP_VENT%16)*8,flr(PROP_VENT/16)*8,8,8,x-16,y-24,32,24)
    restore_legacy_palette()
    rect(x-17,y-25,x+17,y+2,59)
    pset(x-14,y-22,31) pset(x+14,y-22,31)
  elseif kind=="lamp" then
    fillp(0xaaaa,31)
    line(x-3,y-13,x-14,y,31) line(x+3,y-13,x+14,y,31)
    line(x-10,y-4,x+10,y-4,31)
    rectfill(x-13,y-2,x+13,y,31)
    fillp()
    begin_authored_sprite_scope(false)
    spr(PROP_LAMP,x-8,y-16,2,2)
    restore_legacy_palette()
    line(x-12,y,x+12,y,31)
    pset(x-15,y,38) pset(x+15,y,38)
  elseif kind=="coil" then
    fillp(0xaaaa,10)
    circfill(x,y-10,17,10)
    fillp()
    begin_authored_sprite_scope(false)
    spr(PROP_COIL,x-8,y-16,2,2)
    restore_legacy_palette()
    circ(x,y-10,15,10)
    for a=0,3 do
      pset(x+cos(a/4+frame_now/90)*18,y-10+sin(a/4+frame_now/90)*12,a%2==0 and 10 or 45)
    end
  elseif kind=="crate" then
    rectfill(x-9,y-17,x+9,y+1,48)
    begin_authored_sprite_scope(false)
    spr(PROP_CRATE,x-8,y-16,2,2)
    restore_legacy_palette()
    line(x-8,y,x+8,y,31)
  elseif kind=="tank" then
    rectfill(x-15,y-30,x+15,y,49)
    circfill(x,y-30,15,49)
    rect(x-14,y-29,x+14,y,55)
    circ(x,y-30,14,59)
    line(x-11,y-23,x+11,y-23,13)
    line(x-12,y-12,x+12,y-12,52)
    line(x-9,y-35,x+9,y-35,56)
    line(x,y-45,x,y-55,52)
    pset(x,y-56,36)
    line(x-10,y,x-14,y+8,52) line(x+10,y,x+14,y+8,52)
    rectfill(x-9,y-21,x+9,y-14,48)
    print("GULP",x,y-20,10,"center")
    pset(x-12,y-25,31) pset(x+12,y-25,31)
  end
end

function draw_surface_lighting()
  for i=1,#ENV_SURFACE_LIGHTS do
    local light=ENV_SURFACE_LIGHTS[i]
    local lx,ly,accent,radius=light[1],light[2],light[3],light[4]
    if lx+radius>camera_x and lx-radius<camera_x+SW then
      local x0=max(0,flr((lx-radius)/8))
      local x1=min(119,flr((lx+radius)/8))
      local y0=max(0,flr((ly-radius)/8))
      local y1=min(63,flr((ly+radius)/8))
      for cy=y0,y1 do
        for cx=x0,x1 do
          local tile=mget(cx,cy)
          local px,py=cx*8,cy*8
          local d=dist(lx,ly,px+4,py+4)
          if solid(tile) and d<radius then
            if not solid(mget(cx,cy-1)) then
              local inset=d<radius*0.5 and 1 or 2
              line(px+inset,py,px+7-inset,py,accent)
              if d<radius*0.42 then line(px+2,py+1,px+5,py+1,31) end
            end
            if px<lx and not solid(mget(cx+1,cy)) then
              line(px+7,py+2,px+7,py+5,accent)
            elseif px>lx and not solid(mget(cx-1,cy)) then
              line(px,py+2,px,py+5,accent)
            end
          end
        end
      end
    end
  end
end

local function draw_terrain_detail()
  local x0=max(0,flr(camera_x/8)-1)
  local x1=min(119,flr((camera_x+SW)/8)+1)
  local y0=max(0,flr(camera_y/8)-1)
  local y1=min(63,flr((camera_y+SH-HUD_H)/8)+1)
  for cy=y0,y1 do
    for cx=x0,x1 do
      local tile=mget(cx,cy)
      local x,y=cx*8,cy*8
      if solid(tile) then
        -- Collision terrain owns a consistent value hierarchy over the atlas:
        -- a bright unbroken contact lip, a quieter material-colored inner edge,
        -- and dark undercut. Background architecture never receives this trio.
        if not solid(mget(cx,cy-1)) then
          local tile_zone=mid(0,flr((x+4)/128),6)
          local inner=54
          if masonry_material(tile) then inner=14
          elseif breakable(tile) then inner=30 end
          local previous_surface=solid(mget(cx-1,cy)) and not solid(mget(cx-1,cy-1))
          if cx==x0 or not previous_surface then
            local run_end=cx
            while run_end<x1 do
              local next_tile=mget(run_end+1,cy)
              local next_inner=54
              if masonry_material(next_tile) then next_inner=14
              elseif breakable(next_tile) then next_inner=30 end
              if not solid(next_tile) or solid(mget(run_end+1,cy-1)) or next_inner~=inner then break end
              run_end=run_end+1
            end
            local right=run_end*8+7
            line(x,y,right,y,59)
            line(x+1,y+1,right-1,y+1,inner)
            line(x+2,y+2,right-2,y+2,49)
            if not solid(mget(cx-1,cy)) then line(x,y+1,x,y+4,55) end
            if not solid(mget(run_end+1,cy)) then line(right,y+1,right,y+4,55) end
          end
          if masonry_material(tile) and (cx*3+cy)%7==0 then
            local stain=tile_zone==5 and 10 or tile_zone==3 and 42 or 26
            pset(x+4,y+1,stain)
          end
        end
        if steel_material(tile) and (cx*7+cy)%11==0 then
          line(x+2,y+3,x+2,y+6,38)
          pset(x+3,y+6,24)
        elseif girder_material(tile) and (cx+cy)%4==0 then
          line(x+1,y+1,x+2,y+2,31) pset(x+6,y+6,13)
        elseif masonry_material(tile) and (cx+cy)%9==0 then
          line(x+5,y+2,x+5,y+4,42)
        elseif breakable(tile) and frame_now%8<6 then
          pset(x+3,y+3,31)
        end
      elseif hazardous(tile) then
        line(x,y,x+7,y,10)
        line(x+1,y+1,x+6,y+1,7)
        local bob=(frame_now+cx*7)%18
        if bob<5 then circ(x+2+(cx%3)*2,y+1,1,bob<2 and 31 or 10) end
      end
    end
  end
end

local function draw_world()
  local sx=shake>0 and flr(rnd(5))-2 or 0
  local sy=shake>0 and flr(rnd(5))-2 or 0
  clip(0,HUD_H,SW,SH-HUD_H)
  camera(camera_x-sx,camera_y-HUD_H-sy)
  draw_zone_architecture()
  begin_authored_sprite_scope(false)
  map()
  restore_legacy_palette()
  env_foreground_service_trench()
  draw_surface_lighting()
  draw_terrain_detail()
  for i=1,#level.props do
    local p=level.props[i]
    if not (boss_started and p[2]>=810) then draw_prop(p) end
  end
  for i=1,#secrets do draw_secret(secrets[i],i) end
  for i=1,#pickups do draw_pickup(pickups[i],i) end
  for i=1,#bombs do draw_bomb(bombs[i],i) end
  for i=1,#level.checkpoints do
    local c=level.checkpoints[i]
    line(c[1],c[2]+16,c[1],c[2]-8,i<=checkpoint_index and 6 or 13)
    rectfill(c[1],c[2]-8,c[1]+19,c[2]+2,i<=checkpoint_index and 11 or 52)
    print("CP"..i,c[1]+3,c[2]-6,63)
  end
  draw_boss_gate()
  draw_exit()
  draw_bullets()
  for i=1,#enemies do draw_enemy(enemies[i],i) end
  draw_particles_world()
  draw_grapple_hint()
  draw_tongue()
  draw_fire_fx()
  draw_laser_fx()
  draw_player()
  draw_tongue_mouth_joint()
  camera()
  clip()
end

local function draw_hud()
  clip(0,0,SW,HUD_H)
  cls(49)
  rectfill(1,1,SW-2,HUD_H-2,48)
  line(2,2,SW-3,2,59)
  line(2,HUD_H-3,SW-3,HUD_H-3,41)
  rectfill(2,3,55,12,49)
  rectfill(59,3,126,12,49)
  rectfill(130,3,189,12,49)
  print("VIT",4,5,59)
  for i=1,player_max_hp do
    local x=20+(i-1)*7
    local alive=i<=player_hp
    circfill(x-2,6,2,alive and 6 or 34)
    circfill(x+2,6,2,alive and 6 or 34)
    rectfill(x-3,7,x+3,10,alive and 7 or 50)
    pset(x-2,5,alive and 11 or 52) pset(x+2,5,alive and 11 or 52)
    pset(x-2,6,alive and 48 or 49) pset(x+2,6,alive and 48 or 49)
    line(x-2,9,x+2,9,alive and 14 or 52)
  end
  line(57,3,57,12,52) line(128,3,128,12,52)
  if mutation=="LASER EYES" then
    circfill(66,7,3,10) circfill(73,7,3,10)
    pset(66,7,63) pset(73,7,63)
    print("LASER",82,5,10)
  elseif mutation=="FIRE BREATH" then
    circfill(69,8,4,5) circ(69,8,4,4)
    pset(71,6,63)
    print("FIRE",82,5,4)
  else
    rect(65,4,73,10,52)
    print("WILD",82,5,58)
  end
  if combo>1 then print("X"..combo,124,5,31,"right") end
  print("$"..score,187,5,31,"right")
  clip()
  if boss_started and not exit_open then
    rectfill(25,18,167,28,48)
    rect(25,18,167,28,59)
    print("BUZZKILL",30,20,63)
    local boss=enemies[#enemies]
    rectfill(76,20,150,25,50)
    rectfill(77,21,77+flr(71*boss.hp/boss.max_hp),24,
      boss.phase_id==1 and 3 or boss.phase_id==2 and 4 or 36)
    pset(78,21,63)
    print("P"..(boss.phase_id or 1),162,20,boss.vulnerable and 31 or 10,"right")
  end
end

