    line(cx-6,y-54,cx+6,y-54,12)
    line(cx-7,y-30,cx+7,y-30,4)
    pset(cx-2,y-42,14) pset(cx+3,y-35,6)
  end
  rectfill(x-35,y-70,x+35,y-64,50)
  rectfill(x-2,y-69,x+3,y-18,49)
  -- Service hatch, relief vent and stained seams fill the formerly blank face.
  rectfill(x-9,y-35,x+9,y-18,40)
  rect(x-10,y-36,x+10,y-17,52)
  for py=y-32,y-22,4 do line(x-7,py,x+7,py,50) end
  rectfill(x-36,y-20,x-29,y-10,48)
  for py=y-18,y-12,3 do line(x-35,py,x-30,py,52) end
  rectfill(x+29,y-22,x+35,y-10,48)
  for py=y-20,y-12,4 do line(x+30,py,x+34,py,52) end
  fillp(0xaaaa,7)
  rectfill(x-34,y-10,x+34,y-5,10)
  fillp()
  rectfill(x-25,y-6,x+25,y-3,7)
  rectfill(x-15,y-3,x+17,y,4)
  line(x-7,y+1,x+11,y+1,10)
  pset(x-31,y-3,7) pset(x+29,y-4,10)
  for px=x-29,x+29,12 do
    rectfill(px,y-75,px+5,y-68,49)
    pset(px+2,y-74,10)
  end
  env_pal(58,52) env_pal(59,54) env_pal(61,58) env_pal(63,59)
  spr(PIPEWORKS_FACE,x-34,y-62)
  spr(PIPEWORKS_FACE,x+26,y-62)
  spr(CAVITY,x-4,y-14)
  env_begin_dim_palette()
end

function env_arena_canopy()
  -- A faceted industrial roof: filled side planes, a deep underside, paired
  -- broken skylights and structural ribs replace the abstract staircase mass.
  local x=864
  for py=0,28 do
    local half=30+py
    line(x-half,344+py,x+half,344+py,py<5 and 50 or 49)
  end
  line(x-30,343,x+30,343,54)
  line(x-58,372,x+58,372,52)
  -- Filled lower side planes frame an open, shadowed viewing cavity.
  rectfill(x-64,372,x-51,410,49)
  rectfill(x+51,372,x+64,410,49)
  rectfill(x-51,376,x+51,410,48)
  rectfill(x-45,382,x+45,410,40)
  -- Broken skylights make the sloped roof read as a manufactured shell.
  rectfill(x-35,351,x-15,360,40)
  rectfill(x-31,353,x-18,359,48)
  line(x-34,350,x-16,350,52)
  rectfill(x+14,354,x+37,363,40)
  rectfill(x+18,356,x+33,362,48)
  line(x+15,353,x+36,353,52)
  -- Ribs follow the roof facets into the side pylons.
  line(x-30,344,x-58,372,54)
  line(x,344,x,381,50)
  line(x+30,344,x+58,372,52)
  line(x-51,376,x-51,410,54)
  line(x+51,376,x+51,410,52)
  -- Orange house light hugs the underside and seating-facing edges.
  rectfill(x-48,381,x-13,386,26)
  rectfill(x+13,381,x+48,386,34)
  line(x-45,381,x-17,381,30)
  line(x+17,381,x+45,381,38)
  for px=x-43,x+43,14 do
    rectfill(px,389,px+6,392,49)
    pset(px+3,388,px<x and 31 or 36)
  end
end

local function draw_fenced_machine(x,y,accent)
  local glow=accent==10 and 9 or accent==36 and 34 or 41
  rectfill(x-27,y-39,x+27,y,49)
  rectfill(x-23,y-43,x+23,y-4,50)
  rectfill(x-18,y-36,x+18,y-9,glow)
  rectfill(x-14,y-33,x+14,y-12,48)
  rect(x-15,y-34,x+15,y-11,accent)
  rectfill(x-10,y-29,x+10,y-16,50)
  circfill(x,y-22,7,49) circ(x,y-22,7,55)
  line(x,y-28,x,y-16,13) line(x-6,y-22,x+6,y-22,13)
  for a=0,3 do
    local ax=x+cos(a/4)*5 local ay=y-22+sin(a/4)*5
    line(x,y-22,ax,ay,54)
  end
  rectfill(x-21,y-8,x+21,y-3,52)
  for px=x-22,x+22,11 do
    line(px,y,px,y-44,55)
    line(px,y-40,px+11,y-5,52)
  end
  line(x-24,y-44,x+25,y-44,59)
  pset(x-20,y-37,accent) pset(x+20,y-37,31)
end

function env_fan(x,y,r,accent)
  if x+r<camera_x-2 or x-r>camera_x+SW+2 then return end
  circfill(x,y,r,50)
  circfill(x-3,y+3,r-4,49)
  circ(x,y,r,58)
  circ(x,y,r-3,54)
  circfill(x,y,3,49)
  for a=0,3 do
    local ax=x+cos(a/4)*(r-4)
    local ay=y+sin(a/4)*(r-4)
    line(x,y,ax,ay,54)
    circfill(ax,ay,2,a==0 and accent or 50)
  end
  circ(x,y,2,31)
end

function env_duct(x,y,w,h,accent)
  if x+w<camera_x-2 or x>camera_x+SW+2 then return end
  rectfill(x,y,x+w,y+h,50)
  rectfill(x+2,y+4,x+w-2,y+h,49)
  line(x+2,y,x+w-2,y,58)
  line(x+w,y+2,x+w,y+h-2,54)
  line(x+2,y+h,x+w-2,y+h,48)
  for px=x+8,x+w-6,14 do
    line(px,y-2,px,y+h+2,54)
    pset(px+1,y+1,accent)
  end
end

function env_ladder(x,top,bottom,accent)
  if x+7<camera_x-2 or x>camera_x+SW+2 then return end
  line(x,top,x,bottom,54)
  line(x+7,top,x+7,bottom,52)
  for py=top+4,bottom-2,7 do
    line(x+1,py,x+6,py,py%3==0 and accent or 55)
  end
end

function env_growth(x,y,w)
  if x+w+1<camera_x-2 or x-2>camera_x+SW+2 then return end
  for px=x,x+w,7 do
    if px+1>=camera_x-2 and px-2<camera_x+SW+2 then
      local h=2+(px*5)%7
      line(px,y,px-1,y-h,12)
      pset(px-2,y-h,14)
      if px%3==0 then pset(px+1,y-h+2,11) end
    end
  end
end

