function env_waterworks_chunk()
  -- A contiguous 72x76 pump-house mass: stepped storage tank, service bay,
  -- and thick pipe runs share one silhouette instead of floating circles.
  local x,y=224,472
  rectfill(x-36,y-68,x+35,y,48)
  rectfill(x-33,y-65,x+32,y-4,49)
  rectfill(x-28,y-72,x+4,y-5,50)
  rectfill(x-24,y-77,x,y-5,50)
  rectfill(x-20,y-81,x-4,y-5,50)
  rectfill(x-25,y-63,x+1,y-9,49)
  rectfill(x-21,y-58,x-3,y-14,48)
  line(x-23,y-62,x-1,y-62,54)
  line(x-23,y-28,x-1,y-28,52)
  rectfill(x+7,y-57,x+29,y-8,40)
  rectfill(x+11,y-52,x+25,y-14,48)
  rect(x+10,y-53,x+26,y-13,50)
  rectfill(x+14,y-48,x+22,y-42,50)
  for py=y-39,y-20,5 do line(x+14,py,x+22,py,52) end
  rectfill(x+15,y-18,x+21,y-15,40)
  pset(x+24,y-49,54) pset(x+8,y-38,26)
  for py=y-53,y-18,12 do
    line(x-25,py,x-20,py,52)
    pset(x-23,py+2,26)
  end
  -- Two-step cyan window and its reflected wet apron.
  rectfill(x-18,y-48,x-6,y-32,3)
  rectfill(x-16,y-46,x-8,y-33,5)
  line(x-15,y-45,x-9,y-45,6)
  fillp(0xaaaa,1)
  rectfill(x-25,y-13,x+17,y-8,3)
  fillp()
  rectfill(x-19,y-9,x+12,y-6,3)
  rectfill(x-12,y-6,x+6,y-4,5)
  line(x-5,y-3,x+3,y-3,6)
  pset(x-23,y-6,3) pset(x+15,y-5,1)
  -- Thick header and return pipes with square elbows.
  rectfill(x-34,y-61,x-27,y-19,50)
  rectfill(x-34,y-61,x+27,y-55,50)
  rectfill(x+22,y-55,x+28,y-26,50)
  line(x-32,y-59,x+25,y-59,54)
  line(x-31,y-18,x-7,y-18,52)
  rectfill(x-33,y-21,x-8,y-16,49)
  for py=y-52,y-24,9 do
    pset(x-30,py,5) pset(x+25,py+3,6)
  end
  -- Baked concrete scene cells provide irregular material response.
  env_pal(58,52) env_pal(59,54) env_pal(61,58) env_pal(63,59)
  spr(CONCRETE_FACE,x+12,y-48)
  spr(PIPEWORKS_FACE,x+12,y-32)
  spr(CONCRETE_FACE,x-18,y-24)
  env_begin_dim_palette()
end

function env_mutagen_chunk()
  -- A filled 80x78 processing block with two stepped vats and a shared pipe
  -- crown. Green light lives inside the cavities and leaks onto the apron.
  local x,y=752,472
  rectfill(x-40,y-69,x+39,y,48)
  rectfill(x-37,y-65,x+36,y-4,49)
