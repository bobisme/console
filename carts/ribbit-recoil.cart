  rectfill(25,214,166,258,48)
  rect(24,213,167,259,59)
  print("SCORE",34,221,59) print(score,157,221,63,"right")
  print("TIME",34,233,59) print(run_time(),157,233,63,"right")
  print("BUGS DE-FUNDED",34,245,59) print(bugs_defeated,157,245,63,"right")
  rectfill(53,265,139,286,35)
  rect(52,264,140,287,31)
  print("DISASTER RANK",96,268,59,"center")
  print(run_rank(),96,278,31,"center")
  rectfill(31,292,161,310,36)
  rect(30,291,162,311,63)
  print("PRESS A  NEXT INCIDENT",96,297,63,"center")
end

function _draw()
  reset_draw_state()
  if game_scene=="title" then draw_title()
  elseif game_scene=="win" then draw_win()
  else
    draw_backdrop()
    draw_world()
    draw_hud()
    draw_banner()
    if paused then draw_pause() end
    if fire_timer>0 then
      local heat_y=flr(player_y+6-camera_y+HUD_H)
      for y=max(HUD_H,heat_y-10),min(SH-1,heat_y+10),2 do
        rshift(y,sin(t()*4+y/13))
      end
    end
  end
  if transition>0 then
    mosaic(transition>9 and 8 or transition>6 and 4 or transition>3 and 2 or 1)
  end
  if flash>0 then
    for c=0,63 do pal(c,flash%2==0 and 63 or 31,1) end
  end
end

-- Deliberate, deterministic test hooks for console-agent scenarios.
function dev_status()
  local alive=0
  for i=1,#enemies do if enemies[i].alive and enemies[i].kind~=E_BOSS then alive=alive+1 end end
  local boss=enemies[#enemies]
  return {scene=game_scene,level=game_level,x=player_x,y=player_y,vx=vx,vy=vy,
    grounded=grounded,hp=player_hp,score=score,combo=combo,deaths=deaths,
    respawn=respawn_timer,coyote=coyote_timer,hop_buffer=hop_buffer,
    hops=hops,landings=landings,movement_fx=movement_fx,
    tongue=tongue_state,tongue_x=tongue_x,tongue_y=tongue_y,
    latched=tongue_state=="latched",rope=rope_len,
    mutation=mutation,laser=laser_unlocked,fire=fire_unlocked,
    bugs=alive,boss_started=boss_started,boss_hp=boss and boss.hp or 0,
    boss_defeated=boss_defeated,boss_x=boss and boss.x or 0,boss_y=boss and boss.y or 0,
    exit_open=exit_open,checkpoint=checkpoint_index,
    boss_phase=boss and boss.phase_id or 0,boss_vulnerable=boss and boss.vulnerable or false,
    boss_attack=boss and boss.attack_clock or 0,boss_telegraph=boss and boss.telegraph or 0,
    boss_salvo1=boss and boss.phase_salvos[1] or 0,
    boss_salvo2=boss and boss.phase_salvos[2] or 0,
    boss_salvo3=boss and boss.phase_salvos[3] or 0,
    bullets=#bullets,camera_x=camera_x,camera_y=camera_y,
    particles=#particles,explosions=#explosions,elapsed=run_frames,
    kills=bugs_defeated,max_combo=max_combo,secrets=secrets_found,rank=run_rank()}
end

function dev_warp(x,y)
  player_x,player_y,vx,vy=x,y,0,0
  grounded=false
  reset_tongue()
  camera_x=mid(0,x-SW*0.42,WORLD_W-SW)
  camera_y=mid(0,y-(SH-HUD_H)*0.56,WORLD_H-(SH-HUD_H))
end

function dev_stage_environment_at(x)
  camera_x=mid(0,x or 0,WORLD_W-SW)
  camera_y=WORLD_H-(SH-HUD_H)
  -- Keep the actor safely outside the review frame so pickups, pits, and the
  -- boss trigger cannot contaminate a deterministic environment capture.
  player_x,player_y=camera_x-100,0
  vx,vy,grounded=0,0,false
  reset_tongue()
  for i=1,#enemies do enemies[i].alive=false end
  for i=1,#pickups do pickups[i].alive=false end
  for i=1,#bombs do bombs[i].alive=false end
  for i=1,#secrets do secrets[i].alive=false end
  particles,explosions,bullets={},{},{}
  boss_started,boss_intro=false,0
  banner,banner_timer="",0
  transition,flash,shake,hitstop=0,0,0,0
  respawn_timer,hurt_timer,invuln=9999,0,9999
end

function dev_stage_environment_cull_at(x)
  -- Test-only staging may probe just outside normal camera clamps so both
  -- half-open edges of every world-space cull box remain regression-covered.
  dev_stage_environment_at(0)
  camera_x=x or 0
end

function dev_stage_environment(zone)
  zone=mid(0,flr(zone or 0),6)
  dev_stage_environment_at(zone*128)
end

function dev_grant(which)
  if which=="laser" or which=="all" then laser_unlocked=true mutation="LASER EYES" end
  if which=="fire" or which=="all" then fire_unlocked=true mutation="FIRE BREATH" end
  if which=="all" then laser_unlocked=true fire_unlocked=true end
  weapon_cooldown=0
end

function dev_start_boss()
  start_boss()
  boss_intro=0
end

function dev_damage_boss(amount)
  local e=enemies[#enemies]
  e.hurt=0
  damage_enemy(e,amount,"headless accountability")
end

function dev_boss_vulnerable()
  local e=enemies[#enemies]
  e.stun=90
  e.vulnerable=true
end

function dev_explode(x,y,power)
  add_explosion(x,y,power or 4,true)
end

function dev_spawn_enemy(kind,x,y)
  local code=kind=="beetle" and E_BEETLE or kind=="wasp" and E_WASP or E_GNAT
  local e=make_enemy({code,x,y,0})
  e.home_x,e.home_y,e.range=x,y,0
  table.insert(enemies,#enemies,e)
  return #enemies-1
end

function dev_stage_enemy_art(kind,attack)
  local code=kind=="beetle" and E_BEETLE or kind=="wasp" and E_WASP or E_GNAT
  for i=1,#enemies-1 do enemies[i].alive=false end
  local e=make_enemy({code,player_x+58,player_y-42,0})
  e.home_x,e.home_y,e.range=e.x,e.y,0
  e.stun=120
  if attack then
    local cycle=code==E_GNAT and 112 or code==E_BEETLE and 96 or 118
    local target=code==E_GNAT and 96 or code==E_BEETLE and 80 or 102
    e.phase=target-frame_now-1
  else
    e.phase=-frame_now-1
  end
  table.insert(enemies,#enemies,e)
  return #enemies-1
end

function dev_stage_boss_art(phase,mode)
  dev_warp(780,425)
  start_boss()
  boss_intro=0
  local e=enemies[#enemies]
  e.hp=phase==1 and 8 or phase==2 and 5 or 2
  e.phase_id=phase
  e.stun=0
  e.vulnerable=false
  e.telegraph=0
  local cycle=phase==1 and 132 or phase==2 and 110 or 92
  if mode=="attack" then
    e.attack_clock=8
  elseif mode=="open" then
    e.stun=90
    e.vulnerable=true
  else
    e.attack_clock=cycle-2
  end
end

function dev_boss_bounds(contact)
  local e=enemies[#enemies]
  local x,y,w,h=enemy_bounds(e,contact)
  return {x=x,y=y,w=w,h=h}
end

function dev_boss_weak_point()
  local e=enemies[#enemies]
  local x,y=boss_weak_point(e)
  return {x=x,y=y}
end

function dev_render_secret_probe()
  reset_draw_state()
  cls(0)
  draw_secret({alive=true,x=40,y=40},0)
  local seen={}
  for y=0,80 do
    for x=0,80 do
      local ink=pget(x,y)
      if ink>0 then seen[ink]=true end
    end
  end
  local colors={}
  for ink=1,63 do
    if seen[ink] then table.insert(colors,string.format("%d",ink)) end
  end
  pset(0,0,6)
  return {colors=table.concat(colors,","),sentinel=pget(0,0)}
end

function dev_enemy_hp(index)
  local e=enemies[index]
  return e and e.hp or -1
end

