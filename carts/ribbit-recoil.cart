__meta__
title=RIBBIT RECOIL
author=OpenAI Codex
version=1
preview_palette=48,48,41,36,38,31,14,11,4,2,7,63,59,55,52,45

__lua__
-- RIBBIT RECOIL
-- Level 1: THE MOSQUITO COMPLEX
-- A tongue-grappling mutant-frog action platformer for the 192x320 console.
-- Determinism contract: numeric iteration only, rnd()/srand(), frame-clock timing.

local SW, SH, HUD_H = 192, 320, 16
local WORLD_W, WORLD_H = 960, 512
local PLAYER_W, PLAYER_H = 14, 16
local GRAVITY, MAX_FALL = 0.25, 5.4
local MIN_ROPE, MAX_TONGUE, TONGUE_SPEED = 18, 116, 7.2
local HOP_SPEED, RUN_SPEED, AIR_SPEED = -4.65, 2.8, 3.4

local STEEL, GIRDER, MUD, ACID, BREAKABLE = 192, 193, 194, 195, 196
local E_GNAT, E_BEETLE, E_WASP, E_BOSS = 1, 2, 3, 4
local P_LASER, P_FIRE = 1, 2
local B_STINGER, B_BOMB = 1, 2

-- Compact authored sprite inks become semantic Apollo64 roles at draw time:
-- transparent, ink, violet, blood, orange, yellow, frog-light, frog-dark,
-- teal, blue, cyan, white, pale metal, steel, shadow metal, mutation magenta.
local INK_MAP = {48,48,41,36,38,31,14,11,4,2,7,63,59,55,52,45}

local LEVELS = {{
  name="THE MOSQUITO COMPLEX",
  subtitle="UNLICENSED PEST CONTROL ZONE",
  start={32,472},
  platforms={
    {0,61,28,3,STEEL}, {8,55,10,1,GIRDER}, {18,49,10,1,STEEL},
    {4,48,5,1,GIRDER}, {13,40,6,1,STEEL}, {23,33,6,1,GIRDER},
    {28,43,11,1,MUD}, {38,58,20,6,STEEL}, {38,49,14,1,GIRDER},
    {50,52,12,1,MUD}, {60,46,13,1,STEEL}, {68,55,15,1,GIRDER},
    {58,59,24,1,GIRDER},
    {82,59,38,5,STEEL}, {90,51,8,1,GIRDER}, {105,49,8,1,MUD},
    {114,55,6,1,GIRDER}, {28,62,10,2,ACID}, {58,62,24,2,ACID},
    {44,54,3,4,BREAKABLE}, {79,56,3,3,BREAKABLE},
    -- Optional vertical "executive ventilation shaft". The intake alternates
    -- short hop steps before opening into tongueable upper ledges.
    {47,55,5,1,GIRDER}, {51,51,5,1,MUD}, {47,47,6,1,GIRDER},
    {40,43,7,1,GIRDER}, {49,44,6,1,GIRDER}, {55,39,6,1,MUD},
    {49,35,6,1,GIRDER},
    {61,34,7,1,STEEL}, {68,39,5,1,GIRDER}, {74,42,7,1,STEEL},
    {85,39,7,1,GIRDER}, {97,36,7,1,MUD}, {109,40,7,1,GIRDER}
  },
  enemy_defs={
    {E_GNAT,126,414,42}, {E_BEETLE,310,300,30}, {E_WASP,282,290,46},
    {E_GNAT,420,290,46}, {E_BEETLE,470,320,36}, {E_WASP,560,250,44},
    {E_GNAT,620,310,48}, {E_BEETLE,690,448,46}, {E_WASP,742,356,38}
  },
  pickups={{P_LASER,338,449}, {P_FIRE,600,449}},
  bombs={{368,416}, {514,344}, {660,440}, {824,446}},
  secrets={{354,402,1500}},
  props={
    {"pipe",24,468,70}, {"fence",104,472,88}, {"sign",184,438,0},
    {"vent",244,456,0}, {"tank",404,432,0}, {"pipe",462,466,92},
    {"sign",574,430,1}, {"fence",674,450,74}, {"vent",736,440,0},
    {"tank",846,438,0}, {"pipe",886,470,54}
  },
  checkpoints={{330,444}, {650,432}},
  boss={x=854,y=438,range_x=30,range_y=34,hp=8},
  boss_trigger=760,
  boss_gate={x=816,y=432,h=56},
  exit={x=932,y=448,hitbox={x=920,y=426,w=24,h=34}}
}}

game_scene = "title"
game_level = 1
player_x, player_y = 32, 472
player_hp, player_max_hp = 5, 5
score, combo, deaths = 0, 0, 0
mutation = "NONE"
laser_unlocked, fire_unlocked = false, false
boss_started, boss_defeated, exit_open = false, false, false

local vx, vy = 0, 0
local face_left, grounded = false, false
local invuln, hurt_timer, respawn_timer = 0, 0, 0
local checkpoint_x, checkpoint_y, checkpoint_index = 32, 472, 0
local camera_x, camera_y = 0, WORLD_H-(SH-HUD_H)
local frame_now, paused, show_guide = 0, false, true
local transition, flash, shake, hitstop = 0, 0, 0, 0
local banner, banner_timer = "", 0
local boss_intro, boss_death_timer, boss_clock = 0, 0, 0
local combo_timer, weapon_cooldown = 0, 0
local laser_timer, laser_x2, laser_y2 = 0, 0, 0
local fire_timer, fire_aim_x, fire_aim_y = 0, 1, 0
local tongue_state, tongue_x, tongue_y = "idle", 0, 0
local tongue_dx, tongue_dy, tongue_len = 0, 0, 0
local tongue_tile_x, tongue_tile_y, rope_len, tongue_t0 = -1, -1, 0, 0
local level, enemies, pickups, bombs, secrets = nil, {}, {}, {}, {}
local particles, explosions, bullets, stars = {}, {}, {}, {}
local run_frames, bugs_defeated, max_combo, secrets_found = 0, 0, 0, 0
local tutorial_step = 0
local coyote_timer, hop_buffer, hop_hold = 0, 0, 0
local hops, landings, movement_fx = 0, 0, 0

local function frame_count()
  return flr(t()*60)
end

local function dist(x0,y0,x1,y1)
  local dx, dy = x1-x0, y1-y0
  return math.sqrt(dx*dx+dy*dy)
end

local function norm(dx,dy)
  local d = math.sqrt(dx*dx+dy*dy)
  if d < 0.001 then return 1,0 end
  return dx/d,dy/d
end

local function solid(tile)
  return tile==STEEL or tile==GIRDER or tile==MUD or tile==BREAKABLE
end

local function hazardous(tile)
  return tile==ACID
end

local function solid_box(x,y,w,h)
  local x0,x1=flr(x/8),flr((x+w-1)/8)
  local y0,y1=flr(y/8),flr((y+h-1)/8)
  for cy=y0,y1 do
    for cx=x0,x1 do
      local tile=mget(cx,cy)
      if solid(tile) then return tile,cx,cy end
    end
  end
  return nil,nil,nil
end

local function player_mouth()
  return player_x+(face_left and 2 or 12),player_y+6
end

local function player_center()
  return player_x+7,player_y+8
end

local function player_hits(x,y,w,h)
  return player_x < x+w and player_x+PLAYER_W > x
     and player_y < y+h and player_y+PLAYER_H > y
end

local function enemy_bounds(e,contact)
  if e.kind==E_BOSS then
    -- Wings are valid weapon targets; only the closed command pod deals contact damage.
    if contact then return e.x-13,e.y-12,50,52 end
    return e.x-34,e.y-14,92,58
  end
  return e.x,e.y,e.w,e.h
end

local function aim_vector(default_up)
  local ax=(btn(0) and -1 or 0)+(btn(1) and 1 or 0)
  local ay=(btn(2) and -1 or 0)+(btn(3) and 1 or 0)
  if ax==0 and ay==0 then
    ax=face_left and -1 or 1
    ay=default_up and -0.32 or 0
  elseif ax==0 and default_up and ay==0 then
    ay=-1
  end
  return norm(ax,ay)
end

-- Down is an action modifier for mutations, not an instruction to shoot the floor.
local function mutation_aim_vector()
  local ax=(btn(0) and -1 or 0)+(btn(1) and 1 or 0)
  local ay=btn(2) and -1 or 0
  if ax==0 and ay==0 then ax=face_left and -1 or 1 end
  return norm(ax,ay)
end

local function add_particle(x,y,dx,dy,life,color,size,gravity,kind)
  particles[#particles+1]={x=x,y=y,dx=dx,dy=dy,life=life,max=life,
    color=color,size=size or 1,gravity=gravity or 0,kind=kind or 0}
end

local function burst(x,y,color,count,force,kind)
  for i=1,count do
    local a=rnd(1)
    local speed=0.35+rnd(force)
    add_particle(x,y,cos(a)*speed,sin(a)*speed-0.3,
      13+flr(rnd(23)),color+flr(rnd(2)),i%4==0 and 2 or 1,0.045,kind)
  end
end

local function add_explosion(x,y,power,player_owned)
  explosions[#explosions+1]={x=x,y=y,life=24,max=24,power=power}
  burst(x,y,4,12+power*3,1.4+power*0.25,2)
  burst(x,y,12,7+power,0.9+power*0.18,3)
  shake=max(shake,5+power*2)
  flash=max(flash,power>2 and 3 or 1)
  hitstop=max(hitstop,power>2 and 4 or 2)
  sfx(21,5)
  if power>=3 then sfx(22,4) end
  if player_owned then
    local radius=24+power*6
    for cy=max(0,flr((y-radius)/8)),min(63,flr((y+radius)/8)) do
      for cx=max(0,flr((x-radius)/8)),min(127,flr((x+radius)/8)) do
        if mget(cx,cy)==BREAKABLE and dist(x,y,cx*8+4,cy*8+4)<radius then
          mset(cx,cy,0)
          burst(cx*8+4,cy*8+4,4,5,1.1,2)
          score=score+25
        end
      end
    end
    for i=1,#enemies do
      local e=enemies[i]
      local hx,hy,hw,hh=enemy_bounds(e,false)
      if e.alive and not (e.kind==E_BOSS and boss_defeated)
          and dist(x,y,hx+hw/2,hy+hh/2)<24+power*6 then
        e.pending_damage=max(e.pending_damage or 0,power)
      end
    end
  end
end

local function update_particles()
  for i=#particles,1,-1 do
    local p=particles[i]
    p.x,p.y=p.x+p.dx,p.y+p.dy
    p.dy,p.life=p.dy+p.gravity,p.life-1
    p.dx=p.dx*0.985
    if p.life<=0 then table.remove(particles,i) end
  end
  for i=#explosions,1,-1 do
    local e=explosions[i]
    e.life=e.life-1
    if e.life<=0 then table.remove(explosions,i) end
  end
end

local function set_banner(text,frames)
  banner,banner_timer=text,frames or 90
end

local function make_enemy(def)
  local kind,x,y,range=def[1],def[2],def[3],def[4]
  local hp,w,h=1,14,14
  if kind==E_BEETLE then hp,w,h=3,16,14 end
  if kind==E_WASP then hp,w,h=2,16,14 end
  return {kind=kind,x=x,y=y,home_x=x,home_y=y,range=range,dir=-1,
    hp=hp,max_hp=hp,w=w,h=h,alive=true,phase=flr(rnd(120)),
    hurt=0,last_fire=-99,pending_damage=0,stun=0,burning=0,telegraph=0}
end

local function build_level(index)
  game_level=index
  level=LEVELS[index]
  for cy=0,63 do for cx=0,127 do mset(cx,cy,0) end end
  for i=1,#level.platforms do
    local p=level.platforms[i]
    for cy=p[2],p[2]+p[4]-1 do
      for cx=p[1],p[1]+p[3]-1 do mset(cx,cy,p[5]) end
    end
  end
  enemies={}
  for i=1,#level.enemy_defs do enemies[#enemies+1]=make_enemy(level.enemy_defs[i]) end
  local bd=level.boss
  enemies[#enemies+1]={kind=E_BOSS,x=bd.x,y=bd.y,home_x=bd.x,home_y=bd.y,
    range=bd.range_x,range_y=bd.range_y,dir=-1,hp=bd.hp,max_hp=bd.hp,
    w=24,h=24,alive=true,dormant=true,
    phase=0,hurt=0,last_fire=-99,pending_damage=0,attack_clock=0,
    phase_id=1,phase_salvos={0,0,0},vulnerable=false,telegraph=0,stun=0,burning=0}
  pickups={}
  for i=1,#level.pickups do
    pickups[i]={kind=level.pickups[i][1],x=level.pickups[i][2],y=level.pickups[i][3],alive=true}
  end
  bombs={}
  for i=1,#level.bombs do bombs[i]={x=level.bombs[i][1],y=level.bombs[i][2],alive=true,hurt=0} end
  secrets={}
  for i=1,#level.secrets do
    secrets[i]={x=level.secrets[i][1],y=level.secrets[i][2],value=level.secrets[i][3],alive=true}
  end
end

local function reset_tongue()
  tongue_state,tongue_tile_x,tongue_tile_y,tongue_len="idle",-1,-1,0
end

local function reset_player(full)
  player_x,player_y=checkpoint_x,checkpoint_y
  vx,vy=0,0
  grounded,invuln,hurt_timer=false,75,0
  coyote_timer,hop_buffer,hop_hold=0,0,0
  respawn_timer,transition=0,12
  reset_tongue()
  if full then player_hp=player_max_hp end
end

local function start_game()
  build_level(1)
  local st=level.start
  player_x,player_y=st[1],st[2]
  checkpoint_x,checkpoint_y,checkpoint_index=st[1],st[2],0
  player_hp,score,combo,deaths=player_max_hp,0,0,0
  run_frames,bugs_defeated,max_combo,secrets_found=0,0,0,0
  hops,landings,movement_fx=0,0,0
  tutorial_step=0
  laser_unlocked,fire_unlocked,mutation=false,false,"NONE"
  boss_started,boss_defeated,exit_open=false,false,false
  boss_intro,boss_death_timer,boss_clock=0,0,0
  vx,vy,face_left,grounded=0,0,false,false
  invuln,hurt_timer,respawn_timer=0,0,0
  camera_x,camera_y=0,WORLD_H-(SH-HUD_H)
  particles,explosions,bullets={},{},{}
  transition,flash,shake,hitstop=12,0,0,0
  banner,banner_timer="",0
  paused=false
  reset_tongue()
  game_scene="play"
  music(0)
  master(2,1,0)
  echo(12,4,3)
  set_banner("A HOPS - HOLD B + AIM: TONGUE",180)
  printh("ribbit recoil level 1 start")
end

local function score_kill(e)
  combo=min(8,combo+1)
  max_combo=max(max_combo,combo)
  bugs_defeated=bugs_defeated+1
  combo_timer=180
  local base=e.kind==E_GNAT and 100 or e.kind==E_BEETLE and 175 or 250
  score=score+base*combo
end

local function kill_enemy(e,source)
  if not e.alive then return end
  e.alive=false
  score_kill(e)
  burst(e.x+e.w/2,e.y+e.h/2,e.kind==E_BEETLE and 8 or 3,18,1.8,1)
  if e.kind==E_BEETLE then add_explosion(e.x+8,e.y+7,1,true) else sfx(20) end
  hitstop=max(hitstop,2)
  printh("bug deleted by "..source.." combo "..combo)
end

local function damage_enemy(e,amount,source)
  if not e.alive or e.dormant or e.hurt>0
      or (e.kind==E_BOSS and boss_defeated) then return false end
  if e.kind==E_BOSS and not e.vulnerable and source~="headless accountability"
      and source~="reflected stinger" and source~="tongue" then
    e.hurt=2
    burst(e.x+e.w/2,e.y+e.h/2,10,5,0.8,4)
    sfx(18,4)
    return false
  end
  if e.kind==E_BOSS and source=="tongue" then
    e.stun=max(e.stun or 0,42)
    e.vulnerable=true
  end
  if e.kind==E_BOSS and source=="tongue" then amount=max(amount,2) end
  if e.kind==E_BOSS and source=="laser eyes" then amount=max(amount,3) end
  if e.kind==E_BOSS then invuln=max(invuln,16) end
  local old_phase=e.kind==E_BOSS and e.phase_id or 0
  e.hp=e.hp-amount
  if e.kind==E_BOSS and e.hp>0 then
    local new_phase=e.hp>5 and 1 or e.hp>2 and 2 or 3
    if new_phase>old_phase then
      e.phase_id=new_phase
      e.attack_clock=0
      e.vulnerable=false
      e.telegraph=30
      e.stun=0
      bullets={}
      set_banner("BUZZKILL PHASE "..new_phase..": NEW BAD IDEA",70)
      sfx(27,5)
    end
  end
  e.hurt=e.kind==E_BOSS and 5 or 3
  shake=max(shake,e.kind==E_BOSS and 4 or 2)
  burst(e.x+e.w/2,e.y+e.h/2,5,5,0.9,1)
  sfx(20)
  if e.hp<=0 then
    if e.kind==E_BOSS then
      boss_defeated=true
      boss_death_timer=150
      e.hp=0
      reset_tongue()
      bullets={}
      invuln=max(invuln,190)
      music(-1)
      master(5,2,0)
      echo(18,6,6)
      sfx(27,5)
      set_banner("BUZZKILL: DISHONORABLY DISCHARGED",150)
      score=score+5000
      printh("boss defeated at frame "..frame_now)
    else
      kill_enemy(e,source)
    end
  end
  return true
end

local function destroy_bomb(b)
  if not b.alive then return end
  b.alive=false
  add_explosion(b.x,b.y,4,true)
  score=score+250
end

local function hurt_player(reason,from_x)
  if invuln>0 or respawn_timer>0 or game_scene~="play" or boss_defeated then return end
  player_hp=player_hp-1
  invuln,hurt_timer=70,24
  vx=(player_x<from_x and -2.8 or 2.8)
  vy=-3.3
  reset_tongue()
  flash,shake,hitstop=4,9,5
  sfx(23)
  combo,combo_timer=0,0
  printh("frog hurt by "..reason.." hp "..player_hp)
  if player_hp<=0 then
    player_hp=0
    deaths=deaths+1
    respawn_timer=72
    music(-1)
    sfx(24,5)
    set_banner("CLINICALLY DE-FROGGED",65)
  end
end

local function fatal_player(reason)
  if respawn_timer>0 or game_scene~="play" then return false end
  player_hp=0
  deaths=deaths+1
  respawn_timer=60
  vx,vy,grounded=0,0,false
  coyote_timer,hop_buffer,hop_hold=0,0,0
  reset_tongue()
  music(-1)
  flash,shake,hitstop,transition=5,10,5,10
  sfx(24,5)
  set_banner("INSTANTLY DE-FROGGED BY "..reason,75)
  printh("frog fatally submerged by "..reason)
  return true
end

local function move_x(amount)
  local remain,dir=abs(amount),amount<0 and -1 or 1
  while remain>0 do
    local step=min(1,remain)*dir
    if solid_box(player_x+step,player_y,PLAYER_W,PLAYER_H) then
      vx=0
      return true
    end
    player_x=player_x+step
    remain=remain-abs(step)
  end
  return false
end

local function move_y(amount)
  grounded=false
  local remain,dir=abs(amount),amount<0 and -1 or 1
  while remain>0 do
    local step=min(1,remain)*dir
    local tile,cx,cy=solid_box(player_x,player_y+step,PLAYER_W,PLAYER_H)
    if tile then
      if dir>0 then
        grounded=true
        player_y=cy*8-PLAYER_H
      end
      vy=0
      return tile,cx,cy
    end
    player_y=player_y+step
    remain=remain-abs(step)
  end
  -- Snap a subpixel gap to the floor. Without this probe gravity makes the
  -- frog alternate between airborne and landed every few frames while idle.
  if dir>0 then
    local tile,cx,cy=solid_box(player_x,player_y+1,PLAYER_W,PLAYER_H)
    if tile then
      grounded=true
      player_y=cy*8-PLAYER_H
      vy=0
      return tile,cx,cy
    end
  end
  return nil,nil,nil
end

local function start_hop()
  if hop_buffer<=0 or tongue_state=="latched"
      or not (grounded or coyote_timer>0) then return false end
  grounded=false
  coyote_timer,hop_buffer,hop_hold=0,0,10
  vy=HOP_SPEED
  if btn(0) then
    face_left=true
    vx=min(vx-0.32,-1.0)
  elseif btn(1) then
    face_left=false
    vx=max(vx+0.32,1.0)
  elseif abs(vx)<0.7 then
    vx=face_left and -0.7 or 0.7
  end
  hops=hops+1
  movement_fx=movement_fx+3
  for i=1,3 do
    add_particle(player_x+7+(i-2)*3,player_y+PLAYER_H,
      (i-2)*0.35,-0.45-rnd(0.25),8+i,6+i%2,1,0.04,4)
  end
  sfx(63,4)
  return true
end

local function start_tongue()
  if tongue_state~="idle" or respawn_timer>0 then return end
  local mx,my=player_mouth()
  local ax,ay=aim_vector(true)
  tongue_state,tongue_x,tongue_y="extend",mx,my
  tongue_dx,tongue_dy=ax*TONGUE_SPEED,ay*TONGUE_SPEED
  tongue_len,tongue_t0=0,frame_now
  sfx(16,4)
end

local function begin_retract()
  if tongue_state~="idle" then
    tongue_state,tongue_tile_x,tongue_tile_y="retract",-1,-1
    sfx(17,4)
  end
end

local function tongue_hit_enemy()
  for i=1,#enemies do
    local e=enemies[i]
    local hx,hy,hw,hh=enemy_bounds(e,false)
    if e.alive and not e.dormant and tongue_x>=hx-2 and tongue_x<=hx+hw+2
        and tongue_y>=hy-2 and tongue_y<=hy+hh+2 then
      damage_enemy(e,1,"tongue")
      if e.kind~=E_BOSS and e.alive then
        e.x=e.x+(player_x-e.x)*0.28
        e.y=e.y+(player_y-e.y)*0.28
        e.stun=max(e.stun or 0,45)
      end
      begin_retract()
      return true
    end
  end
  for i=1,#bombs do
    local b=bombs[i]
    if b.alive and dist(tongue_x,tongue_y,b.x,b.y)<9 then
      destroy_bomb(b)
      begin_retract()
      return true
    end
  end
  for i=#bullets,1,-1 do
    local b=bullets[i]
    if dist(tongue_x,tongue_y,b.x,b.y)<8 then
      table.remove(bullets,i)
      burst(b.x,b.y,10,10,1.1,4)
      local boss=enemies[#enemies]
      if b.kind==B_STINGER and boss and boss.alive and not boss.dormant
          and not boss_defeated then
        boss.stun=max(boss.stun or 0,42)
        boss.vulnerable=true
        damage_enemy(boss,2,"reflected stinger")
        burst(boss.x+12,boss.y+12,10,12,1.4,4)
      elseif b.kind==B_BOMB then
        add_explosion(b.x,b.y,3,true)
      end
      sfx(18,5)
      begin_retract()
      return true
    end
  end
  return false
end

local function latch_terrain(mx,my,last_x,last_y,cx,cy)
  tongue_state="latched"
  tongue_x,tongue_y=last_x,last_y
  tongue_tile_x,tongue_tile_y=cx,cy
  rope_len=mid(MIN_ROPE,dist(mx,my,tongue_x,tongue_y),MAX_TONGUE)
  sfx(18,4)
  burst(tongue_x,tongue_y,10,9,1.0,1)
  shake=max(shake,3)
  if tutorial_step==0 then
    tutorial_step=1
    set_banner("REEL UP/DOWN - RELEASE B TO LAUNCH",150)
  end
end

local function grapple_point()
  local mx,my=player_mouth()
  local ax,ay=aim_vector(true)
  local x,y=mx,my
  for step=1,flr(MAX_TONGUE/3) do
    local last_x,last_y=x,y
    x,y=x+ax*3,y+ay*3
    local cx,cy=flr(x/8),flr(y/8)
    if solid(mget(cx,cy)) then return last_x,last_y,cx,cy end
  end
  return nil,nil,nil,nil
end

local function update_tongue()
  local mx,my=player_mouth()
  if tongue_state=="idle" then return end
  if tongue_state=="extend" then
    local steps=max(1,ceil(max(abs(tongue_dx),abs(tongue_dy))))
    local sx,sy=tongue_dx/steps,tongue_dy/steps
    for step=1,steps do
      local last_x,last_y=tongue_x,tongue_y
      tongue_x,tongue_y=tongue_x+sx,tongue_y+sy
      tongue_len=dist(mx,my,tongue_x,tongue_y)
      if tongue_hit_enemy() then return end
      local cx,cy=flr(tongue_x/8),flr(tongue_y/8)
      if solid(mget(cx,cy)) then
        latch_terrain(mx,my,last_x,last_y,cx,cy)
        return
      end
      if tongue_len>MAX_TONGUE or tongue_x<0 or tongue_x>WORLD_W
          or tongue_y<0 or tongue_y>WORLD_H then
        begin_retract()
        return
      end
    end
  elseif tongue_state=="latched" then
    if not solid(mget(tongue_tile_x,tongue_tile_y)) then begin_retract() return end
    if not btn(5) then
      vx,vy=vx*1.12,vy*1.08-0.65
      begin_retract()
      return
    end
    if btn(2) then rope_len=max(MIN_ROPE,rope_len-1.05) end
    if btn(3) then rope_len=min(MAX_TONGUE,rope_len+0.75) end
  elseif tongue_state=="retract" then
    tongue_len=max(0,tongue_len-12)
    if tongue_len<=0 or dist(mx,my,tongue_x,tongue_y)<12 then
      reset_tongue()
    else
      local nx,ny=norm(mx-tongue_x,my-tongue_y)
      tongue_x,tongue_y=tongue_x+nx*12,tongue_y+ny*12
    end
  end
end

local function constrain_rope()
  if tongue_state~="latched" then return end
  local cx,cy=player_center()
  local dx,dy=cx-tongue_x,cy-tongue_y
  local d=math.sqrt(dx*dx+dy*dy)
  if d>rope_len then
    local nx,ny=dx/d,dy/d
    local oldx,oldy=player_x,player_y
    player_x=tongue_x+nx*rope_len-7
    player_y=tongue_y+ny*rope_len-8
    if solid_box(player_x,player_y,PLAYER_W,PLAYER_H) then
      player_x,player_y=oldx,oldy
      rope_len=min(MAX_TONGUE,rope_len+1)
    else
      local radial=vx*nx+vy*ny
      if radial>0 then vx,vy=vx-radial*nx,vy-radial*ny end
      local pump=(btn(0) and -0.12 or 0)+(btn(1) and 0.12 or 0)
      vx=vx+pump
    end
  end
end

local function laser_attack()
  local mx,my=player_mouth()
  local ax,ay=mutation_aim_vector()
  local x,y=mx,my
  laser_x2,laser_y2=mx,my
  local hit_stamp=frame_now
  for step=1,52 do
    x,y=x+ax*3,y+ay*3
    local tcx,tcy=flr(x/8),flr(y/8)
    local tile=mget(tcx,tcy)
    if tile==BREAKABLE then
      -- Laser eyes punch a frog-sized aperture instead of shaving one pixel row.
      -- This makes the mutation read as a weapon and prevents an awkward
      -- second shot at a tile the standing frog cannot aim toward.
      for by=tcy-1,tcy+1 do
        for bx=tcx-1,tcx+1 do
          if mget(bx,by)==BREAKABLE then
            mset(bx,by,0)
            burst(bx*8+4,by*8+4,10,5,1.0,4)
            score=score+25
          end
        end
      end
      add_explosion(tcx*8+4,tcy*8+4,1,true)
      laser_x2,laser_y2=x,y
      break
    elseif solid(tile) then break end
    laser_x2,laser_y2=x,y
    for i=1,#enemies do
      local e=enemies[i]
      local hx,hy,hw,hh=enemy_bounds(e,false)
      if e.alive and not e.dormant and e.laser_stamp~=hit_stamp
          and x>=hx and x<=hx+hw and y>=hy and y<=hy+hh then
        e.laser_stamp=hit_stamp
        damage_enemy(e,1,"laser eyes")
      end
    end
    for i=1,#bombs do
      local b=bombs[i]
      if b.alive and dist(x,y,b.x,b.y)<8 then destroy_bomb(b) end
    end
  end
  local boss=enemies[#enemies]
  if boss and boss.kind==E_BOSS and boss.alive and not boss.dormant
      and boss.vulnerable and boss.laser_stamp~=hit_stamp then
    local hx,hy,hw,hh=enemy_bounds(boss,false)
    local bx,by=hx+hw/2,hy+hh/2
    local dx,dy=bx-mx,by-my
    local d=math.sqrt(dx*dx+dy*dy)
    if d<170 and d>0 and (dx/d)*ax+(dy/d)*ay>0.76 then
      boss.laser_stamp=hit_stamp
      laser_x2,laser_y2=bx,by
      damage_enemy(boss,1,"laser eyes")
    end
  end
  laser_timer,weapon_cooldown=6,12
  shake=max(shake,3)
  sfx(19,5)
  for i=1,7 do
    local along=rnd(1)
    add_particle(mx+(laser_x2-mx)*along,my+(laser_y2-my)*along,
      rnd(0.8)-0.4,rnd(0.8)-0.4,8+flr(rnd(7)),10,1,0,4)
  end
end

local function fire_damage()
  local mx,my=player_mouth()
  local ax,ay=fire_aim_x,fire_aim_y
  for i=1,4 do
    local spread=(rnd(1)-0.5)*0.48
    local px,py=-ay*spread,ax*spread
    local speed=2.2+rnd(2.4)
    add_particle(mx,my,(ax+px)*speed,(ay+py)*speed,14+flr(rnd(12)),
      i%3==0 and 5 or 4,i%2+1,-0.004,5)
  end
  for i=1,#enemies do
    local e=enemies[i]
    if e.alive and not e.dormant and frame_now-e.last_fire>=7 then
      local hx,hy,hw,hh=enemy_bounds(e,false)
      local ex,ey=hx+hw/2,hy+hh/2
      local dx,dy=ex-mx,ey-my
      local d=math.sqrt(dx*dx+dy*dy)
      if d<58 and d>0 and (dx/d)*ax+(dy/d)*ay>0.62 then
        e.last_fire=frame_now
        e.burning=max(e.burning or 0,e.kind==E_BOSS and 36 or 90)
        damage_enemy(e,1,"fire breath")
      end
    end
  end
  for i=1,#bombs do
    local b=bombs[i]
    if b.alive then
      local dx,dy=b.x-mx,b.y-my
      local d=math.sqrt(dx*dx+dy*dy)
      if d<55 and d>0 and (dx/d)*ax+(dy/d)*ay>0.58 then destroy_bomb(b) end
    end
  end
  for i=#bullets,1,-1 do
    local b=bullets[i]
    local dx,dy=b.x-mx,b.y-my
    local d=math.sqrt(dx*dx+dy*dy)
    if b.kind==B_BOMB and d<62 and d>0 and (dx/d)*ax+(dy/d)*ay>0.55 then
      table.remove(bullets,i)
      add_explosion(b.x,b.y,3,true)
    end
  end
end

local function use_mutation()
  if weapon_cooldown>0 then return end
  if mutation=="LASER EYES" then laser_attack()
  elseif mutation=="FIRE BREATH" then
    fire_aim_x,fire_aim_y=mutation_aim_vector()
    fire_timer,weapon_cooldown=22,8
    sfx(25,5)
  else
    set_banner("DOWN+A: INSUFFICIENTLY MUTATED",65)
    sfx(17,5)
    weapon_cooldown=20
  end
end

local function cycle_mutation()
  if not (laser_unlocked and fire_unlocked) then return false end
  mutation=mutation=="LASER EYES" and "FIRE BREATH" or "LASER EYES"
  set_banner("MUTATION SELECTED: "..mutation,65)
  sfx(26,5)
  weapon_cooldown=14
  return true
end

local function collect_pickups()
  for i=1,#pickups do
    local p=pickups[i]
    if p.alive and player_hits(p.x-8,p.y-8,16,16) then
      p.alive=false
      if p.kind==P_LASER then
        laser_unlocked,mutation=true,"LASER EYES"
        set_banner("DOWN+A LASER: AIM + CUT WALLS",120)
      else
        fire_unlocked,mutation=true,"FIRE BREATH"
        set_banner("DOWN+A FIRE: IGNITE BUGS + BOMBS",120)
      end
      score=score+750
      flash,shake,transition=5,7,7
      master(4,1,0)
      sfx(26,5)
      burst(p.x,p.y,10,30,2.5,4)
      printh("mutation acquired "..mutation)
      if laser_unlocked and fire_unlocked then
        tutorial_step=2
        set_banner("DOWN+B SWAPS - DOWN+A MUTATES",150)
      end
    end
  end
end

local function collect_secrets()
  for i=1,#secrets do
    local s=secrets[i]
    -- Golden Flies are deliberate tongue-snatch rewards, not main-route pickups.
    if s.alive and tongue_state=="latched"
        and player_hits(s.x-7,s.y-7,14,14) then
      s.alive=false
      secrets_found=secrets_found+1
      score=score+s.value
      max_combo=max(max_combo,combo)
      set_banner("SECRET: EXECUTIVE GOLDEN FLY",120)
      master(4,1,0)
      sfx(26,5)
      burst(s.x,s.y,31,36,2.8,4)
    end
  end
end

local function update_checkpoints()
  for i=checkpoint_index+1,#level.checkpoints do
    local c=level.checkpoints[i]
    if player_x>=c[1] then
      checkpoint_index=i
      checkpoint_x,checkpoint_y=c[1],c[2]
      player_hp=player_max_hp
      set_banner("CROAKPOINT "..i.." SANITIZED",70)
      sfx(26,5)
      burst(c[1],c[2],6,16,1.3,1)
      break
    end
  end
end

local function add_bullet(kind,x,y,dx,dy,life)
  bullets[#bullets+1]={kind=kind,x=x,y=y,dx=dx,dy=dy,life=life}
end

local function shoot_at_player(e,kind,speed)
  local px,py=player_center()
  local nx,ny=norm(px-(e.x+e.w/2),py-(e.y+e.h/2))
  add_bullet(kind,e.x+e.w/2,e.y+e.h/2,nx*speed,ny*speed,180)
  sfx(kind==B_BOMB and 29 or 28,4)
end

local function shoot_fan(e,count,speed,spread)
  local px,py=player_center()
  local nx,ny=norm(px-(e.x+e.w/2),py-(e.y+e.h/2))
  for i=1,count do
    local offset=(i-(count+1)/2)*spread
    local cs,sn=cos(offset),sin(offset)
    add_bullet(B_STINGER,e.x+12,e.y+12,
      (nx*cs-ny*sn)*speed,(nx*sn+ny*cs)*speed,180)
  end
  sfx(28,4)
end

local function update_bullets()
  for i=#bullets,1,-1 do
    local b=bullets[i]
    b.x,b.y=b.x+b.dx,b.y+b.dy
    b.life=b.life-1
    if b.kind==B_BOMB then b.dy=b.dy+0.055 end
    local remove=b.life<=0 or b.x<0 or b.x>WORLD_W or b.y<0 or b.y>WORLD_H
    if not remove and solid(mget(flr(b.x/8),flr(b.y/8))) then
      if b.kind==B_BOMB then add_explosion(b.x,b.y,2,false) end
      remove=true
    end
    if not remove and player_hits(b.x-2,b.y-2,4,4) then
      hurt_player(b.kind==B_BOMB and "weaponized larva" or "stinger",b.x)
      if b.kind==B_BOMB then add_explosion(b.x,b.y,2,false) end
      remove=true
    end
    if remove then table.remove(bullets,i) end
  end
end

local function update_enemies()
  for i=1,#enemies do
    local e=enemies[i]
    if e.alive then
      if e.hurt>0 then e.hurt=e.hurt-1 end
      if (e.stun or 0)>0 then e.stun=e.stun-1 end
      if (e.burning or 0)>0 then
        e.burning=e.burning-1
        if e.burning%15==0 and e.hurt<=0 then damage_enemy(e,1,"ignition") end
        if e.burning%5==0 then
          add_particle(e.x+rnd(e.w),e.y+rnd(e.h),rnd(0.6)-0.3,-0.8-rnd(0.6),
            12,4,1,-0.01,5)
        end
      end
      if (e.pending_damage or 0)>0 then
        local d=e.pending_damage
        e.pending_damage=0
        damage_enemy(e,d,"explosion")
      end
      if e.kind==E_GNAT then
        local cycle=(frame_now+e.phase)%112
        e.telegraph=abs(player_x-e.x)<130 and cycle>=92 and 112-cycle or 0
        if (e.stun or 0)<=0 then
          e.x=e.home_x+sin((frame_now+e.phase)*0.009)*e.range
          e.y=e.home_y+sin((frame_now+e.phase)*0.017)*12
          if cycle==0 and abs(player_x-e.x)<130 then
            local nx,ny=norm(player_x-e.x,player_y-e.y)
            e.x,e.y=e.x+nx*12,e.y+ny*12
          end
        end
      elseif e.kind==E_BEETLE then
        local cycle=(frame_now+e.phase)%96
        e.telegraph=abs(player_x-e.x)<120 and cycle>=76 and 96-cycle or 0
        if (e.stun or 0)<=0 then
          local speed=cycle<14 and abs(player_x-e.x)<120 and 1.45 or 0.48
          e.x=e.x+e.dir*speed
          if e.x<e.home_x-e.range or e.x>e.home_x+e.range then e.dir=-e.dir end
        end
      elseif e.kind==E_WASP then
        local cycle=(frame_now+e.phase)%118
        e.telegraph=abs(player_x-e.x)<210 and cycle>=98 and 118-cycle or 0
        if (e.stun or 0)<=0 then
          e.x=e.home_x+sin((frame_now+e.phase)*0.006)*e.range
          e.y=e.home_y+cos((frame_now+e.phase)*0.011)*18
          if abs(player_x-e.x)<210 and cycle==0 then shoot_at_player(e,B_STINGER,2.1) end
        end
      elseif e.kind==E_BOSS and not e.dormant and not boss_defeated then
        e.phase_id=e.hp>5 and 1 or e.hp>2 and 2 or 3
        local cycle=e.phase_id==1 and 132 or e.phase_id==2 and 110 or 92
        if boss_intro>0 then
          e.vulnerable=false
          e.telegraph=0
        elseif (e.stun or 0)>0 then
          e.vulnerable=true
          e.telegraph=0
        else
          e.attack_clock=(e.attack_clock or 0)+1
          local tick=e.attack_clock%cycle
          e.telegraph=tick<30 and 30-tick or 0
          e.vulnerable=tick>=30 and tick<78
          if tick==30 then
            e.phase_salvos[e.phase_id]=e.phase_salvos[e.phase_id]+1
            if e.phase_id==1 then
              shoot_fan(e,3,2.25,0.035)
            elseif e.phase_id==2 then
              shoot_at_player(e,B_BOMB,1.55)
              shoot_fan(e,3,2.55,0.055)
            else
              shoot_fan(e,5,2.9,0.07)
              add_bullet(B_STINGER,e.x+12,e.y+12,-3.1,0,150)
            end
          end
        end
        e.x=e.home_x+sin(boss_clock*(e.phase_id==3 and 0.014 or 0.007))*e.range
        e.y=e.home_y+sin(boss_clock*0.012)*(e.phase_id==1 and 8 or e.phase_id==2 and 24 or 34)
        e.dir=player_x<e.x and -1 or 1
      end
      local hx,hy,hw,hh=enemy_bounds(e,true)
      if e.alive and not e.dormant and not boss_defeated
          and player_hits(hx+2,hy+2,hw-4,hh-4) then
        hurt_player(e.kind==E_BOSS and "industrial proboscis" or "insect",e.x+e.w/2)
      end
    end
  end
end

local function start_boss()
  if boss_started then return end
  boss_started=true
  boss_clock=0
  boss_intro=105
  local e=enemies[#enemies]
  e.dormant=false
  e.attack_clock=0
  e.phase_salvos={0,0,0}
  camera_x=mid(0,player_x*0.35+e.x*0.65-SW/2,WORLD_W-SW)
  camera_y=mid(0,e.y-156,WORLD_H-(SH-HUD_H))
  music(8)
  master(3,1,0)
  echo(9,5,4)
  set_banner("COLONEL BUZZKILL: MOSQUITO OF OPS",105)
  sfx(27,5)
  shake,flash=12,3
  printh("boss encounter started")
end

local function update_boss_death()
  if not boss_defeated then return end
  local e=enemies[#enemies]
  if boss_death_timer>0 then
    boss_death_timer=boss_death_timer-1
    e.x=e.x+(rnd(2)-1)*2
    e.y=e.y+(rnd(2)-1)*2
    if boss_death_timer%10==0 then
      add_explosion(e.x+rnd(e.w),e.y+rnd(e.h),2+flr(rnd(3)),true)
    end
    if boss_death_timer==1 then
      e.alive=false
      local gate=level.boss_gate
      for y=gate.y,gate.y+gate.h,8 do burst(gate.x,y,7,3,0.7,2) end
      exit_open=true
      master(2,1,0)
      echo(14,5,5)
      music(16)
      set_banner("EVAC LILY DEPLOYED. HOP RESPONSIBLY.",125)
    end
  end
end

local function check_hazards()
  local x0,x1=flr(player_x/8),flr((player_x+PLAYER_W-1)/8)
  local y0,y1=flr(player_y/8),flr((player_y+PLAYER_H-1)/8)
  for cy=y0,y1 do
    for cx=x0,x1 do
      if hazardous(mget(cx,cy)) then return fatal_player("UNION-GRADE RUNOFF") end
    end
  end
  if player_y>WORLD_H+8 then return fatal_player("THE BOTTOMLESS PUDDLE") end
  return false
end

local function finish_level()
  if game_scene=="win" then return end
  game_scene="win"
  music(16)
  master(4,1,0)
  echo(18,6,6)
  transition=10
  burst(player_x+7,player_y+8,6,60,3.2,4)
  sfx(30,5)
  printh("level complete score "..score.." deaths "..deaths)
end

local function run_rank()
  local combat=bugs_defeated>=6 and 2 or bugs_defeated>=3 and 1 or 0
  local bonus=combat+(secrets_found>0 and 2 or 0)+(deaths==0 and 2 or 0)
    +(max_combo>=5 and 1 or 0)+(run_frames<60*75 and 1 or 0)
  -- Pacifism is admirable, but it is not pest control.
  if bugs_defeated==0 then return bonus>0 and "B" or "C" end
  if bonus>=7 then return "S" end
  if bonus>=4 then return "A" end
  if bonus>=1 then return "B" end
  return "C"
end

local function run_time()
  local total=flr(run_frames/60)
  local minutes=flr(total/60)
  local seconds=total%60
  return minutes..":"..(seconds<10 and "0" or "")..seconds
end

local function update_play()
  if btnp(6) then
    paused=not paused
    if paused then sfx(-1) else sfx(26,5) end
  end
  if paused then return end
  if boss_intro>0 then boss_intro=boss_intro-1 end
  run_frames=run_frames+1
  if boss_started and not boss_defeated and boss_intro<=0 then boss_clock=boss_clock+1 end
  if respawn_timer>0 then
    respawn_timer=respawn_timer-1
    if respawn_timer==1 then
      player_hp=player_max_hp
      reset_player(true)
      music(boss_started and not boss_defeated and 8 or 0)
      master(2,1,0)
      echo(12,4,3)
    end
    return
  end

  if grounded then coyote_timer=7 else coyote_timer=max(0,coyote_timer-1) end
  if hop_buffer>0 then hop_buffer=hop_buffer-1 end

  if btnp(4) then
    if btn(3) then use_mutation() else hop_buffer=7 end
  end
  if btnp(5) then
    if not (btn(3) and cycle_mutation()) then start_tongue() end
  end
  if fire_timer>0 then
    fire_timer=fire_timer-1
    if fire_timer%8==0 then sfx(25,5) end
    if fire_timer%2==0 then fire_damage() end
  end

  start_hop()
  local accel=grounded and 0.28 or 0.17
  local speed_cap=grounded and RUN_SPEED or AIR_SPEED
  if tongue_state=="latched" then speed_cap,accel=4.6,0.18 end
  if btn(0) then
    face_left=true
    if vx>-speed_cap then vx=max(-speed_cap,vx-accel) else vx=vx*0.998 end
  end
  if btn(1) then
    face_left=false
    if vx<speed_cap then vx=min(speed_cap,vx+accel) else vx=vx*0.998 end
  end
  if not btn(0) and not btn(1) then vx=vx*(grounded and 0.84 or 0.995) end
  local gravity=GRAVITY
  if vy<0 and btn(4) and hop_hold>0 then
    gravity=0.13
    hop_hold=hop_hold-1
  else
    hop_hold=0
  end
  vy=min(MAX_FALL,vy+gravity)

  move_x(vx)
  local gate=level.boss_gate
  if boss_started and not exit_open and player_x+PLAYER_W>gate.x then
    player_x=gate.x-PLAYER_W
    vx=0
  end
  local was_grounded=grounded
  local impact_vy=vy
  move_y(vy)
  constrain_rope()
  update_tongue()
  if not was_grounded and grounded and impact_vy>1.6 then
    landings=landings+1
    movement_fx=movement_fx+2
    add_particle(player_x+3,player_y+PLAYER_H,-0.8,-0.35,8,7,1,0.04,4)
    add_particle(player_x+11,player_y+PLAYER_H,0.8,-0.35,8,7,1,0.04,4)
    sfx(17,5)
    if impact_vy>3 then shake=max(shake,2) end
  end

  collect_pickups()
  collect_secrets()
  update_checkpoints()
  update_enemies()
  update_bullets()
  update_boss_death()
  if check_hazards() then return end
  if not boss_started and player_x>level.boss_trigger then start_boss() end
  local exit_hitbox=level.exit.hitbox
  if exit_open and player_hits(exit_hitbox.x,exit_hitbox.y,exit_hitbox.w,exit_hitbox.h) then
    finish_level()
  end

  player_x=mid(0,player_x,WORLD_W-PLAYER_W)
  local tx=mid(0,player_x-SW*0.42,WORLD_W-SW)
  local ty=mid(0,player_y-(SH-HUD_H)*0.56,WORLD_H-(SH-HUD_H))
  if boss_started and not exit_open then
    local boss=enemies[#enemies]
    -- Frame the frog and Colonel together; the arena is a confrontation, not a corner cameo.
    tx=mid(0,player_x*0.35+boss.x*0.65-SW/2,WORLD_W-SW)
    ty=mid(0,boss.y-156,WORLD_H-(SH-HUD_H))
    -- Retreats and checkpoint respawns always keep the player inside a 16px safe frame.
    tx=mid(player_x+PLAYER_W-SW+16,tx,player_x-16)
    ty=mid(player_y-272,ty,player_y-16)
    tx=mid(0,tx,WORLD_W-SW)
    ty=mid(0,ty,WORLD_H-(SH-HUD_H))
  end
  camera_x=camera_x+(tx-camera_x)*0.105
  camera_y=camera_y+(ty-camera_y)*0.105
  if boss_started and not exit_open then
    -- The smoothed camera itself is clamped too, so fast knockback cannot outrun its target.
    camera_x=mid(player_x+PLAYER_W-SW+16,camera_x,player_x-16)
    camera_y=mid(player_y-272,camera_y,player_y-16)
    camera_x=mid(0,camera_x,WORLD_W-SW)
    camera_y=mid(0,camera_y,WORLD_H-(SH-HUD_H))
  end
end

function _init()
  srand(8675309)
  for i=1,80 do
    stars[i]={x=flr(rnd(WORLD_W)),y=flr(rnd(250)),phase=flr(rnd(90)),c=8+flr(rnd(4))}
  end
  printh("ribbit recoil init; frog frames="..anim_len("frog.run"))
end

function _update()
  frame_now=frame_count()
  if transition>0 then transition=transition-1 end
  if flash>0 then flash=flash-1 end
  if shake>0 then shake=shake-1 end
  if invuln>0 then invuln=invuln-1 end
  if hurt_timer>0 then hurt_timer=hurt_timer-1 end
  if banner_timer>0 then banner_timer=banner_timer-1 end
  if combo_timer>0 then
    combo_timer=combo_timer-1
    if combo_timer==0 then combo=0 end
  end
  if weapon_cooldown>0 then weapon_cooldown=weapon_cooldown-1 end
  if laser_timer>0 then laser_timer=laser_timer-1 end
  update_particles()

  if hitstop>0 then hitstop=hitstop-1 return end
  if game_scene=="title" then
    if btnp(6) then show_guide=not show_guide end
    if btnp(4) or btnp(5) then start_game() end
  elseif game_scene=="play" then
    update_play()
  elseif game_scene=="win" then
    if btnp(4) or btnp(5) then
      music(-1)
      echo(0)
      game_scene="title"
    end
  end
end

local function reset_draw_state()
  camera()
  clip()
  pal()
  for ink=0,15 do pal(ink,INK_MAP[ink+1]) end
  palt()
  fillp()
  mosaic()
  rshift()
end

local ZONE_ACCENT={6,4,10,45,31,36,14}

local function scene_zone()
  return mid(0,flr((camera_x+92)/128),6)
end

local function draw_cloud_mass(x,y,w,shadow,light)
  fillp(0xaaaa,shadow)
  rectfill(x,y,x+w,y+5,shadow)
  circfill(x+8,y,5,shadow)
  circfill(x+flr(w*0.45),y-3,7,shadow)
  circfill(x+w-8,y+1,5,shadow)
  fillp()
  line(x+3,y+4,x+w-2,y+4,light)
  line(x+12,y-4,x+flr(w*0.45),y-7,light)
end

local function draw_backdrop()
  local zone=scene_zone()
  local accent=ZONE_ACCENT[zone+1]
  cls(49)
  rectfill(0,HUD_H,SW-1,76,40)
  rectfill(0,77,SW-1,143,41)
  rectfill(0,144,SW-1,211,9)
  rectfill(0,212,SW-1,SH-1,1)
  fillp(0x8888,49)
  rectfill(0,80,SW-1,108,41)
  fillp()

  -- A stable landmark moon. Its full silhouette is deliberately kept in frame.
  if zone<=1 or zone==6 then
    local moon_x=zone==6 and 50 or 146
    local moon_y=54+flr((camera_y-208)/64)
    fillp(0xaaaa,40) circfill(moon_x,moon_y,35,14) fillp()
    circfill(moon_x,moon_y,27,60)
    circ(moon_x,moon_y,28,63)
    circ(moon_x,moon_y,31,10)
    circfill(moon_x-9,moon_y-8,7,56)
    circfill(moon_x+10,moon_y+7,6,55)
    circ(moon_x+7,moon_y-12,4,52)
    circ(moon_x-13,moon_y+11,5,53)
    line(moon_x-18,moon_y-18,moon_x-7,moon_y-23,61)
    pset(moon_x+15,moon_y-4,63)
    pset(moon_x-2,moon_y+18,63)
  end

  for i=1,#stars do
    local s=stars[i]
    local sx=(s.x-flr(camera_x*0.10))%(SW+30)-15
    local sy=s.y-flr(camera_y*0.07)+HUD_H
    if sy>HUD_H and sy<147 and (frame_now+s.phase)%74<57 then
      pset(sx,sy,s.c)
      if i%11==0 and (frame_now+s.phase)%74<4 then
        pset(sx-1,sy,s.c+1) pset(sx+1,sy,s.c+1)
      end
    end
  end

  -- Thin vapor shelves leave room for silhouettes instead of reading as black hills.
  for band=0,1 do
    local cy=116+band*47+flr((camera_y-208)*(0.015+band*0.01))
    local drift=flr(camera_x*(0.045+band*0.035))
    for i=0,3 do
      local x=(i*70+band*27-drift)%(SW+88)-44
      draw_cloud_mass(x,cy,36+((i+zone)%3)*7,
        band==0 and 50 or 8,band==0 and 52 or 9)
    end
  end

  -- Far skyline: narrow, quiet, and low contrast.
  for i=0,15 do
    local x=(i*19-flr(camera_x*0.10))%(SW+44)-22
    local w=11+(i*7+zone*3)%12
    local h=38+(i*13+zone*9)%62
    local top=229-h
    rectfill(x,top,x+w,SH,49)
    rectfill(x+2,top+3,x+w-2,SH,50)
    line(x+2,top+2,x+w-2,top+2,52)
    if (i+zone)%4==0 then
      rectfill(x+3,top-7,x+w-3,top,49)
      line(x+w/2,top-7,x+w/2,top-14,52)
      pset(x+w/2,top-15,accent)
    elseif (i+zone)%4==1 then
      rectfill(x+w-6,top-10,x+w-3,top,50)
      line(x+w-5,top-10,x+w-5,top-17,52)
    elseif (i+zone)%4==2 then
      line(x+2,top,x+w-2,top-8,51)
      line(x+w-2,top,x+2,top-8,51)
    end
    for wy=top+9,226,9 do
      for wx=x+4,x+w-4,6 do
        if (i+wx+wy+zone)%4<2 then
          pset(wx,wy,(wy+i)%5==0 and accent or 30)
        end
      end
    end
  end

  -- Middle skyline uses larger authored shapes and warmer focal windows.
  for i=0,8 do
    local x=(i*34+zone*11-flr(camera_x*0.22))%(SW+68)-34
    local w=24+(i*9+zone*5)%20
    local top=176+(i*17+zone*13)%44
    rectfill(x,top,x+w,SH,49)
    rect(x+2,top+3,x+w-2,SH,51)
    line(x+3,top+2,x+w-3,top+2,53)
    if (i+zone)%3==0 then
      rectfill(x+5,top-9,x+w-6,top,49)
      line(x+w/2,top-9,x+w/2,top-18,52)
    elseif (i+zone)%3==1 then
      line(x+4,top,x+10,top-11,51)
      line(x+w-4,top,x+w-10,top-11,51)
      line(x+10,top-11,x+w-10,top-11,53)
    end
    for wy=top+13,278,13 do
      for wx=x+7,x+w-6,9 do
        local lit=(i+flr(wy/13)+flr(wx/9)+zone)%5
        if lit<2 then
          rectfill(wx,wy,wx+2,wy+3,lit==0 and 31 or accent)
          pset(wx,wy,63)
        else pset(wx,wy,49) end
      end
    end
  end

  -- Zone landmarks establish distinct locations rather than repeated towers.
  if zone==1 then
    rectfill(21,165,35,278,49) rect(24,168,32,278,52)
    rectfill(24,144,32,165,52) line(22,144,34,144,57)
    draw_cloud_mass(13,137,31,50,52)
    rectfill(139,181,176,278,49) rect(143,185,172,278,51)
    circ(157,200,10,55) line(147,200,167,200,53)
  elseif zone==2 then
    rectfill(8,163,56,SH,49) rect(13,168,51,SH,51)
    circ(32,193,16,55) circ(32,193,11,52)
    line(32,177,32,209,53) line(16,193,48,193,53)
    rectfill(133,148,181,SH,49) rect(138,153,176,SH,51)
    for yy=165,219,14 do rectfill(145,yy,169,yy+5,31) end
  elseif zone==3 then
    rectfill(9,185,64,SH,49) rect(13,189,60,SH,51)
    rectfill(20,199,53,234,41) rect(23,202,50,231,accent)
    for yy=207,227,7 do line(27,yy,46,yy,63) end
    rectfill(126,169,180,SH,49) rect(131,174,175,SH,51)
    line(136,184,170,230,54) line(170,184,136,230,52)
  elseif zone==4 then
    line(5,175,187,137,52) line(5,180,187,142,54)
    for x=14,182,42 do line(x,170,x,247,52) pset(x,167,36) end
    rectfill(115,180,174,SH,49) rect(120,185,169,SH,51)
  elseif zone==5 then
    rectfill(34,150,158,SH,49) rect(39,155,153,SH,51)
    rectfill(57,168,135,219,50) rect(62,173,130,214,35)
    line(41,157,151,239,53) line(151,157,41,239,53)
    for x=49,143,13 do pset(x,161,(x+frame_now)%8<4 and 36 or 31) end
    print("MUTAGEN",96,188,31,"center")
  elseif zone==6 then
    rectfill(96,157,181,SH,49) rect(101,162,176,SH,51)
    rectfill(111,174,164,221,50) rect(115,178,160,217,35)
    print("BZZ-CO",138,195,31,"center")
    line(104,159,138,136,55) line(172,159,138,136,55)
    circfill(138,134,3,36)
  end

  -- Near silhouette is sparse and asymmetric, separating it from the play layer.
  for i=0,4 do
    local x=(i*57-flr(camera_x*0.34))%(SW+92)-46
    local y=252+(i*19+zone*7)%34+flr((camera_y-208)/28)
    rectfill(x,y,x+35,SH,48)
    line(x-5,y+8,x+40,y+8,52)
    line(x+8,y,x+8,y-15,51)
    line(x+27,y,x+27,y-9,51)
    for wy=y+16,SH-8,14 do
      rectfill(x+9,wy,x+11,wy+2,(wy+i)%3==0 and 31 or 13)
      rectfill(x+24,wy,x+26,wy+2,13)
    end
  end
end

local function draw_secret(s,index)
  if not s.alive then return end
  local pulse=2+flr((sin(t()*1.4+index/6)+1)*0.5)
  fillp(0xeeee)
  circfill(s.x,s.y,8+pulse,31)
  fillp()
  rectfill(s.x-6,s.y-6,s.x+6,s.y+6,41)
  rect(s.x-7,s.y-7,s.x+7,s.y+7,63)
  aspr("gnat.fly",s.x,s.y,-index*9,false,false)
  print("BONUS",s.x-10,s.y-18,31)
end

local function draw_pickup(p,index)
  if not p.alive then return end
  local bob=sin(t()*0.8+index/3)*3
  local y=p.y+bob
  fillp(0xeeee)
  circfill(p.x,y,13,15)
  fillp()
  rectfill(p.x-8,y-8,p.x+8,y+8,41)
  rect(p.x-9,y-9,p.x+9,y+9,63)
  rect(p.x-6,y-6,p.x+6,y+6,p.kind==P_LASER and 10 or 4)
  if p.kind==P_LASER then
    circfill(p.x-3,y,2,6) circfill(p.x+3,y,2,6)
    line(p.x-5,y,p.x-9,y,10) line(p.x+5,y,p.x+9,y,10)
  else
    line(p.x-3,y+5,p.x+2,y-5,5)
    line(p.x+2,y-5,p.x+5,y+1,4)
    line(p.x+5,y+1,p.x,y+6,3)
  end
end

local function draw_bomb(b,index)
  if not b.alive then return end
  local wob=flr(sin(t()*1.3+index/4)*2)
  fillp(0x5a5a,34)
  circfill(b.x,b.y,9,35)
  fillp()
  circ(b.x,b.y,9,3)
  circfill(b.x-3,b.y-1,2,5)
  circfill(b.x+3,b.y-1,2,5)
  line(b.x-2,b.y+4,b.x+2,b.y+4,48)
  line(b.x,b.y-9,b.x+wob,b.y-14,14)
  pset(b.x+wob,b.y-15,31)
end

local function draw_gnat(cx,cy,flip,hurt)
  local flap=(frame_now%6)<3 and 1 or -1
  local dir=flip and -1 or 1
  local body=hurt and 11 or 4
  line(cx-2,cy-2,cx-9,cy-7-flap,12)
  line(cx-1,cy,cx-10,cy+5+flap,10)
  line(cx+2,cy-2,cx+8,cy-7-flap,12)
  line(cx+2,cy,cx+9,cy+5+flap,10)
  circfill(cx,cy,4,1)
  rectfill(cx-3,cy-2,cx+4,cy+2,body)
  rectfill(cx+dir*4,cy-1,cx+dir*7,cy+1,38)
  circfill(cx-dir*3,cy-1,2,35)
  pset(cx-dir*4,cy-2,11)
  line(cx-2,cy+3,cx-6,cy+6,13)
  line(cx+2,cy+3,cx+6,cy+6,13)
end

local function draw_beetle(cx,feet,flip,hurt)
  local dir=flip and -1 or 1
  local shell=hurt and 11 or 7
  for lx=-7,7,7 do
    line(cx+lx,feet-7,cx+lx-dir*4,feet,13)
    line(cx+lx,feet-5,cx+lx+dir*5,feet-1,13)
  end
  circfill(cx,feet-9,9,1)
  circfill(cx,feet-10,8,shell)
  line(cx,feet-17,cx,feet-3,9)
  line(cx-6,feet-14,cx+5,feet-7,6)
  circfill(cx+dir*8,feet-10,4,1)
  circfill(cx+dir*9,feet-11,2,35)
  pset(cx+dir*10,feet-12,11)
  line(cx+dir*9,feet-14,cx+dir*13,feet-18,13)
  line(cx+dir*8,feet-14,cx+dir*9,feet-19,13)
end

local function draw_wasp(cx,cy,flip,hurt)
  local dir=flip and -1 or 1
  local flap=(frame_now%8)<4 and -5 or -2
  line(cx-3,cy-3,cx-10,cy+flap,12)
  line(cx+2,cy-3,cx+9,cy+flap-1,10)
  line(cx-4,cy+4,cx-9,cy+9,13)
  line(cx+2,cy+4,cx+8,cy+9,13)
  rectfill(cx-7,cy-3,cx+6,cy+3,1)
  rectfill(cx-5,cy-2,cx-2,cy+2,hurt and 11 or 5)
  rectfill(cx,cy-2,cx+3,cy+2,35)
  rectfill(cx+5,cy-1,cx+8,cy+1,5)
  circfill(cx-dir*7,cy-1,4,1)
  circfill(cx-dir*8,cy-2,2,35)
  pset(cx-dir*9,cy-3,11)
  line(cx+dir*8,cy,cx+dir*14,cy,31)
end

local function draw_buzzkill(e,hurt)
  local cx,feet=e.x+12,e.y+38
  local wing=flr((sin(t()*4)+1)*3)
  local phase=e.phase_id or 1
  local suit=phase==3 and 35 or hurt and 36 or 52
  -- Four luminous wings make the executive mosquito readable at gameplay scale.
  fillp(0xaaaa,55)
  circfill(cx-22,feet-32,13+wing,59)
  circfill(cx+22,feet-32,13+wing,59)
  circfill(cx-20,feet-15,11+wing,55)
  circfill(cx+20,feet-15,11+wing,55)
  fillp()
  line(cx-8,feet-29,cx-34,feet-43,63)
  line(cx+8,feet-29,cx+34,feet-43,63)
  line(cx-8,feet-20,cx-31,feet-8,59)
  line(cx+8,feet-20,cx+31,feet-8,59)
  line(cx-31,feet-42,cx-12,feet-26,10)
  line(cx+31,feet-42,cx+12,feet-26,10)
  -- One closed command-pod silhouette separates the rig from wings and scenery.
  circfill(cx,feet-25,25,48)
  rectfill(cx-25,feet-25,cx+25,feet-5,48)
  circfill(cx,feet-7,25,48)
  circ(cx,feet-25,25,59)
  line(cx-21,feet-39,cx-24,feet-18,10)
  line(cx-24,feet-18,cx-18,feet-4,10)
  line(cx+22,feet-37,cx+24,feet-12,50)
  line(cx-22,feet-10,cx+22,feet-10,55)
  -- Command-chair backpack and bright hazard rails.
  rectfill(cx-20,feet-35,cx+20,feet-6,48)
  rect(cx-21,feet-36,cx+21,feet-5,59)
  rectfill(cx-17,feet-33,cx+17,feet-8,suit)
  rect(cx-14,feet-30,cx+14,feet-10,13)
  rectfill(cx-25,feet-31,cx-18,feet-9,50)
  rectfill(cx+18,feet-31,cx+25,feet-9,50)
  line(cx-23,feet-28,cx-23,feet-12,59)
  line(cx+23,feet-28,cx+23,feet-12,59)
  for yy=feet-27,feet-12,5 do
    circfill(cx-23,yy,1,phase==3 and 36 or 31)
    circfill(cx+23,yy,1,phase==2 and 4 or 10)
  end
  -- Readable arms: one claw, one absurd compliance cannon.
  line(cx-12,feet-24,cx-30,feet-18,48)
  line(cx-30,feet-18,cx-34,feet-9,59)
  line(cx-34,feet-9,cx-39,feet-13,36)
  line(cx-34,feet-9,cx-29,feet-12,36)
  line(cx+12,feet-23,cx+27,feet-17,48)
  rectfill(cx+24,feet-22,cx+39,feet-13,48)
  rect(cx+24,feet-22,cx+39,feet-13,59)
  line(cx+39,feet-18,cx+45,feet-18,phase==3 and 36 or 31)
  -- Armored head, compound eyes, proboscis and ridiculous necktie.
  circfill(cx,feet-38,13,48)
  circfill(cx,feet-38,11,hurt and 36 or 35)
  line(cx-9,feet-43,cx-6,feet-48,38)
  line(cx-9,feet-43,cx-10,feet-35,38)
  line(cx+9,feet-43,cx+10,feet-34,33)
  circfill(cx-6,feet-40,5,48) circfill(cx+6,feet-40,5,48)
  circfill(cx-6,feet-40,3,phase==3 and 4 or 36)
  circfill(cx+6,feet-40,3,phase==3 and 4 or 36)
  pset(cx-7,feet-41,63) pset(cx+5,feet-41,63)
  local nose=e.dir>0 and 1 or -1
  line(cx+nose*2,feet-35,cx+nose*23,feet-27,46)
  line(cx+nose*2,feet-34,cx+nose*23,feet-26,47)
  line(cx+nose*23,feet-27,cx+nose*28,feet-28,31)
  rectfill(cx-8,feet-26,cx+8,feet-8,48)
  line(cx-6,feet-24,cx+6,feet-24,63)
  rectfill(cx-3,feet-23,cx+3,feet-15,36)
  line(cx-3,feet-14,cx,feet-9,36) line(cx+3,feet-14,cx,feet-9,36)
  line(cx-7,feet-8,cx-13,feet,48) line(cx+7,feet-8,cx+13,feet,48)
  rectfill(cx-15,feet-2,cx-5,feet,13) rectfill(cx+5,feet-2,cx+15,feet,13)
  if phase>=2 then
    line(cx-15,feet-29,cx-7,feet-20,31)
    line(cx+15,feet-20,cx+7,feet-11,31)
  end
  if phase==3 then
    for i=0,5 do
      local sx=cx-21+i*9
      line(sx,feet-47-(i%2)*3,sx+2,feet-51-(i%2)*3,i%2==0 and 36 or 4)
    end
  end
end

local function draw_enemy(e,index)
  if not e.alive then return end
  if e.kind==E_BOSS and e.dormant then return end
  local hurt=e.hurt>0 and e.hurt%2==0
  if e.kind==E_GNAT then
    draw_gnat(e.x+8,e.y+8,e.dir>0,hurt)
  elseif e.kind==E_BEETLE then
    draw_beetle(e.x+8,e.y+15,e.dir<0,hurt)
  elseif e.kind==E_WASP then
    draw_wasp(e.x+8,e.y+8,e.x<player_x,hurt)
  else
    local phase_color=e.phase_id==1 and 10 or e.phase_id==2 and 4 or 36
    fillp(0xaaaa)
    circfill(e.x+12,e.y+10,31+flr((sin(t()*0.7)+1)*2),
      e.vulnerable and phase_color or 35)
    fillp()
    draw_buzzkill(e,hurt)
    if not boss_defeated and not e.vulnerable then
      circ(e.x+12,e.y+10,34,10)
      circ(e.x+12,e.y+10,31,59)
      for a=0,7 do
        local aa=a/8+frame_now/180
        pset(e.x+12+cos(aa)*36,e.y+10+sin(aa)*36,a%2==0 and 31 or 10)
      end
    end
    if e.vulnerable and frame_now%6<4 then
      line(e.x-13,e.y-13,e.x+37,e.y-13,63)
      print("AUDIT ME!",e.x+12,e.y-22,31,"center")
    end
    if boss_defeated then
      line(e.x-20,e.y-17,e.x+44,e.y+43,36)
      line(e.x+44,e.y-17,e.x-20,e.y+43,36)
      if boss_death_timer>0 then
        -- Three persistent, separated blast nodes make the destruction beat unmistakable.
        local bx={e.x-1,e.x+25,e.x+10}
        local by={e.y+2,e.y+14,e.y+29}
        for blast=1,3 do
          local r=4+(frame_now+blast*2)%3
          circ(bx[blast],by[blast],r+3,38)
          circ(bx[blast],by[blast],r+1,31)
          circfill(bx[blast],by[blast],2,63)
          for ray=0,3 do
            local a=ray/4+blast/12
            line(bx[blast]+cos(a)*r,by[blast]+sin(a)*r,
              bx[blast]+cos(a)*(r+6),by[blast]+sin(a)*(r+6),
              ray%2==0 and 31 or 36)
          end
        end
      end
    end
  end
  if (e.telegraph or 0)>0 and not boss_defeated then
    local pulse=frame_now%6<3 and 31 or 4
    circ(e.x+e.w/2,e.y-5,4,pulse)
    print("!",e.x+e.w/2-1,e.y-8,pulse)
  end
end

local function draw_particles_world()
  for i=1,#particles do
    local p=particles[i]
    if p.kind==5 then
      line(p.x-p.dx*2,p.y-p.dy*2,p.x,p.y,p.color)
      if p.size>1 then circfill(p.x,p.y,p.size,p.color) else pset(p.x,p.y,p.color) end
    elseif p.kind==4 then
      line(p.x-p.dx*2,p.y-p.dy*2,p.x,p.y,p.color)
      pset(p.x,p.y,11)
    elseif p.kind==3 then
      local swell=p.size+flr((p.max-p.life)/7)
      fillp(0xaaaa,49)
      circfill(p.x,p.y,swell+2,50)
      fillp()
      circfill(p.x-1,p.y-1,max(1,swell),p.color)
      pset(p.x-2,p.y-2,56)
    elseif p.kind==2 then
      line(p.x-p.dx*3,p.y-p.dy*3,p.x,p.y,p.color)
      if p.size>1 then rectfill(p.x-1,p.y-1,p.x+1,p.y+1,p.color) end
    elseif p.size>1 then circfill(p.x,p.y,p.size,p.color)
    else pset(p.x,p.y,p.color) end
  end
  for i=1,#explosions do
    local e=explosions[i]
    local age=e.max-e.life
    local scale=max(1,e.power)
    if age<=2 then
      local r=5+age*4
      circfill(e.x,e.y,4+age*2,63)
      for ray=0,7 do
        local a=ray/8
        line(e.x+cos(a)*3,e.y+sin(a)*3,
          e.x+cos(a)*r,e.y+sin(a)*r,ray%2==0 and 63 or 31)
      end
    elseif age<=6 then
      local r=7+(age-2)*scale*2
      -- A single hot core and two open fronts; no component-like orange discs.
      circ(e.x,e.y,r+4,63)
      circ(e.x,e.y,r+2,31)
      circ(e.x,e.y,max(3,r*0.42),38)
      circfill(e.x,e.y,max(2,7-age),63)
      for ray=0,7 do
        local a=ray/8+0.03
        line(e.x+cos(a)*r*0.36,e.y+sin(a)*r*0.36,
          e.x+cos(a)*r*0.78,e.y+sin(a)*r*0.78,ray%2==0 and 31 or 38)
      end
    elseif age<=12 then
      local r=12+(age-6)*scale*1.7
      -- A clear shock ring and long shards keep the burst airy and directional.
      circ(e.x,e.y,r,31)
      circ(e.x,e.y,r+3,38)
      for shard=0,9 do
        local a=shard/10+0.025
        local inner=r*0.55
        local outer=r*(0.88+(shard%3)*0.14)
        line(e.x+cos(a)*inner,e.y+sin(a)*inner,
          e.x+cos(a)*outer,e.y+sin(a)*outer,shard%2==0 and 63 or 38)
        pset(e.x+cos(a)*outer,e.y+sin(a)*outer,31)
      end
      for ember=0,4 do
        local a=ember/5+0.1
        local ex=e.x+cos(a)*r*0.48
        local ey=e.y+sin(a)*r*0.34
        local er=max(2,5-flr(age/3))
        circ(ex,ey,er,ember%2==0 and 38 or 36)
        pset(ex,ey,31)
      end
    else
      local r=15+(age-11)*scale
      local rise=(age-12)*1.5
      fillp(0xaaaa,52)
      for smoke=0,4 do
        local a=smoke/5+0.03
        local sx=e.x+cos(a)*r*0.48
        local sy=e.y+sin(a)*r*0.26-rise-(smoke%2)*3
        circfill(sx,sy,max(2,6-flr((age-12)/3)),smoke%2==0 and 50 or 52)
        circ(sx,sy,max(2,6-flr((age-12)/3)),59)
      end
      fillp()
      for ember=0,5 do
        local a=ember/6+frame_now/60
        pset(e.x+cos(a)*r*0.65,e.y-rise+sin(a)*r*0.33,
          ember%2==0 and 31 or 36)
      end
    end
  end
end

local function draw_bullets()
  for i=1,#bullets do
    local b=bullets[i]
    if b.kind==B_STINGER then
      line(b.x-b.dx*3,b.y-b.dy*3,b.x,b.y,5)
      pset(b.x,b.y,63)
    else
      fillp(0xeeee)
      circfill(b.x,b.y,5,4)
      fillp()
      circfill(b.x,b.y,3,35)
      pset(b.x,b.y,5)
    end
  end
end

local function draw_tongue()
  if tongue_state=="idle" then return end
  local mx,my=player_mouth()
  local tx,ty=tongue_x,tongue_y
  local dx,dy=tx-mx,ty-my
  local d=max(1,math.sqrt(dx*dx+dy*dy))
  local nx,ny=-dy/d,dx/d
  local segments=max(2,flr(d/7))
  local lastx,lasty=mx,my
  for i=1,segments do
    local f=i/segments
    local wob=sin(f*3+t()*2.2)*(1-f)*2
    local x=mx+dx*f+nx*wob
    local y=my+dy*f+ny*wob
    line(lastx,lasty,x,y,i%3==0 and 47 or 46)
    lastx,lasty=x,y
  end
  circfill(tx,ty,2,46)
  pset(tx,ty,63)
  if tongue_state=="latched" then circ(tx,ty,4,5) end
end

local function draw_grapple_hint()
  if tongue_state~="idle" or respawn_timer>0 or paused then return end
  if not btn(2) and not btn(3) then return end
  local x,y=grapple_point()
  if not x then return end
  local mx,my=player_mouth()
  for i=1,5 do
    local f=i/6
    pset(mx+(x-mx)*f,my+(y-my)*f,i%2==0 and 10 or 7)
  end
  circ(x,y,4,10)
  pset(x,y,63)
end

local function draw_frog_pose(cx,feet,pose,left,hero_scale)
  local scale=hero_scale or 1
  local dir=left and -1 or 1
  if pose=="recoil" then cx=cx-dir*2*scale end
  if pose=="air" then feet=feet-1*scale end
  local bob=pose=="idle" and flr((sin(t()*0.9)+1)*0.5) or 0
  local head_y=feet-17*scale+bob
  local body_y=feet-8*scale+bob
  local function rx(dx) return cx+dir*dx*scale end
  if pose=="hurt" then
    rectfill(cx-11*scale,feet-10*scale,cx+11*scale,feet-2*scale,1)
    rectfill(cx-9*scale,feet-9*scale,cx+9*scale,feet-3*scale,7)
    circfill(cx-6*scale,feet-11*scale,4*scale,1)
    circfill(cx+6*scale,feet-11*scale,4*scale,1)
    line(cx-8*scale,feet-13*scale,cx-4*scale,feet-9*scale,11)
    line(cx-4*scale,feet-13*scale,cx-8*scale,feet-9*scale,11)
    line(cx+4*scale,feet-13*scale,cx+8*scale,feet-9*scale,11)
    line(cx+8*scale,feet-13*scale,cx+4*scale,feet-9*scale,11)
    line(cx-10*scale,feet,cx-4*scale,feet,13)
    line(cx+4*scale,feet,cx+10*scale,feet,13)
    return
  end

  -- Pose-specific limbs first, then a chunky outlined body and expressive head.
  if pose=="victory" then
    line(rx(-5),feet-10*scale,rx(-13),feet-21*scale,1)
    line(rx(-13),feet-21*scale,rx(-10),feet-27*scale,7)
    line(rx(5),feet-10*scale,rx(13),feet-21*scale,1)
    line(rx(13),feet-21*scale,rx(10),feet-27*scale,7)
    line(rx(-5),feet-10*scale,rx(-13),feet-21*scale,6)
    line(rx(5),feet-10*scale,rx(13),feet-21*scale,6)
    circfill(rx(-10),feet-27*scale,2*scale,1)
    circfill(rx(10),feet-27*scale,2*scale,1)
    circfill(rx(-10),feet-27*scale,scale,6)
    circfill(rx(10),feet-27*scale,scale,6)
    line(cx-5*scale,feet-5*scale,cx-12*scale,feet,1)
    line(cx+5*scale,feet-5*scale,cx+12*scale,feet,1)
    rectfill(cx-15*scale,feet-2*scale,cx-7*scale,feet,7)
    rectfill(cx+7*scale,feet-2*scale,cx+15*scale,feet,7)
  elseif pose=="recoil" then
    line(rx(-4),feet-8*scale,rx(-13),feet-13*scale,1)
    line(rx(-13),feet-13*scale,rx(-16),feet-8*scale,7)
    line(rx(4),feet-7*scale,rx(10),feet-1*scale,1)
    line(rx(10),feet-1*scale,rx(16),feet,7)
    line(rx(-5),feet-4*scale,rx(-13),feet,1)
    line(rx(5),feet-4*scale,rx(14),feet+1*scale,1)
  elseif pose=="mutate" then
    line(rx(-5),feet-9*scale,rx(-11),feet-15*scale,1)
    line(rx(-11),feet-15*scale,rx(-15),feet-10*scale,7)
    line(rx(5),feet-9*scale,rx(10),feet-15*scale,1)
    line(rx(10),feet-15*scale,rx(15),feet-11*scale,7)
    line(cx-5*scale,feet-4*scale,cx-11*scale,feet,1)
    line(cx+5*scale,feet-4*scale,cx+11*scale,feet,1)
  elseif pose=="swing" then
    line(rx(-5),feet-8*scale,rx(-10),feet-17*scale,1)
    line(rx(-10),feet-17*scale,rx(-7),feet-21*scale,7)
    line(rx(5),feet-7*scale,rx(10),feet-14*scale,1)
    line(rx(10),feet-14*scale,rx(8),feet-19*scale,6)
    line(rx(-4),feet-4*scale,rx(-10),feet-1*scale,1)
    line(rx(4),feet-3*scale,rx(9),feet+2*scale,1)
  elseif pose=="air" then
    line(rx(-5),feet-7*scale,rx(-10),feet-2*scale,1)
    line(rx(-10),feet-2*scale,rx(-7),feet+2*scale,7)
    line(rx(5),feet-6*scale,rx(11),feet-1*scale,1)
    line(rx(11),feet-1*scale,rx(8),feet+2*scale,7)
    line(rx(-5),feet-12*scale,rx(-10),feet-8*scale,6)
    line(rx(5),feet-12*scale,rx(10),feet-9*scale,6)
  elseif pose=="run" then
    local step=frame_now%12<6 and 1 or -1
    line(cx-4*scale,feet-5*scale,cx-9*scale*step,feet,1)
    line(cx+4*scale,feet-5*scale,cx+9*scale*step,feet,1)
    line(cx-10*scale*step,feet,cx-4*scale*step,feet,13)
    line(cx+3*scale*step,feet,cx+10*scale*step,feet,13)
  else
    rectfill(cx-11*scale,feet-3*scale,cx-3*scale,feet,1)
    rectfill(cx+3*scale,feet-3*scale,cx+11*scale,feet,1)
    rectfill(cx-9*scale,feet-2*scale,cx-3*scale,feet-1*scale,7)
    rectfill(cx+3*scale,feet-2*scale,cx+9*scale,feet-1*scale,7)
  end

  circfill(cx,body_y,9*scale,1)
  circfill(cx,body_y-1*scale,7*scale,7)
  rectfill(cx-6*scale,body_y-3*scale,cx+6*scale,body_y+2*scale,6)
  circfill(cx,body_y+2*scale,5*scale,6)
  -- Consistent moon-side rim and belly shadow give every pose a two-tone volume.
  line(cx-7*scale,body_y-4*scale,cx-5*scale,body_y+3*scale,10)
  line(cx-5*scale,body_y-5*scale,cx+2*scale,body_y-6*scale,6)
  rectfill(cx+4*scale,body_y-1*scale,cx+6*scale,body_y+3*scale,7)
  line(cx-4*scale,body_y+4*scale,cx+4*scale,body_y+4*scale,7)
  pset(cx-4*scale,body_y,14) pset(cx+3*scale,body_y+2*scale,14)
  line(cx-3*scale,body_y+4*scale,cx+3*scale,body_y+4*scale,14)

  rectfill(cx-9*scale,head_y-3*scale,cx+9*scale,head_y+5*scale,1)
  circfill(cx,head_y+1*scale,9*scale,7)
  rectfill(cx-7*scale,head_y,cx+7*scale,head_y+5*scale,6)
  line(cx-8*scale,head_y-1*scale,cx-7*scale,head_y+4*scale,10)
  line(cx-6*scale,head_y-1*scale,cx+2*scale,head_y-2*scale,6)
  rectfill(cx+5*scale,head_y+1*scale,cx+7*scale,head_y+4*scale,7)
  line(cx-5*scale,head_y+5*scale,cx+6*scale,head_y+5*scale,7)
  pset(cx-5*scale,head_y+1*scale,14)
  -- Brow and eyes are oversized so the face survives phone scale.
  circfill(cx-6*scale,head_y-5*scale,5*scale,1)
  circfill(cx+6*scale,head_y-5*scale,5*scale,1)
  local laser=mutation=="LASER EYES"
  circfill(cx-6*scale,head_y-5*scale,(laser and 4 or 3)*scale,laser and 10 or 11)
  circfill(cx+6*scale,head_y-5*scale,(laser and 4 or 3)*scale,laser and 10 or 11)
  line(cx-8*scale,head_y-3*scale,cx-4*scale,head_y-3*scale,59)
  line(cx+4*scale,head_y-3*scale,cx+8*scale,head_y-3*scale,59)
  local pupil_y=head_y-5*scale
  if pose=="air" or pose=="swing" then pupil_y=pupil_y+scale end
  if pose=="victory" then pupil_y=pupil_y-scale end
  pset(cx-6*scale+dir*scale,pupil_y,laser and 63 or 48)
  pset(cx+6*scale+dir*scale,pupil_y,laser and 63 or 48)
  if pose=="recoil" then
    line(cx-10*scale,head_y-10*scale,cx-4*scale,head_y-8*scale,31)
    line(cx+10*scale,head_y-10*scale,cx+4*scale,head_y-8*scale,31)
  elseif pose=="victory" then
    pset(cx-7*scale,head_y-7*scale,63) pset(cx+5*scale,head_y-7*scale,63)
  end
  if laser and laser_timer>0 then
    circ(cx-6*scale,head_y-5*scale,6*scale,63)
    circ(cx+6*scale,head_y-5*scale,6*scale,63)
    line(cx-10*scale,head_y-10*scale,cx-6*scale,head_y-8*scale,31)
    line(cx+10*scale,head_y-10*scale,cx+6*scale,head_y-8*scale,31)
  end
  local open=tongue_state~="idle" or fire_timer>0
  if open then
    local mouth0,mouth1=rx(1),rx(8)
    rectfill(min(mouth0,mouth1),head_y+3*scale,max(mouth0,mouth1),head_y+7*scale,1)
    local inner0,inner1=rx(3),rx(8)
    rectfill(min(inner0,inner1),head_y+4*scale,max(inner0,inner1),head_y+6*scale,
      fire_timer>0 and 5 or 15)
  else
    if pose=="victory" then
      line(rx(-5),head_y+3*scale,rx(5),head_y+5*scale,1)
      line(rx(-4),head_y+4*scale,rx(4),head_y+5*scale,63)
    else
      line(rx(-2),head_y+4*scale,rx(6),head_y+4*scale,1)
      pset(rx(7),head_y+3*scale,14)
    end
  end
  if mutation=="FIRE BREATH" then
    local throat=fire_timer>0 and 7*scale or 4*scale
    circfill(cx+dir*2*scale,body_y-1*scale,throat+scale,1)
    circfill(cx+dir*2*scale,body_y-1*scale,throat,5)
    circ(cx+dir*2*scale,body_y-1*scale,max(scale,throat-2*scale),4)
  end
  pset(cx-dir*7*scale,head_y+1*scale,14)
end

local function draw_fire_fx()
  if fire_timer<=0 then return end
  local mx,my=player_mouth()
  local nx,ny=-fire_aim_y,fire_aim_x
  local pulse=frame_now%3
  -- Smoke and embers trail behind the hot tapered flame body.
  for step=6,8 do
    local d=step*7
    local cx=mx+fire_aim_x*d
    local cy=my+fire_aim_y*d
    local drift=(step-5)*2+pulse
    fillp(0xaaaa,36)
    circfill(cx-fire_aim_x*drift+nx*((step+frame_now)%3-1)*3,
      cy-fire_aim_y*drift-2*(step-5),max(1,9-step),36)
    fillp()
    pset(cx+nx*(step%2==0 and 5 or -5),cy,38)
  end
  for step=1,6 do
    local d=step*7
    local width=max(1,flr((7-step)*0.68)+pulse%2)
    local cx=mx+fire_aim_x*d
    local cy=my+fire_aim_y*d
    circfill(cx,cy,width,step<3 and 31 or step<5 and 38 or 36)
    line(cx-nx*width,cy-ny*width,cx+nx*width,cy+ny*width,
      step<4 and 63 or step<6 and 31 or 38)
    circfill(cx,cy,max(1,width-2),step<4 and 63 or 31)
    if step%2==0 then
      line(cx+nx*(width+1),cy+ny*(width+1),
        cx+nx*(width+4),cy+ny*(width+4),31)
    end
  end
end

local function draw_laser_fx()
  if laser_timer<=0 then return end
  local cx=player_x+7
  local ey=player_y-7
  local ex0,ex1=cx-6,cx+6
  local pulse=laser_timer%3
  -- Cyan aura, white core, and a broken fringe read as energy instead of a flat bar.
  line(ex0,ey-2,laser_x2,laser_y2-2,10)
  line(ex1,ey+2,laser_x2,laser_y2+2,10)
  line(ex0,ey+2,laser_x2,laser_y2+2,7)
  line(ex1,ey-2,laser_x2,laser_y2-2,7)
  line(ex0,ey,laser_x2,laser_y2,63)
  line(ex1,ey,laser_x2,laser_y2,63)
  if frame_now%4<2 then
    line(ex0,ey+1,laser_x2,laser_y2+1,31)
    line(ex1,ey-1,laser_x2,laser_y2-1,31)
  end
  circ(ex0,ey,5+pulse,10) circ(ex1,ey,5+pulse,10)
  circfill(ex0,ey,2,63) circfill(ex1,ey,2,63)
  for i=1,8 do
    local a=i/8+frame_now/17
    local r=4+i
    line(laser_x2,laser_y2,
      laser_x2+cos(a)*r,laser_y2+sin(a)*r,i%2==0 and 31 or 10)
  end
  circ(laser_x2,laser_y2,7+pulse,10)
  circfill(laser_x2,laser_y2,3+pulse,63)
end

local function draw_player()
  local flicker=invuln>0 and invuln%6<3
  if flicker then
    for ink=1,15 do pal(ink,ink%2==0 and 63 or 14) end
  end
  local pose="idle"
  if hurt_timer>0 or respawn_timer>0 then pose="hurt"
  elseif laser_timer>0 then pose="recoil"
  elseif fire_timer>0 then pose="mutate"
  elseif tongue_state=="latched" then pose="swing"
  elseif not grounded then pose="air"
  elseif abs(vx)>0.22 then pose="run" end
  if tongue_state=="latched" and abs(vx)+abs(vy)>1.2 then
    for i=1,3 do
      line(player_x+7-vx*i*2,player_y+8-vy*i*2,
        player_x+7-vx*(i+1)*3,player_y+8-vy*(i+1)*3,i==1 and 10 or 8)
    end
  end
  draw_frog_pose(player_x+7,player_y+15,pose,face_left)
  if flicker then for ink=0,15 do pal(ink,INK_MAP[ink+1]) end end
end

local function draw_exit()
  if not exit_open then return end
  local x,y=level.exit.x,level.exit.y
  local pulse=18+flr((sin(t()*0.9)+1)*3)
  fillp(0xeeee)
  circfill(x,y,pulse,10)
  fillp()
  circfill(x,y,14,11)
  circ(x,y,14,63)
  line(x-15,y+13,x+15,y+13,7)
  line(x-10,y+14,x-17,y+21,6)
  line(x+10,y+14,x+17,y+21,6)
  print("EVAC",x-9,y-3,48)
end

local function draw_boss_gate()
  if not boss_started or exit_open then return end
  local gate=level.boss_gate
  local pulse=frame_now%6<3 and 10 or 7
  fillp(0xaaaa)
  rectfill(gate.x-2,gate.y,gate.x+2,gate.y+gate.h,pulse)
  fillp()
  line(gate.x,gate.y,gate.x,gate.y+gate.h,63)
  for y=gate.y+4,gate.y+gate.h-4,8 do
    pset(gate.x-1+flr(y/8)%3,y,31)
  end
end

local function draw_light_pool(x,y,accent)
  fillp(0xaaaa,accent)
  line(x-3,y+3,x+3,y+3,accent)
  line(x-7,y+10,x+7,y+10,accent)
  line(x-12,y+19,x+12,y+19,accent)
  line(x-3,y+1,x-12,y+19,accent)
  line(x+3,y+1,x+12,y+19,accent)
  fillp()
  rectfill(x-3,y-4,x+3,y,48)
  line(x-2,y-3,x+2,y-3,63)
  pset(x,y-2,31)
end

local function draw_rooftop_room(x,y,w,label,accent)
  rectfill(x,y-42,x+w,y,49)
  rect(x-1,y-43,x+w+1,y+1,59)
  rect(x+3,y-38,x+w-3,y-4,52)
  line(x+4,y-37,x+w-4,y-37,55)
  local panes=max(1,flr((w-8)/12))
  for i=0,panes-1 do
    local wx=x+6+i*12
    rectfill(wx,y-30,wx+7,y-15,41)
    rect(wx,y-30,wx+7,y-15,accent)
    rectfill(wx+2,y-28,wx+5,y-17,(i+frame_now/30)%4<3 and 31 or accent)
    line(wx+4,y-29,wx+4,y-16,63)
  end
  rectfill(x+4,y-11,x+w-4,y-5,48)
  print(label,x+w/2,y-10,63,"center")
  for bx=x+3,x+w-3,w-6 do pset(bx,y-2,31) end
end

local function draw_pipe_cluster(x,y)
  for i=0,2 do
    local px=x+i*9
    local h=24+i*8
    rectfill(px,y-h,px+5,y,50)
    line(px,y-h,px,y,59) line(px+5,y-h,px+5,y,52)
    line(px+2,y-h,px+2,y-h-7,55)
    circ(px+2,y-h-8,4,59)
    if (frame_now+i*13)%70<18 then
      fillp(0xaaaa,59)
      circfill(px+2,y-h-13-(frame_now%9),3+i,59)
      fillp()
    end
  end
  rectfill(x-4,y-6,x+27,y,48)
  rect(x-4,y-6,x+27,y,55)
end

local function draw_water_tower(x,y)
  line(x-16,y,x-10,y-48,52) line(x+16,y,x+10,y-48,52)
  line(x-15,y-18,x+15,y-18,54)
  line(x-14,y-4,x+12,y-34,52) line(x+14,y-4,x-12,y-34,52)
  rectfill(x-16,y-61,x+16,y-43,49)
  circfill(x,y-61,16,50)
  rect(x-15,y-61,x+15,y-43,59)
  circ(x,y-61,15,59)
  line(x-12,y-53,x+12,y-53,13)
  print("H2O?",x,y-57,31,"center")
end

local function draw_neon_billboard(x,y,label,accent)
  line(x-24,y,x-19,y-32,52) line(x+24,y,x+19,y-32,52)
  rectfill(x-28,y-60,x+28,y-28,48)
  rect(x-29,y-61,x+29,y-27,59)
  rect(x-25,y-57,x+25,y-31,accent)
  fillp(0xaaaa,accent) rectfill(x-23,y-55,x+23,y-33,accent) fillp()
  print(label,x,y-49,63,"center")
  print("A BETTER BUG",x,y-39,31,"center")
  for bx=x-25,x+25,10 do pset(bx,y-59,(bx+frame_now)%12<7 and 31 or 36) end
end

local function draw_fenced_machine(x,y,accent)
  rectfill(x-25,y-38,x+25,y,49)
  rect(x-26,y-39,x+26,y+1,59)
  circfill(x,y-20,13,50) circ(x,y-20,13,accent)
  circ(x,y-20,8,55)
  line(x,y-32,x,y-8,13) line(x-12,y-20,x+12,y-20,13)
  for a=0,3 do
    local ax=x+cos(a/4)*8 local ay=y-20+sin(a/4)*8
    line(x,y-20,ax,ay,54)
  end
  rectfill(x-20,y-7,x+20,y-3,52)
  for px=x-22,x+22,11 do
    line(px,y,px,y-44,55)
    line(px,y-40,px+11,y-5,52)
  end
  line(x-24,y-44,x+25,y-44,59)
end

local function draw_zone_architecture()
  local zone=scene_zone()
  local accent=ZONE_ACCENT[zone+1]
  -- Floating routes alternate between suspended catwalks, façades, and short trusses.
  for i=1,#level.platforms do
    local p=level.platforms[i]
    local x,y,w=p[1]*8,p[2]*8,p[3]*8
    if p[4]==1 and p[5]~=ACID and x+w>camera_x-24 and x<camera_x+SW+24 then
      local depth=mid(16,22+(i*11)%27,WORLD_H-y-1)
      if p[5]==MUD then
        line(x+4,y+7,x+1,y+depth,9)
        line(x+w-5,y+7,x+w-2,y+depth,9)
        for root=x+10,x+w-8,16 do
          line(root,y+6,root-3+(root%7),y+14+(root%13),10)
        end
      elseif p[5]==GIRDER and i%2==0 then
        rectfill(x+2,y+5,x+w-3,y+8,50)
        for bx=x+4,x+w-12,16 do
          line(bx,y+9,bx,y+depth,52)
          line(bx+12,y+9,bx+12,y+depth,52)
          line(bx,y+10,bx+12,y+depth-1,54)
          line(bx+12,y+10,bx,y+depth-1,51)
          circfill(bx,y+10,1,13) circfill(bx+12,y+10,1,13)
        end
      elseif p[5]==GIRDER then
        line(x+5,y+6,x+5,y-24,52)
        line(x+w-6,y+6,x+w-6,y-24,52)
        line(x+5,y-20,x+w-6,y-8,54)
        line(x+w-6,y-20,x+5,y-8,51)
        for cable=x+12,x+w-10,18 do line(cable,y+6,cable,y-13,53) end
      else
        rectfill(x+2,y+6,x+w-3,y+depth,50)
        rect(x+4,y+9,x+w-5,y+depth,52)
        line(x+5,y+12,x+w-6,y+12,54)
        for wx=x+8,x+w-10,12 do
          line(wx,y+13,wx,y+depth,51)
          for wy=y+18,y+depth-5,12 do
            if (wx+wy+i)%3==0 then rectfill(wx+2,wy,wx+4,wy+3,accent) end
          end
        end
      end
    end
  end
  -- Three restrained light pools guide the eye through every camera sector.
  local sector=zone*128
  draw_light_pool(sector+30,camera_y+196,zone%2==0 and 31 or accent)
  draw_light_pool(sector+92,camera_y+236,zone%2==0 and accent or 31)
  draw_light_pool(sector+154,camera_y+174,zone%3==0 and 36 or 31)

  -- One major landmark per zone, supported by smaller asymmetric machinery.
  if zone==0 then
    draw_rooftop_room(74,454,54,"LICK LAB",10)
    draw_pipe_cluster(157,472)
  elseif zone==1 then
    draw_water_tower(224,471)
    draw_fenced_machine(294,472,10)
  elseif zone==2 then
    draw_neon_billboard(354,450,"MOLT!",4)
    draw_pipe_cluster(420,472)
  elseif zone==3 then
    draw_rooftop_room(474,452,62,"GENE BAR",45)
    draw_fenced_machine(558,472,4)
  elseif zone==4 then
    draw_water_tower(623,455)
    draw_neon_billboard(691,438,"CROAK",10)
  elseif zone==5 then
    draw_fenced_machine(752,456,36)
    draw_rooftop_room(787,448,62,"HR HIVE",36)
  elseif zone==6 then
    -- The arena drops to a quiet dark proscenium so the Colonel owns the silhouette.
    rectfill(826,397,944,472,48)
    rect(830,401,940,468,50)
    line(834,405,936,405,52)
    rectfill(826,397,834,472,49) rectfill(936,397,944,472,49)
    for y=414,460,12 do
      pset(831,y,36) pset(939,y,31)
    end
    circ(884,411,12,35) circ(884,411,8,52)
    line(876,411,892,411,50) line(884,403,884,419,50)
  end
end

local function draw_prop(p)
  local kind,x,y,w=p[1],p[2],p[3],p[4]
  if kind=="pipe" then
    rectfill(x,y-4,x+w,y+3,50)
    line(x,y-4,x+w,y-4,59) line(x,y+3,x+w,y+3,52)
    rectfill(x-3,y-28,x+5,y+2,50)
    line(x-3,y-28,x-3,y+1,59) line(x+5,y-28,x+5,y+1,52)
    circ(x+1,y-28,6,55) circ(x+1,y-28,3,13)
    for px=x+12,x+w-4,20 do
      rectfill(px,y-5,px+3,y+4,52)
      line(px+1,y-3,px+1,y+2,13)
    end
  elseif kind=="fence" then
    rectfill(x,y-31,x+w,y-28,50)
    line(x,y-31,x+w,y-31,59) line(x,y,x+w,y,52)
    for px=x,x+w,12 do
      rectfill(px,y-31,px+2,y,50)
      line(px+2,y-28,px+12,y-2,53)
      line(px+12,y-28,px+2,y-2,52)
      circfill(px+1,y-31,1,13)
    end
  elseif kind=="sign" then
    rectfill(x-13,y-29,x+13,y+1,49)
    rect(x-14,y-30,x+14,y+2,59)
    rect(x-11,y-27,x+11,y-4,52)
    rectfill(x-9,y-25,x+9,y-6,p[4]==1 and 35 or 41)
    line(x-9,y-25,x+9,y-25,p[4]==1 and 36 or 45)
    if p[4]==1 then
      line(x-6,y-21,x+6,y-9,4) line(x+6,y-21,x-6,y-9,4)
      pset(x,y-15,63)
    else
      circfill(x,y-16,6,7)
      circfill(x-3,y-18,2,11) circfill(x+3,y-18,2,11)
      pset(x-3,y-18,48) pset(x+3,y-18,48)
      line(x-5,y-11,x+5,y-11,14)
    end
    line(x-9,y+2,x-5,y+8,52) line(x+9,y+2,x+5,y+8,52)
  elseif kind=="vent" then
    rectfill(x-16,y-23,x+16,y+1,49)
    rect(x-17,y-24,x+17,y+2,59)
    rect(x-13,y-20,x+13,y-3,52)
    circfill(x,y-12,9,50) circ(x,y-12,9,55)
    line(x,y-21,x,y-3,13) line(x-9,y-12,x+9,y-12,13)
    line(x-6,y-18,x+6,y-6,52) line(x+6,y-18,x-6,y-6,52)
    for bolt=-13,13,26 do pset(x+bolt,y-21,31) pset(x+bolt,y-2,31) end
  elseif kind=="tank" then
    rectfill(x-15,y-30,x+15,y,49)
    circfill(x,y-30,15,49)
    rect(x-14,y-29,x+14,y,55)
    circ(x,y-30,14,59)
    line(x-11,y-23,x+11,y-23,13)
    line(x-12,y-12,x+12,y-12,52)
    line(x-9,y-35,x+9,y-35,56)
    line(x,y-45,x,y-55,52)
    pset(x,y-56,36)
    line(x-10,y,x-14,y+8,52) line(x+10,y,x+14,y+8,52)
  end
end

local function draw_terrain_detail()
  local zone=scene_zone()
  local x0=max(0,flr(camera_x/8)-1)
  local x1=min(119,flr((camera_x+SW)/8)+1)
  local y0=max(0,flr(camera_y/8)-1)
  local y1=min(63,flr((camera_y+SH-HUD_H)/8)+1)
  for cy=y0,y1 do
    for cx=x0,x1 do
      local tile=mget(cx,cy)
      local x,y=cx*8,cy*8
      if solid(tile) then
        if not solid(mget(cx,cy-1)) then
          local cap=tile==MUD and 14 or tile==BREAKABLE and 4 or 59
          line(x,y,x+7,y,cap)
          line(x,y+1,x+7,y+1,tile==MUD and 11 or 55)
          line(x+1,y+2,x+6,y+2,tile==MUD and 9 or 52)
          pset(x+1,y,63) pset(x+6,y+1,13)
          if zone==1 and cx%4==0 then
            line(x+2,y-2,x+5,y-2,31)
          elseif zone==2 and cx%3==0 then
            pset(x+3,y-1,45) pset(x+4,y-1,45)
          elseif zone==3 and cx%4==1 then
            line(x+2,y-1,x+5,y-1,10)
          elseif zone==4 and cx%3==0 then
            line(x+1,y-2,x+3,y,36) line(x+4,y,x+6,y-2,31)
          elseif zone>=5 and cx%4==2 then
            rectfill(x+2,y-2,x+5,y-1,36)
            pset(x+3,y-2,63)
          end
          if tile==MUD then
            pset(x+3,y-1,(cx%3==0) and 6 or 10)
            if cx%5==0 then line(x+5,y,x+5,y+4,10) end
          end
        end
        if not solid(mget(cx-1,cy)) then line(x,y+1,x,y+7,59) end
        if not solid(mget(cx+1,cy)) then line(x+7,y+1,x+7,y+7,52) end
        if tile==STEEL then
          line(x+1,y+4,x+6,y+4,52)
          if (cx+cy)%3==0 then circfill(x+4,y+5,1,13) end
          if (cx*7+cy)%5==0 then pset(x+2,y+6,31) end
        end
        if tile==GIRDER then
          line(x+1,y+2,x+6,y+6,55) line(x+6,y+2,x+1,y+6,52)
          pset(x+1,y+2,13) pset(x+6,y+2,13)
        elseif tile==MUD and (cx+cy)%2==0 then
          line(x+2,y+1,x+2,y+5,6) pset(x+5,y+2,11)
          pset(x+6,y+5,9)
        elseif tile==BREAKABLE then
          rect(x+1,y+1,x+6,y+6,35)
          line(x+1,y+1,x+6,y+6,36) line(x+6,y+1,x+1,y+6,36)
          pset(x+3,y+3,31)
        end
      elseif tile==ACID then
        local bob=(frame_now+cx*7)%18
        line(x,y+1,x+7,y+1,(cx+frame_now)%4<2 and 10 or 6)
        fillp(0x5a5a,8) rectfill(x,y+3,x+7,y+7,9) fillp()
        if bob<5 then circ(x+2+(cx%3)*2,y+2,1,bob<2 and 31 or 6) end
      end
    end
  end
end

local function draw_world()
  local sx=shake>0 and flr(rnd(5))-2 or 0
  local sy=shake>0 and flr(rnd(5))-2 or 0
  clip(0,HUD_H,SW,SH-HUD_H)
  camera(camera_x-sx,camera_y-HUD_H-sy)
  draw_zone_architecture()
  map()
  draw_terrain_detail()
  for i=1,#level.props do
    local p=level.props[i]
    if not (boss_started and p[2]>=810) then draw_prop(p) end
  end
  for i=1,#secrets do draw_secret(secrets[i],i) end
  for i=1,#pickups do draw_pickup(pickups[i],i) end
  for i=1,#bombs do draw_bomb(bombs[i],i) end
  for i=1,#level.checkpoints do
    local c=level.checkpoints[i]
    line(c[1],c[2]+16,c[1],c[2]-8,i<=checkpoint_index and 6 or 13)
    rectfill(c[1],c[2]-8,c[1]+19,c[2]+2,i<=checkpoint_index and 11 or 52)
    print("CP"..i,c[1]+3,c[2]-6,63)
  end
  draw_boss_gate()
  draw_exit()
  draw_bullets()
  for i=1,#enemies do draw_enemy(enemies[i],i) end
  draw_particles_world()
  draw_grapple_hint()
  draw_tongue()
  draw_fire_fx()
  draw_laser_fx()
  draw_player()
  camera()
  clip()
end

local function draw_hud()
  clip(0,0,SW,HUD_H)
  cls(49)
  rectfill(1,1,SW-2,HUD_H-2,48)
  line(2,2,SW-3,2,59)
  line(2,HUD_H-3,SW-3,HUD_H-3,41)
  rectfill(2,3,55,12,49)
  rectfill(59,3,126,12,49)
  rectfill(130,3,189,12,49)
  print("VIT",4,5,59)
  for i=1,player_max_hp do
    local x=20+(i-1)*7
    local alive=i<=player_hp
    circfill(x-2,6,2,alive and 6 or 34)
    circfill(x+2,6,2,alive and 6 or 34)
    rectfill(x-3,7,x+3,10,alive and 7 or 50)
    pset(x-2,5,alive and 11 or 52) pset(x+2,5,alive and 11 or 52)
    pset(x-2,6,alive and 48 or 49) pset(x+2,6,alive and 48 or 49)
    line(x-2,9,x+2,9,alive and 14 or 52)
  end
  line(57,3,57,12,52) line(128,3,128,12,52)
  if mutation=="LASER EYES" then
    circfill(66,7,3,10) circfill(73,7,3,10)
    pset(66,7,63) pset(73,7,63)
    print("LASER",82,5,10)
  elseif mutation=="FIRE BREATH" then
    circfill(69,8,4,5) circ(69,8,4,4)
    pset(71,6,63)
    print("FIRE",82,5,4)
  else
    rect(65,4,73,10,52)
    print("WILD",82,5,58)
  end
  if combo>1 then print("X"..combo,124,5,31,"right") end
  print("$"..score,187,5,31,"right")
  clip()
  if boss_started and not exit_open then
    rectfill(25,18,167,28,48)
    rect(25,18,167,28,59)
    print("BUZZKILL",30,20,63)
    local boss=enemies[#enemies]
    rectfill(76,20,150,25,50)
    rectfill(77,21,77+flr(71*boss.hp/boss.max_hp),24,
      boss.phase_id==1 and 3 or boss.phase_id==2 and 4 or 36)
    pset(78,21,63)
    print("P"..(boss.phase_id or 1),162,20,boss.vulnerable and 31 or 10,"right")
  end
end

