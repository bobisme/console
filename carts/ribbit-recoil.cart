  if banner_timer<=0 then return end
  local y=SH-14
  rectfill(2,y,189,y+11,48)
  rect(2,y,189,y+11,59)
  line(5,y+2,186,y+2,41)
  rectfill(6,y+4,10,y+8,36)
  print(banner,14,y+4,banner_timer%10<7 and 63 or 31)
end

