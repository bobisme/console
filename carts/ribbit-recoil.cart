local function draw_title()
  local oldx,oldy=camera_x,camera_y
  camera_x,camera_y=0,208
  draw_backdrop()
  camera_x,camera_y=oldx,oldy
  rect(2,2,SW-3,SH-3,55)
  line(5,5,26,5,13) line(5,5,5,26,13)
  line(SW-6,5,SW-27,5,13) line(SW-6,5,SW-6,26,13)
  -- Hero tableau echoes the in-game scale instead of a smooth logo blob.
  rectfill(53,103,138,109,50)
  line(53,102,138,102,59)
  for x=57,134,12 do pset(x,105,13) end
  sspr(0,0,16,16,75,54,44,44,false,false)
  local lick=129+sin(t()*0.65)*8
  line(112,72,lick,57,46)
  circfill(lick,57,2,46)
  aspr("gnat.fly",142,52,-8,true,false)
  aspr("gnat.fly",46,80,-20,false,false)
  rectfill(17,116,174,176,48)
  rect(17,116,174,176,15)
  rect(21,120,170,172,52)
  print("R I B B I T",65,128,6)
  print("R E C O I L",59,145,4)
  line(39,160,152,160,41)
  print("TONGUE-BASED REGIME CHANGE",37,165,31)
  if show_guide then
    rectfill(18,188,173,276,49)
    rect(18,188,173,276,55)
    line(22,192,169,192,13)
    print("D-PAD  MOVE + AIM",54,199,63)
    print("HOLD A  STICK TO TERRAIN",42,214,46)
    print("REEL UP/DOWN - RELEASE = LAUNCH",27,229,31)
    print("B  MUTATION / DOWN+B SWAP",38,244,10)
    print("DEFEAT UPPER MANAGEMENT",39,259,4)
    print("NO JUMP. LICK THE CEILING.",38,270,59)
  end
  print(frame_now%80<58 and "A/B  DEPLOY FROG" or "   PRESS THE BAD IDEA",53,286,63)
  print("MENU  TOGGLE BRIEFING",55,304,58)
end

local function draw_win()
  local oldx,oldy=camera_x,camera_y
  camera_x,camera_y=0,208
  draw_backdrop()
  camera_x,camera_y=oldx,oldy
  for i=0,17 do
    local a=i/18
    line(96,102,96+cos(a)*120,102+sin(a)*120,i%2==0 and 4 or 14)
  end
  rectfill(16,24,175,285,59)
  rect(16,24,175,285,63)
  rect(20,28,171,281,36)
  print("THE DAILY CROAK",64,37,48)
  line(28,49,163,49,48)
  print("FROG BECOMES TOO POWERFUL",39,58,36)
  sspr(0,0,16,16,76,72,40,40,false,false)
  print("MOSQUITO ECONOMY IN TATTERS",34,119,48)
  line(29,131,162,131,48)
  print("SCORE         "..score,39,143,41)
  print("TIME          "..run_time(),39,158,41)
  print("BUGS          "..bugs_defeated,39,173,41)
  print("MAX COMBO     X"..max_combo,39,188,41)
  print("DE-FROGGINGS  "..deaths,39,203,41)
  print("SECRET FLIES  "..secrets_found.."/"..#secrets,39,218,41)
  rectfill(61,235,130,255,48)
  rect(61,235,130,255,36)
  print("RANK  "..run_rank(),78,243,31)
  print("NEXT: CANOPY CONVEYOR",51,267,8)
  print("A/B  COMMIT ANOTHER INCIDENT",34,294,63)
end

function _draw()
  reset_draw_state()
  if game_scene=="title" then draw_title()
  elseif game_scene=="win" then draw_win()
  else
    draw_backdrop()
    draw_world()
    draw_hud()
    draw_banner()
    if paused then draw_pause() end
    if fire_timer>0 then
      for y=HUD_H,SH-1,3 do rshift(y,sin(t()*4+y/13)) end
    end
  end
  if transition>0 then
    mosaic(transition>9 and 8 or transition>6 and 4 or transition>3 and 2 or 1)
  end
  if flash>0 then
    for c=0,63 do pal(c,flash%2==0 and 63 or 31,1) end
  end
end

-- Deliberate, deterministic test hooks for console-agent scenarios.
function dev_status()
  local alive=0
  for i=1,#enemies do if enemies[i].alive and enemies[i].kind~=E_BOSS then alive=alive+1 end end
  local boss=enemies[#enemies]
  return {scene=game_scene,level=game_level,x=player_x,y=player_y,vx=vx,vy=vy,
    grounded=grounded,hp=player_hp,score=score,combo=combo,deaths=deaths,
    tongue=tongue_state,latched=tongue_state=="latched",rope=rope_len,
    mutation=mutation,laser=laser_unlocked,fire=fire_unlocked,
    bugs=alive,boss_started=boss_started,boss_hp=boss and boss.hp or 0,
    boss_defeated=boss_defeated,exit_open=exit_open,checkpoint=checkpoint_index,
    boss_phase=boss and boss.phase_id or 0,boss_vulnerable=boss and boss.vulnerable or false,
    boss_attack=boss and boss.attack_clock or 0,boss_telegraph=boss and boss.telegraph or 0,
    boss_salvo1=boss and boss.phase_salvos[1] or 0,
    boss_salvo2=boss and boss.phase_salvos[2] or 0,
    boss_salvo3=boss and boss.phase_salvos[3] or 0,
    bullets=#bullets,camera_x=camera_x,camera_y=camera_y,
    particles=#particles,explosions=#explosions,elapsed=run_frames,
    kills=bugs_defeated,max_combo=max_combo,secrets=secrets_found,rank=run_rank()}
end

function dev_warp(x,y)
  player_x,player_y,vx,vy=x,y,0,0
  grounded=false
  reset_tongue()
  camera_x=mid(0,x-SW*0.42,WORLD_W-SW)
  camera_y=mid(0,y-(SH-HUD_H)*0.56,WORLD_H-(SH-HUD_H))
end

function dev_grant(which)
  if which=="laser" or which=="all" then laser_unlocked=true mutation="LASER EYES" end
  if which=="fire" or which=="all" then fire_unlocked=true mutation="FIRE BREATH" end
  if which=="all" then laser_unlocked=true fire_unlocked=true end
  weapon_cooldown=0
end

function dev_start_boss()
  start_boss()
  boss_intro=0
end

function dev_damage_boss(amount)
  local e=enemies[#enemies]
  e.hurt=0
  damage_enemy(e,amount,"headless accountability")
end

function dev_boss_vulnerable()
  local e=enemies[#enemies]
  e.stun=90
  e.vulnerable=true
end

function dev_explode(x,y,power)
  add_explosion(x,y,power or 4,true)
end

function dev_spawn_enemy(kind,x,y)
  local code=kind=="beetle" and E_BEETLE or kind=="wasp" and E_WASP or E_GNAT
  local e=make_enemy({code,x,y,0})
  e.home_x,e.home_y,e.range=x,y,0
  table.insert(enemies,#enemies,e)
  return #enemies-1
end

function dev_enemy_hp(index)
  local e=enemies[index]
  return e and e.hp or -1
end

