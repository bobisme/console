local GLYPH_R={30,17,17,30,20,18,17}
local GLYPH_I={31,4,4,4,4,4,31}
local GLYPH_B={30,17,17,30,17,17,30}
local GLYPH_T={31,4,4,4,4,4,4}
local GLYPH_E={31,16,16,30,16,16,31}
local GLYPH_C={15,16,16,16,16,16,15}
local GLYPH_O={14,17,17,17,17,17,14}
local GLYPH_L={16,16,16,16,16,16,31}

local function draw_logo_word(letters,cx,y,scale,main,highlight,shadow)
  local advance=6*scale
  local width=#letters*advance-scale
  local x0=flr(cx-width/2)
  for li=1,#letters do
    local glyph=letters[li]
    for row=1,7 do
      local mask=glyph[row]
      for col=0,4 do
        if flr(mask/(2^(4-col)))%2==1 then
          local x=x0+(li-1)*advance+col*scale
          local py=y+(row-1)*scale
          rectfill(x+2,py+2,x+scale+1,py+scale+1,shadow)
          rectfill(x,py,x+scale-1,py+scale-1,main)
          line(x,py,x+scale-1,py,highlight)
        end
      end
    end
  end
end

local function draw_title()
  cls(49)
  rectfill(0,0,191,118,40)
  rectfill(0,119,191,190,41)
  -- Clean moon and two city depths frame, rather than compete with, the logo.
  fillp(0xaaaa,40) circfill(154,82,38,14) fillp()
  circfill(154,82,29,60) circ(154,82,30,63) circ(154,82,33,10)
  circfill(145,74,6,56) circfill(163,90,7,55) circ(164,69,4,52)
  for i=0,8 do
    local x=i*25-8 local h=24+(i*13)%40
    rectfill(x,190-h,x+18,190,50)
    line(x+2,190-h+2,x+16,190-h+2,54)
    for wy=190-h+9,185,9 do pset(x+5,wy,i%3==0 and 31 or 13) end
  end
  for a=0,5 do
    line(96,103,96+cos(a/6)*118,103+sin(a/6)*80,52)
  end
  rect(2,2,SW-3,SH-3,59)
  rect(5,5,SW-6,SH-6,50)
  line(7,7,40,7,31) line(7,7,7,40,31)
  line(184,7,151,7,10) line(184,7,184,40,10)

  -- One unified, high-contrast industrial lockup.
  draw_logo_word({GLYPH_R,GLYPH_I,GLYPH_B,GLYPH_B,GLYPH_I,GLYPH_T},96,15,2,14,63,48)
  draw_logo_word({GLYPH_R,GLYPH_E,GLYPH_C,GLYPH_O,GLYPH_I,GLYPH_L},96,34,2,38,31,48)
  line(39,51,153,51,63)
  line(45,54,145,54,46)
  circfill(37,51,3,46) circfill(155,51,3,46)
  rectfill(43,58,149,68,48)
  rect(43,58,149,68,59)
  print("MUTANT FROG STRIKES BACK",96,61,31,"center")

  -- Dynamic key art: airborne frog, active tongue, recoil lines, readable prey.
  for ray=0,6 do
    local a=ray/7
    line(73,132,73+cos(a)*58,132+sin(a)*48,ray%2==0 and 10 or 52)
  end
  draw_frog_pose(72,171,"air",false,2)
  line(91,135,142,106,46) line(91,136,142,107,47)
  circfill(143,106,3,46)
  draw_gnat(156,102,true,false)
  draw_wasp(30,118,false,false)
  line(52,174,20,181,10) line(55,178,26,191,52)
  rectfill(17,181,175,188,48)
  rect(17,181,175,188,59)
  for x=23,169,12 do line(x,183,x+6,187,52) line(x+6,183,x,187,52) end

  -- One calm instruction card with a fixed hierarchy.
  if show_guide then
    rectfill(24,202,167,251,48)
    rect(24,202,167,251,59)
    rect(28,206,163,247,49)
    print("QUICK START",96,208,31,"center")
    line(34,216,157,216,41)
    print("A  HOP",40,221,31) print("B  TONGUE",103,221,46)
    print("D-PAD  RUN + AIM",96,231,63,"center")
    print("DOWN+A  MUTATION",96,240,10,"center")
  else
    rectfill(24,207,167,248,48)
    rect(24,207,167,248,59)
    print("THE MOSQUITO COMPLEX",96,215,31,"center")
    print("TONGUE FIRST. QUESTIONS NEVER.",96,231,63,"center")
  end
  rectfill(33,270,159,293,35)
  rect(32,269,160,294,63)
  print(frame_now%80<58 and "PRESS A  DEPLOY FROG" or "PRESS A  BAD IDEA",96,278,63,"center")
end

local function draw_win()
  cls(49)
  rectfill(0,0,191,319,40)
  rectfill(0,104,191,319,41)
  -- Celebratory burst, confetti, and a stage make the ending the visual peak.
  fillp(0xaaaa,41) circfill(96,143,86,14) fillp()
  for i=0,23 do
    local a=i/24
    line(96,145,96+cos(a)*118,145+sin(a)*118,
      i%3==0 and 31 or i%3==1 and 10 or 36)
  end
  circfill(96,145,65,40)
  circ(96,145,67,63) circ(96,145,72,31)
  for i=0,17 do
    local x=(i*37+frame_now)%188+2
    local y=48+(i*29)%150
    line(x,y,x+(i%3)-1,y+4,i%3==0 and 31 or i%3==1 and 10 or 36)
  end
  rect(3,3,188,316,59)
  rectfill(14,13,177,49,48)
  rect(13,12,178,50,63)
  print("MOSQUITO REGIME",96,20,31,"center")
  print("TERMINATED",96,32,63,"center")
  line(23,43,169,43,36)
  rectfill(40,52,152,64,48)
  rect(40,52,152,64,52)
  print("COLONEL BUZZKILL: FIRED",96,56,38,"center")

  draw_frog_pose(63,183,"victory",false,2)
  draw_buzzkill({x=121,y=139,phase_id=3,dir=-1},false)
  line(116,117,174,181,36) line(174,117,116,181,36)
  rectfill(12,184,180,194,48)
  rect(11,183,181,195,59)
  for x=17,175,12 do line(x,186,x+6,191,52) line(x+6,186,x,191,52) end
  rectfill(36,197,156,208,48)
  rect(36,197,156,208,52)
  print("NO ARMS. NO MASTERS. NO HR.",96,200,31,"center")

  rectfill(25,214,166,258,48)
  rect(24,213,167,259,59)
  print("SCORE",34,221,59) print(score,157,221,63,"right")
  print("TIME",34,233,59) print(run_time(),157,233,63,"right")
  print("BUGS DE-FUNDED",34,245,59) print(bugs_defeated,157,245,63,"right")
  rectfill(53,265,139,286,35)
  rect(52,264,140,287,31)
  print("DISASTER RANK",96,268,59,"center")
  print(run_rank(),96,278,31,"center")
  rectfill(31,292,161,310,36)
  rect(30,291,162,311,63)
  print("PRESS A  NEXT INCIDENT",96,297,63,"center")
end

function _draw()
  reset_draw_state()
  if game_scene=="title" then draw_title()
  elseif game_scene=="win" then draw_win()
  else
    draw_backdrop()
    draw_world()
    draw_hud()
    draw_banner()
    if paused then draw_pause() end
    if fire_timer>0 then
      local heat_y=flr(player_y+6-camera_y+HUD_H)
      for y=max(HUD_H,heat_y-10),min(SH-1,heat_y+10),2 do
        rshift(y,sin(t()*4+y/13))
      end
    end
  end
  if transition>0 then
    mosaic(transition>9 and 8 or transition>6 and 4 or transition>3 and 2 or 1)
  end
  if flash>0 then
    for c=0,63 do pal(c,flash%2==0 and 63 or 31,1) end
  end
end

-- Deliberate, deterministic test hooks for console-agent scenarios.
function dev_status()
  local alive=0
  for i=1,#enemies do if enemies[i].alive and enemies[i].kind~=E_BOSS then alive=alive+1 end end
  local boss=enemies[#enemies]
  return {scene=game_scene,level=game_level,x=player_x,y=player_y,vx=vx,vy=vy,
    grounded=grounded,hp=player_hp,score=score,combo=combo,deaths=deaths,
    respawn=respawn_timer,coyote=coyote_timer,hop_buffer=hop_buffer,
    hops=hops,landings=landings,movement_fx=movement_fx,
    tongue=tongue_state,tongue_x=tongue_x,tongue_y=tongue_y,
    latched=tongue_state=="latched",rope=rope_len,
    mutation=mutation,laser=laser_unlocked,fire=fire_unlocked,
    bugs=alive,boss_started=boss_started,boss_hp=boss and boss.hp or 0,
    boss_defeated=boss_defeated,boss_x=boss and boss.x or 0,boss_y=boss and boss.y or 0,
    exit_open=exit_open,checkpoint=checkpoint_index,
    boss_phase=boss and boss.phase_id or 0,boss_vulnerable=boss and boss.vulnerable or false,
    boss_attack=boss and boss.attack_clock or 0,boss_telegraph=boss and boss.telegraph or 0,
    boss_salvo1=boss and boss.phase_salvos[1] or 0,
    boss_salvo2=boss and boss.phase_salvos[2] or 0,
    boss_salvo3=boss and boss.phase_salvos[3] or 0,
    bullets=#bullets,camera_x=camera_x,camera_y=camera_y,
    particles=#particles,explosions=#explosions,elapsed=run_frames,
    kills=bugs_defeated,max_combo=max_combo,secrets=secrets_found,rank=run_rank()}
end

function dev_warp(x,y)
  player_x,player_y,vx,vy=x,y,0,0
  grounded=false
  reset_tongue()
  camera_x=mid(0,x-SW*0.42,WORLD_W-SW)
  camera_y=mid(0,y-(SH-HUD_H)*0.56,WORLD_H-(SH-HUD_H))
end

function dev_grant(which)
  if which=="laser" or which=="all" then laser_unlocked=true mutation="LASER EYES" end
  if which=="fire" or which=="all" then fire_unlocked=true mutation="FIRE BREATH" end
  if which=="all" then laser_unlocked=true fire_unlocked=true end
  weapon_cooldown=0
end

function dev_start_boss()
  start_boss()
  boss_intro=0
end

function dev_damage_boss(amount)
  local e=enemies[#enemies]
  e.hurt=0
  damage_enemy(e,amount,"headless accountability")
end

function dev_boss_vulnerable()
  local e=enemies[#enemies]
  e.stun=90
  e.vulnerable=true
end

function dev_explode(x,y,power)
  add_explosion(x,y,power or 4,true)
end

function dev_spawn_enemy(kind,x,y)
  local code=kind=="beetle" and E_BEETLE or kind=="wasp" and E_WASP or E_GNAT
  local e=make_enemy({code,x,y,0})
  e.home_x,e.home_y,e.range=x,y,0
  table.insert(enemies,#enemies,e)
  return #enemies-1
end

function dev_enemy_hp(index)
  local e=enemies[index]
  return e and e.hp or -1
end

