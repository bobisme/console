local GLYPH_R={30,17,17,30,20,18,17}
local GLYPH_I={31,4,4,4,4,4,31}
local GLYPH_B={30,17,17,30,17,17,30}
local GLYPH_T={31,4,4,4,4,4,4}
local GLYPH_E={31,16,16,30,16,16,31}
local GLYPH_C={15,16,16,16,16,16,15}
local GLYPH_O={14,17,17,17,17,17,14}
local GLYPH_L={16,16,16,16,16,16,31}

local function draw_logo_word(letters,cx,y,scale,main,highlight,shadow)
  local advance=6*scale
  local width=#letters*advance-scale
  local x0=flr(cx-width/2)
  for li=1,#letters do
    local glyph=letters[li]
    for row=1,7 do
      local mask=glyph[row]
      for col=0,4 do
        if flr(mask/(2^(4-col)))%2==1 then
          local x=x0+(li-1)*advance+col*scale
          local py=y+(row-1)*scale
          rectfill(x+2,py+2,x+scale+1,py+scale+1,shadow)
          rectfill(x,py,x+scale-1,py+scale-1,main)
          line(x,py,x+scale-1,py,highlight)
        end
      end
    end
  end
end

local function draw_title()
  cls(49)
  rectfill(0,0,191,118,40)
  rectfill(0,119,191,190,41)
  -- Clean moon and two city depths frame, rather than compete with, the logo.
  fillp(0xaaaa,40) circfill(154,82,38,14) fillp()
  circfill(154,82,29,60) circ(154,82,30,63) circ(154,82,33,10)
  circfill(145,74,6,56) circfill(163,90,7,55) circ(164,69,4,52)
  for i=0,8 do
    local x=i*25-8 local h=24+(i*13)%40
    rectfill(x,190-h,x+18,190,50)
    line(x+2,190-h+2,x+16,190-h+2,54)
    for wy=190-h+9,185,9 do pset(x+5,wy,i%3==0 and 31 or 13) end
  end
  for a=0,5 do
    line(96,103,96+cos(a/6)*118,103+sin(a/6)*80,52)
  end
  rect(2,2,SW-3,SH-3,59)
  rect(5,5,SW-6,SH-6,50)
  line(7,7,40,7,31) line(7,7,7,40,31)
  line(184,7,151,7,10) line(184,7,184,40,10)

  -- One unified, high-contrast industrial lockup.
  draw_logo_word({GLYPH_R,GLYPH_I,GLYPH_B,GLYPH_B,GLYPH_I,GLYPH_T},96,15,2,14,63,48)
  draw_logo_word({GLYPH_R,GLYPH_E,GLYPH_C,GLYPH_O,GLYPH_I,GLYPH_L},96,34,2,38,31,48)
  line(39,51,153,51,63)
  line(45,54,145,54,46)
  circfill(37,51,3,46) circfill(155,51,3,46)
  rectfill(43,58,149,68,48)
  rect(43,58,149,68,59)
  print("MUTANT FROG STRIKES BACK",96,61,31,"center")

  -- Dynamic key art: airborne frog, active tongue, recoil lines, readable prey.
  for ray=0,6 do
    local a=ray/7
    line(73,132,73+cos(a)*58,132+sin(a)*48,ray%2==0 and 10 or 52)
  end
  draw_frog_pose(72,171,"rise",false,2)
  line(91,135,142,106,46) line(91,136,142,107,47)
  circfill(143,106,3,46)
  draw_gnat(156,102,true,false)
  draw_wasp(30,118,false,false)
  line(52,174,20,181,10) line(55,178,26,191,52)
  rectfill(17,181,175,188,48)
  rect(17,181,175,188,59)
  for x=23,169,12 do line(x,183,x+6,187,52) line(x+6,183,x,187,52) end

  -- One calm instruction card with a fixed hierarchy.
  if show_guide then
    rectfill(24,202,167,251,48)
    rect(24,202,167,251,59)
    rect(28,206,163,247,49)
    print("QUICK START",96,208,31,"center")
    line(34,216,157,216,41)
    print("A  HOP",40,221,31) print("B  TONGUE",103,221,46)
    print("D-PAD  RUN + AIM",96,231,63,"center")
    print("DOWN+A  MUTATION",96,240,10,"center")
  else
    rectfill(24,207,167,248,48)
    rect(24,207,167,248,59)
    print("THE MOSQUITO COMPLEX",96,215,31,"center")
    print("TONGUE FIRST. QUESTIONS NEVER.",96,231,63,"center")
  end
  rectfill(33,270,159,293,35)
  rect(32,269,160,294,63)
  print(frame_now%80<58 and "PRESS A  DEPLOY FROG" or "PRESS A  BAD IDEA",96,278,63,"center")
end

