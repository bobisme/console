__meta__
title=Micro Dash
author=console-core
version=0

__lua__
-- micro dash -- console-core demo cart
-- deterministic: no wall clock, no math.random, no pairs() iteration.

local px, py            -- player position (top-left of the 8x8 sprite)
local face_left         -- sprite flip
local burst_col         -- particle colour, cycled by A
local stars = {}        -- background starfield, laid out from rnd() in _init
local parts = {}        -- particle list
local bursts = 0        -- how many times A has been pressed

local PW = 8            -- player sprite size
local SPEED = 2
local SW, SH = 192, 320 -- display geometry

-- ANIMATIONS ---------------------------------------------------------------
-- Every frame list, fps and loop flag lives in __gfx_meta__; aspr() plays it
-- straight from there, so nothing about the sheet layout is duplicated here.
--
-- aspr is STATELESS: the frame is a pure function of (frame_count - t0), so a
-- cart stores an ORIGIN -- the frame a state change happened on -- rather than
-- a tick counter or an animation object. Ambient loops leave t0 out entirely
-- and phase-lock to the global clock (the star, the gem, the moth below).
--
-- The other difference from spr(): aspr draws from the sprite's declared
-- anchor=, not its top-left. player is anchored at the feet (4,7), star and
-- gem at their centres (4,4), the moth on its thorax (8,8), so every position
-- below is the meaningful point rather than a corner.
local WALK_FPS = 8      -- __gfx_meta__'s `anim player.walk ... fps=8`

local walking           -- true = playing player.walk, false = player.idle
local walk_t0, idle_t0  -- frame-count origins for those two anims

-- Which walk frame is showing: aspr does this internally, but the 1px bob
-- needs to know, so it repeats the same integer math -- floor(elapsed * fps /
-- 60) wrapped by the frame count -- rather than tracking a second counter.
local function walk_frame(f)
  return flr((f - walk_t0) * WALK_FPS / 60) % anim_len("player.walk")
end

function _init()
  px, py = 92, 232
  face_left = false
  burst_col = 10
  show_help = true
  -- Standing still from frame 0. The origins sit one frame back so that the
  -- first drawn frame is already one frame into the cycle.
  walking = false
  walk_t0, idle_t0 = -1, -1
  for i = 1, 42 do
    stars[i] = {
      x = flr(rnd(SW)),
      y = flr(rnd(246)),
      c = 5 + flr(rnd(3)) * 4,   -- 5, 9 or 13
      p = flr(rnd(60)),          -- twinkle phase
    }
  end
  printh("micro dash init")
  -- mellow 2-pattern loop on channels 0 (triangle bass) and 1 (pulse melody);
  -- channels 2 and 3 stay free so blips never steal the tune.
  music(0)
end

local function spawn_burst()
  for i = 1, 14 do
    local a = rnd(1)
    local sp = 0.4 + rnd(1.4)
    parts[#parts + 1] = {
      x = px + PW / 2,
      y = py + PW / 2,
      dx = cos(a) * sp,
      dy = sin(a) * sp - 0.6,
      life = 20 + flr(rnd(24)),
      c = burst_col,
    }
  end
end

function _update()
  local f = flr(t() * 60)
  local dx, dy = 0, 0
  if btn(0) then dx = dx - SPEED end
  if btn(1) then dx = dx + SPEED end
  if btn(2) then dy = dy - SPEED end
  if btn(3) then dy = dy + SPEED end
  if dx < 0 then face_left = true elseif dx > 0 then face_left = false end

  px = mid(0, px + dx, SW - PW)
  py = mid(0, py + dy, SH - PW)

  -- Walk vs idle. Each cycle gets its own origin, captured the frame the
  -- state changes, so neither one teleports to whatever phase the global
  -- clock happens to be at: setting off always starts on the contact frame
  -- and stopping always starts the breathing idle from its first frame.
  local moving = dx ~= 0 or dy ~= 0
  if moving ~= walking then
    walking = moving
    if moving then walk_t0 = f - 1 else idle_t0 = f - 1 end
  end

  if btnp(4) then
    bursts = bursts + 1
    burst_col = 8 + (bursts % 8)
    spawn_burst()
    sfx(4)                    -- bright blip, auto channel (2 or 3)
    printh("burst " .. bursts .. " at frame " .. flr(t() * 60))
  end

  if btnp(5) then
    px, py = 92, 232
    parts = {}
    -- Restart the walk cycle here: t0 = this frame means aspr shows frame 0.
    walking, walk_t0 = true, f
    sfx(5)                    -- low thud, auto channel (2 or 3)
    printh("reset at frame " .. flr(t() * 60))
  end

  if btnp(6) then
    show_help = not show_help
    printh("help " .. (show_help and "on" or "off"))
  end

  for i = #parts, 1, -1 do
    local p = parts[i]
    p.x = p.x + p.dx
    p.y = p.y + p.dy
    p.dy = p.dy + 0.05
    p.life = p.life - 1
    if p.life <= 0 or p.y > SH then
      table.remove(parts, i)
    end
  end
end

function _draw()
  cls(0)

  -- four-band dusk, plus distant skyline and layered hills. The extra canvas
  -- is real composition space rather than a stretched version of the old one.
  rectfill(0, 0, SW - 1, 63, 15)
  rectfill(0, 64, SW - 1, 127, 8)
  rectfill(0, 128, SW - 1, 191, 7)
  rectfill(0, 192, SW - 1, 249, 6)

  for x = 0, SW - 1, 16 do
    local peak = 176 + flr(sin(x / 128 + 0.13) * 11)
    line(x, 207, x + 8, peak, 2)
    line(x + 8, peak, x + 16, 207, 2)
  end
  for x = 0, SW - 1, 8 do
    local ridge = 218 + flr(sin(x / 96 + 0.41) * 7)
    rectfill(x, ridge, x + 8, 249, 1)
  end

  -- moon
  circfill(154, 38, 17, 4)
  circfill(146, 31, 14, 8)
  circ(154, 38, 17, 12)

  -- starfield (twinkles on a frame counter, not a clock)
  local f = flr(t() * 60)
  for i = 1, #stars do
    local s = stars[i]
    if (f + s.p) % 64 < 46 then
      pset(s.x, s.y, s.c)
    end
  end

  -- luna moth drifting across the sky on a deterministic triangle path:
  -- 15 s out, 15 s back, flipped to face the way it is going. 2x2 megatile,
  -- drawn from the anchor (thorax centre) so the flap does not shift it.
  local mph = (f % 1800) / 1800
  local mx, mflip
  if mph < 0.5 then
    mx, mflip = -20 + mph * 2 * (SW + 40), false
  else
    mx, mflip = SW + 20 - (mph - 0.5) * 2 * (SW + 40), true
  end
  local my = 96 + sin(t() * 0.11) * 19   -- clear of the moon and the star
  -- No t0: the flap is ambient, so it phase-locks to the global frame count.
  -- (x, y) is the thorax anchor, so the 2x2 megatile centres itself.
  aspr("moth.flap", flr(mx), flr(my), 0, mflip, false)

  -- collectible star sprite, bobbing + spinning; anchored at its centre
  aspr("star.twinkle", 28, 54 + flr(sin(t() * 0.5) * 4))
  aspr("gem.sparkle", 166, 170 + flr(cos(t() * 0.35) * 5))

  -- ground
  rectfill(0, 250, SW - 1, SH - 1, 7)
  for x = 0, SW - 1, 4 do
    local h = 250 + flr(sin(x / 96 + t() * 0.25) * 3)
    line(x, h, x, 250, 6)
    if x % 16 == 0 then pset(x + 2, h + 5, 10) end
  end
  if show_help then
    rectfill(4, 292, SW - 5, 315, 15)
    rect(5, 293, SW - 6, 314, 6)
  end

  -- particles
  for i = 1, #parts do
    local p = parts[i]
    if p.life > 8 then
      circfill(p.x, p.y, 1, p.c)
    else
      pset(p.x, p.y, p.c)
    end
  end

  -- player + shadow. Walking runs player.walk at 8 fps with a 1px bob on the
  -- passing frames (kept out of the pixels so `sprite lint` still reports
  -- zero centroid drift); standing runs the 2 fps breathing idle.
  circfill(px + 4, py + 9, 3, 15)
  -- (px + 4, py + 7) is the feet anchor of the 8x8 player tile, so this draws
  -- exactly where the old top-left spr(pspr, px, py) call did.
  if walking then
    local bob = (walk_frame(f) % 2 == 1) and -1 or 0  -- passing frames ride 1px higher
    aspr("player.walk", px + 4, py + 7 + bob, walk_t0, face_left, false)
  else
    aspr("player.idle", px + 4, py + 7, idle_t0, face_left, false)
  end
  rect(px - 2, py - 2, px + 9, py + 9, burst_col)

  -- hud
  print("MICRO DASH", 4, 4, 12)
  print("T=" .. flr(t() * 10) / 10, 4, 12, 11)
  print("BURSTS=" .. bursts, 4, 20, 11)
  if show_help then
    print("ARROWS MOVE  A BURST  B RESET", 8, 298, 13)
    print("X HELP   PARTICLES=" .. #parts, 8, 307, 14)
  end
end

