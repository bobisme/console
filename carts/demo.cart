__meta__
title=Micro Dash
author=console-core
version=0

__lua__
-- micro dash -- console-core demo cart
-- deterministic: no wall clock, no math.random, no pairs() iteration.

local px, py            -- player position (top-left of the 8x8 sprite)
local face_left         -- sprite flip
local burst_col         -- particle colour, cycled by A
local stars = {}        -- background starfield, laid out from rnd() in _init
local parts = {}        -- particle list
local bursts = 0        -- how many times A has been pressed

local PW = 8            -- player sprite size
local SPEED = 2

-- ANIM TABLES --------------------------------------------------------------
-- These duplicate the frame lists in __gfx_meta__ by hand: the runtime cannot
-- read that section (it is authoring metadata only), and there is no aspr()
-- helper yet -- SPEC lists it as out of scope for the PoC, "revisit once
-- __gfx_meta__ proves out". If aspr(name, x, y, ...) ever lands, every
-- ANIM_* table and the frame() helper below collapse into one call each.
--
-- Each entry is {sprite ids..., fps = N}. Sprite id = ty*16 + tx, so the
-- frame-offset convention in __gfx_meta__ (tx' = (tx + i*w) % 16) shows up
-- here as literal sheet indices.
local ANIM_WALK    = { 1, 2, 3, 4,    fps = 8 }   -- player.walk   tiles 1-4
local ANIM_IDLE    = { 5, 6,          fps = 2 }   -- player.idle   tiles 5-6
local ANIM_TWINKLE = { 8, 9, 10, 11,  fps = 8 }   -- star.twinkle  tiles 8-11
local ANIM_SPARKLE = { 12, 13,        fps = 4 }   -- gem.sparkle   tiles 12-13
-- moth is 2x2, so its frames wrap off the right edge of band ty=2 into band
-- ty=4: tiles (12,2),(14,2),(0,4),(2,4) => ids 44, 46, 64, 66.
local ANIM_FLAP    = { 44, 46, 64, 66, fps = 6 }  -- moth.flap

-- Which entry of an anim is showing at `ticks`; integer-only, so the result is
-- bit-identical on every target.
local function anim_index(a, ticks)
  return flr(ticks * a.fps / 60) % #a
end

local function frame(a, ticks)
  return a[anim_index(a, ticks) + 1]
end

local walk_t = 0        -- ticks spent moving (drives player.walk)
local idle_t = 0        -- ticks spent standing (drives player.idle)

function _init()
  px, py = 68, 176
  face_left = false
  burst_col = 10
  show_help = true
  walk_t, idle_t = 0, 0
  for i = 1, 28 do
    stars[i] = {
      x = flr(rnd(144)),
      y = flr(rnd(196)),
      c = 5 + flr(rnd(3)) * 4,   -- 5, 9 or 13
      p = flr(rnd(60)),          -- twinkle phase
    }
  end
  printh("micro dash init")
  -- mellow 2-pattern loop on channels 0 (triangle bass) and 1 (pulse melody);
  -- channels 2 and 3 stay free so blips never steal the tune.
  music(0)
end

local function spawn_burst()
  for i = 1, 14 do
    local a = rnd(1)
    local sp = 0.4 + rnd(1.4)
    parts[#parts + 1] = {
      x = px + PW / 2,
      y = py + PW / 2,
      dx = cos(a) * sp,
      dy = sin(a) * sp - 0.6,
      life = 20 + flr(rnd(24)),
      c = burst_col,
    }
  end
end

function _update()
  local dx, dy = 0, 0
  if btn(0) then dx = dx - SPEED end
  if btn(1) then dx = dx + SPEED end
  if btn(2) then dy = dy - SPEED end
  if btn(3) then dy = dy + SPEED end
  if dx < 0 then face_left = true elseif dx > 0 then face_left = false end

  px = mid(0, px + dx, 144 - PW)
  py = mid(0, py + dy, 256 - PW)

  -- Walk vs idle: the cycles advance on their own tick counters (not on t())
  -- so the stride freezes mid-step when you stop instead of teleporting to
  -- whatever phase the global clock happens to be at.
  if dx ~= 0 or dy ~= 0 then
    walk_t, idle_t = walk_t + 1, 0
  else
    idle_t = idle_t + 1
  end

  if btnp(4) then
    bursts = bursts + 1
    burst_col = 8 + (bursts % 8)
    spawn_burst()
    sfx(4)                    -- bright blip, auto channel (2 or 3)
    printh("burst " .. bursts .. " at frame " .. flr(t() * 60))
  end

  if btnp(5) then
    px, py = 68, 176
    parts = {}
    walk_t, idle_t = 0, 0
    sfx(5)                    -- low thud, auto channel (2 or 3)
    printh("reset at frame " .. flr(t() * 60))
  end

  if btnp(6) then
    show_help = not show_help
    printh("help " .. (show_help and "on" or "off"))
  end

  for i = #parts, 1, -1 do
    local p = parts[i]
    p.x = p.x + p.dx
    p.y = p.y + p.dy
    p.dy = p.dy + 0.05
    p.life = p.life - 1
    if p.life <= 0 or p.y > 256 then
      table.remove(parts, i)
    end
  end
end

function _draw()
  cls(0)

  -- sky
  rectfill(0, 0, 143, 63, 15)
  rectfill(0, 64, 143, 127, 8)

  -- moon
  circfill(110, 30, 13, 4)
  circfill(104, 25, 11, 8)
  circ(110, 30, 13, 12)

  -- starfield (twinkles on a frame counter, not a clock)
  local f = flr(t() * 60)
  for i = 1, #stars do
    local s = stars[i]
    if (f + s.p) % 64 < 46 then
      pset(s.x, s.y, s.c)
    end
  end

  -- luna moth drifting across the sky on a deterministic triangle path:
  -- 15 s out, 15 s back, flipped to face the way it is going. 2x2 megatile,
  -- drawn from the anchor (thorax centre) so the flap does not shift it.
  local mph = (f % 1800) / 1800
  local mx, mflip
  if mph < 0.5 then
    mx, mflip = -20 + mph * 2 * 184, false
  else
    mx, mflip = 164 - (mph - 0.5) * 2 * 184, true
  end
  local my = 76 + sin(t() * 0.11) * 16   -- clear of the moon and the star
  spr(frame(ANIM_FLAP, f), flr(mx) - 8, flr(my) - 8, 2, 2, mflip, false)

  -- collectible star sprite, bobbing + spinning
  spr(frame(ANIM_TWINKLE, f), 20, 40 + flr(sin(t() * 0.5) * 4))
  spr(frame(ANIM_SPARKLE, f), 118, 150 + flr(cos(t() * 0.35) * 5))

  -- ground
  rectfill(0, 200, 143, 255, 7)
  for x = 0, 143, 4 do
    local h = 200 + flr(sin(x / 96 + t() * 0.25) * 3)
    line(x, h, x, 200, 6)
  end
  if show_help then
    rectfill(4, 232, 139, 251, 15)
  end

  -- particles
  for i = 1, #parts do
    local p = parts[i]
    if p.life > 8 then
      circfill(p.x, p.y, 1, p.c)
    else
      pset(p.x, p.y, p.c)
    end
  end

  -- player + shadow. Walking runs player.walk at 8 fps with a 1px bob on the
  -- passing frames (kept out of the pixels so `sprite lint` still reports
  -- zero centroid drift); standing runs the 2 fps breathing idle.
  circfill(px + 4, py + 9, 3, 15)
  local pspr, bob
  if idle_t == 0 then
    local wi = anim_index(ANIM_WALK, walk_t)
    pspr = ANIM_WALK[wi + 1]
    bob = (wi % 2 == 1) and -1 or 0     -- passing frames ride 1px higher
  else
    pspr, bob = frame(ANIM_IDLE, idle_t), 0
  end
  spr(pspr, px, py + bob, 1, 1, face_left, false)
  rect(px - 2, py - 2, px + 9, py + 9, burst_col)

  -- hud
  print("MICRO DASH", 4, 4, 12)
  print("T=" .. flr(t() * 10) / 10, 4, 12, 11)
  print("BURSTS=" .. bursts, 4, 20, 11)
  if show_help then
    print("ARROWS MOVE  A BURST  B RESET", 6, 238, 13)
    print("PARTS=" .. #parts, 6, 245, 14)
  end
end

