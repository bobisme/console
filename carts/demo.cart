__gfx_meta__
# Sprite/anim metadata for the sheet above. This is the ONLY place the frame
# lists live: the Lua plays them with aspr("<sprite>.<label>", x, y, [t0]),
# which reads this section at runtime, so editing an anim here changes what
# the cart draws.
#
# Sheet layout
#   band ty=0 : tile  0     blank (kept empty on purpose)
#               tiles 1-6   player   (walk 0-3, idle 4-5)
#               tiles 8-11  star     (twinkle 0-3)
#               tiles 12-13 gem      (sparkle 0-1)
#   band ty=2 : tiles 12-15 moth     frames 0-1 (2x2 megatiles)
#   band ty=4 : tiles 0-3   moth     frames 2-3. Explicit tile coordinates
#                                    preserve this layout on the 32-wide atlas.

# Player. Anchor is the feet (ground contact), bottom-centre of the tile.
sprite player rect=1,0 size=1x1 anchor=4,7
# contact / passing / contact' / passing'. The animated pixels (2 hands +
# 6 leg pixels) hold a constant count and a constant coordinate sum in every
# frame, so `sprite lint` reports 0.00 centroid drift and 0% area drift.
anim player.walk frames=0,1,2,3 fps=8 loop
# Breathing idle: frame 5 is frame 4 settled 1px into its own shoulders.
anim player.idle frames=4,5 fps=2 loop

# Collectible star: spins 45 deg per frame (+ -> 8-point -> x -> 8-point) and
# pulses in size as it goes (32/24/28/20 lit pixels), so it twinkles as well
# as turns. Anchor is the visual centre, not the feet -- it floats.
sprite star rect=8,0 size=1x1 anchor=4,4
anim star.twinkle frames=0,1,2,3 fps=8 loop

# Gem: the facet glint slides across and two sparks orbit it.
sprite gem rect=12,0 size=1x1 anchor=4,4
anim gem.sparkle frames=0,1 fps=4 loop

# Luna moth, 2x2 megatile. Anchor = visual centre of mass (the thorax),
# which is where the drift numbers should be measured from for a flier.
sprite moth rect=12,2 size=2x2 anchor=8,8
# spread -> up-stroke -> folded -> down-stroke.
anim moth.flap frames=12:2,14:2,0:4,2:4 fps=6 loop

__sfx__
# background tune: Am - F - C - G, speed 8 (7.5 rows/sec, 16 rows = ~2.1 s/bar-pair).
# sfx 0/2 = triangle bass, 1/3 = pulse melody, 4 = A blip, 5 = B thud.
# repeated rows hold a note (same freq+wave, so the volume just glides);
# `---` is the breath before the next chord.

sfx 0 speed=8
A2 3 5
A2 3 5
A2 3 4
---
E3 3 4
E3 3 4
E3 3 3
E3 3 2
F2 3 5
F2 3 5
F2 3 4
---
C3 3 4
C3 3 4
C3 3 3
C3 3 2

sfx 1 speed=8
A4 1 4
A4 1 3
C5 1 4
C5 1 3
E5 1 4
E5 1 4
E5 1 3
---
D5 1 4
D5 1 3
C5 1 4
C5 1 3
A4 1 4
A4 1 3
A4 1 2
---

sfx 2 speed=8
C3 3 5
C3 3 5
C3 3 4
---
G2 3 4
G2 3 4
G2 3 3
G2 3 2
G2 3 5
G2 3 5
G2 3 4
---
D3 3 4
D3 3 4
D3 3 3
D3 3 2

sfx 3 speed=8
G4 1 4
G4 1 3
B4 1 4
B4 1 3
D5 1 4
D5 1 4
D5 1 3
---
B4 1 4
B4 1 3
A4 1 4
A4 1 3
G4 1 4
G4 1 3
G4 1 2
---

sfx 4 speed=2
E6 0 6
B6 0 5
E7 0 3

sfx 5 speed=3
A1 3 7
F1 3 5
C1 3 3

__music__
pat 0 : 0 1 - -
pat 1 loop=0 : 2 3 - -
