__meta__
title=Sound Test
author=console-core
version=0

__lua__
-- sound test -- a listening session for the PoC v2 synth.
--
-- UP/DOWN browse the menu, A plays the highlighted entry (every entry is a
-- self-looping music pattern, so it repeats until you stop it), B stops.
-- Nothing here reads the clock or rnd(): the picture is a pure function of
-- (selection, playing, frame counter).

local entries = {
  { n = "WAVE 0  PULSE 12.5%", p = 0,
    d1 = "THIN AND NASAL. CUTS THROUGH", d2 = "A BUSY MIX. CLASSIC NES LEAD." },
  { n = "WAVE 1  PULSE 25%", p = 1,
    d1 = "ROUNDER THAN 12.5%. THE",       d2 = "DEFAULT MELODY VOICE." },
  { n = "WAVE 2  SQUARE 50%", p = 2,
    d1 = "HOLLOW, WOODY, LOUDEST ODD",    d2 = "HARMONICS. GOOD FOR FLUTES." },
  { n = "WAVE 3  TRIANGLE", p = 3,
    d1 = "SOFT AND DARK. BASS AND",       d2 = "KICK DRUMS LIVE HERE." },
  { n = "WAVE 4  SAW", p = 4,
    d1 = "BRIGHT AND BUZZY, EVERY",       d2 = "HARMONIC. BIG LEADS, STRINGS." },
  { n = "WAVE 5  NOISE", p = 5,
    d1 = "LFSR NOISE CLOCKED FROM THE",   d2 = "NOTE. PITCHED HISS, DRUMS." },
  { n = "VIBRATO  OFF", p = 6,
    d1 = "SUSTAINED FLUTE PHRASE, DEAD",  d2 = "FLAT. PLAY THIS THEN THE NEXT." },
  { n = "VIBRATO  ON", p = 7,
    d1 = "SAME PHRASE, VIB=40,8,8: 40",   d2 = "CENTS AT 7.5HZ. WIDER AT THE END." },
  { n = "ARPEGGIO CHORDS", p = 8,
    d1 = "ARP3,7 / ARP4,7 OVER A BASS.",  d2 = "ONE VOICE FAKING A TRIAD." },
  { n = "PITCH SLIDES", p = 9,
    d1 = "SL+7, SL-3, SL+12, SL-14.",     d2 = "PORTAMENTO ACROSS EACH ROW." },
  { n = "DRUM KIT", p = 10,
    d1 = "KICK/SNARE/HAT AS INSTRUMENTS", d2 = "- SWEEP + ENV, NO SAMPLES." },
  { n = "TWO-PULSE ECHO", p = 11,
    d1 = "CH0 MELODY, CH1 THE SAME TWO",  d2 = "ROWS LATER AND QUIETER." },
  { n = "FULL GROOVE", p = 12,
    d1 = "BASS, VIBRATO LEAD, DRUMS AND", d2 = "AN ARP BED. ALL FOUR CHANNELS." },
  { n = "SATURATION A/B", p = 12,
    d1 = "THE GROOVE, TWO BARS CLEAN THEN", d2 = "TWO DRIVEN. MASTER() FROM LUA." },
  { n = "ECHO  DELAY BUS", p = 13,
    d1 = "FOUR NOTES IN 32 ROWS. ECHO",   d2 = "(24,5,6) FILLS EVERY GAP." },
  { n = "WAVETABLE W0-W2", p = 14,
    d1 = "HOLLOW + BUZZ LEAD OVER AN",    d2 = "ORGAN PAD. 32 NIBBLES EACH." },
}

-- The A/B entry plays the groove and flips the master bus underneath it.
-- `master` is cart-global, so a dry-bar/wet-bar comparison can only come from
-- the runtime setter, never from the __instruments__ line - which is why this
-- cart declares no master line at all and every other entry renders exactly as
-- it did before the output stage existed.
local AB = 14

-- Same reasoning for the echo bus: `echo` is cart-global too, so the ECHO
-- entry switches it on from Lua and every other entry runs `echo(0)`. The
-- *send* is per-instrument and lives in the cart (`inst echo_lead ... echo=7`),
-- so no other voice can reach the delay line even while it is running.
--
-- 24 frames = 400ms = three rows at speed 8: the dotted-eighth delay. The
-- melody deliberately leaves seven empty rows after every note, because echo
-- is only audible in the gaps - a busy part just smears.
local ECHO = 15
local ECHO_DELAY = 24
local ECHO_FEEDBACK = 5
local ECHO_LEVEL = 6

-- 112 BPM, 4 rows/beat, speed=auto=8 frames/row -> 16 rows = 128 frames = one
-- bar. The groove's patterns are 32 rows, so flipping every two bars lands the
-- change exactly on the pattern's own loop point.
local BAR_FRAMES = 128
local AB_BARS = 2

local sel = 1
local playing = 0     -- 0 = stopped, else the entry index
local frame = 0
local started = 0     -- frame the current entry began, for the A/B clock
local driven = false  -- which half of the A/B cycle we are in

function _init()
  sel = 1
  playing = 0
  frame = 0
  started = 0
  driven = false
  master(0)
  echo(0)
end

function _update()
  frame = frame + 1
  if btnp(2) then
    sel = sel - 1
    if sel < 1 then sel = #entries end
  end
  if btnp(3) then
    sel = sel + 1
    if sel > #entries then sel = 1 end
  end
  if btnp(4) then
    music(entries[sel].p)
    playing = sel
    started = frame
  end
  if btnp(5) then
    music(-1)
    playing = 0
  end

  -- The only place in the cart that touches the output stage. Every entry but
  -- the last one is explicitly clean, so switching away from the A/B entry
  -- restores the legacy path on the very next frame.
  if playing == AB then
    driven = flr((frame - started) / (AB_BARS * BAR_FRAMES)) % 2 == 1
    if driven then master(4, 2) else master(0) end
  else
    driven = false
    master(0)
  end

  -- ...and the only place that touches the echo bus. `echo(0)` is idempotent
  -- and cheap: the delay line is only flushed on the running -> off edge, so
  -- calling it every frame costs nothing.
  if playing == ECHO then
    echo(ECHO_DELAY, ECHO_FEEDBACK, ECHO_LEVEL)
  else
    echo(0)
  end
end

-- A level meter driven by nothing fancier than the entry index: one bar per
-- entry, the first `sel` of them lit, the lit tip blinking while something is
-- playing. 16 bars at an 8px pitch keep the last one inside the 144px screen.
local function meter(y)
  for i = 1, #entries do
    local x = 6 + (i - 1) * 8
    local h = 1 + i
    local c = 15
    if i <= sel then
      c = 11
      if i > #entries - 3 then c = 8 elseif i > #entries - 6 then c = 10 end
      if i == sel and playing ~= 0 and frame % 30 < 15 then c = 12 end
    end
    rectfill(x, y + 16 - h, x + 6, y + 16, c)
  end
end

function _draw()
  cls(1)

  -- header
  rectfill(0, 0, 143, 16, 15)
  print("SOUND TEST", 4, 3, 12)
  print("A PLAY  B STOP", 4, 10, 13)

  -- menu
  -- 16 entries at 8px a row run from y=20 to y=140 (the highlight band ends at
  -- 146), which is why the meter starts at 148 rather than 144.
  local top = 20
  for i = 1, #entries do
    local y = top + (i - 1) * 8
    local c = 13
    if i == sel then
      rectfill(2, y - 1, 141, y + 6, 15)
      c = 12
      print(">", 4, y, 10)
    end
    if i == playing then
      print("*", 136, y, 11)
      c = 11
    end
    print(entries[i].n, 10, y, c)
  end

  -- meter
  meter(148)

  -- description of the highlighted entry
  local e = entries[sel]
  rectfill(2, 176, 141, 205, 15)
  print(e.n, 5, 179, 10)
  print(e.d1, 5, 188, 12)
  print(e.d2, 5, 195, 12)

  -- status
  if playing ~= 0 then
    print("PLAYING: " .. entries[playing].n, 4, 214, 11)
    print("PATTERN " .. entries[playing].p .. "  LOOPING", 4, 222, 13)
  else
    print("STOPPED", 4, 214, 8)
    print("UP/DOWN BROWSE   A AUDITIONS", 4, 222, 13)
  end
  print(#entries .. " ENTRIES  " .. sel .. "/" .. #entries, 4, 236, 6)
  print("112 BPM  4 ROWS/BEAT  SPEED=AUTO", 4, 244, 6)

  -- A/B banner: the label has to flip on the same frame the bus does, so it
  -- reads straight off `driven` rather than recomputing the clock.
  if playing == AB then
    rectfill(2, 168, 141, 174, 15)
    if driven then
      print("DRIVEN  MASTER(4,2)", 5, 168, 8)
    else
      print("DRY     MASTER(0)", 5, 168, 11)
    end
  elseif playing == ECHO then
    rectfill(2, 168, 141, 174, 15)
    print("ECHO(" .. ECHO_DELAY .. "," .. ECHO_FEEDBACK .. "," .. ECHO_LEVEL
          .. ")  SEND 7/8", 5, 168, 11)
  end
end

__instruments__
# Melodic voices. `env`'s sustain is an *absolute* level, not a fraction of
# the row volume, so an instrument that carries an envelope is only used with
# row volumes at or above its sustain - otherwise quiet rows swell back up to
# it. Voices that want per-row dynamics (lead, chord) simply carry no env.
#
# Vibrato rate is LFO phase units per frame out of 64, so one cycle takes
# 64/rate frames: rate 8 = 7.5Hz, rate 12 = 11.25Hz. The delay has to fit
# inside the row or the vibrato never gets to speak - the 24-frame flute rows
# can afford 8 frames of delay, the 8-frame groove rows only 2.
inst lead      wave=1
inst lead_vib  wave=1 vib=16,12,2
inst flute     wave=2 env=8,10,5
inst flute_vib wave=2 env=8,10,5 vib=28,8,8
inst pluck     wave=1 env=0,10,3
inst bass      wave=3 env=0,6,4
inst chord     wave=0
inst echo      wave=1 env=0,6,2

# The one voice in this cart wired to the echo bus. `echo=7` is 7/8 of the
# voice into the delay line - a deliberately heavy send, because the point of
# entry 15 is to hear the bus rather than to sit tastefully behind a mix.
#
# `env=0,12,0` makes it a pluck that is gone after 12 frames (a row and a
# half), so what fills the remaining six and a half rows of every gap is
# nothing but the delay line and its feedback. Note also that the `echo` key
# is a *mixer* property: this instrument still resolves its pitch and volume
# through exactly the same code an env-only instrument does.
inst echo_lead wave=1 env=0,12,0 echo=7

# Percussion is just instruments: an ordinary note row gives the sweep its
# start pitch and the envelope does the rest.
#
# `duck=3,8` makes the kick a sidechain trigger: every kick row pulls the OTHER
# three channels down by 3/7 over ~1ms and lets them climb back over 8 frames.
# The kick's own channel is exempt, so it punches through instead of fighting
# the bass. Entry 11 (DRUM KIT) uses the same instrument, so its snare and hat
# duck under the kick too - which is the effect in isolation, worth hearing.
inst kick      wave=3 sweep=-18,4 env=0,8,0 duck=3,8
inst snare     wave=5 sweep=-8,3  env=0,5,0
inst hat       wave=5 env=0,2,0

# ---- wavetables: 32 nibbles = one single cycle, 4 bits per sample ---------
# Nibble n plays at (2n-15)/15, so 0 is -1.0, f is +1.0 and the ladder is
# symmetric: sample x and sample (15-x) are exact opposites. There is no code
# for zero, so a DC-free table pairs every 8 with a 7 - each of these three
# sums to exactly zero.
#
# w0 HOLLOW: odd harmonics only (1 + 0.35*3rd + 0.15*5th). Reedy and woody,
#            the Game Boy wave-channel sound.
# w1 ORGAN:  drawbars - fundamental + octave/2 + twelfth/3 + 15th/5. Round,
#            churchy, and much darker than the saw.
# w2 BUZZ:   two rising ramps per cycle, offset. Gritty and bright, with a
#            strong octave-up edge; the aliasing on the steps is the point.
wavetable 0 8cefeede eedeefec 73101121 11211013
wavetable 1 8beffecb bbbaa988 77765544 44310014
wavetable 2 78899aab bccddeef 01122334 45566778

# A wavetable is just another wave source, so all the usual machinery applies:
# `env` shapes it, `vib` bends its phase increment, the fx column arps and
# slides it, and `echo=` would send it to the delay bus.
#
# `wt_organ` deliberately carries no envelope: its rows repeat the same note
# so the pad *holds*, and a re-stated note with the same pitch, wave and volume
# is a no-op in the mixer (no click guard, no phase reset). An env would
# retrigger its attack on every row and turn the pad into a tremolo.
inst wt_hollow wave=w0 env=0,10,4
inst wt_organ  wave=w1
inst wt_buzz   wave=w2 env=0,9,3 vib=22,10,3

