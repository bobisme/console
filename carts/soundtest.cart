sfx 25 speed=64
# One strike a chord, and the ROW is what holds it: 4 rows x 64 frames is the
# same 256-frame bar as 32 rows x 8, but a rest would cut the bell off dead
# (rests are silence on this console, not release), so the ring has to be the
# row's own length shaped by `env`.
E6 fm_bell 5
C6 fm_bell 4
G6 fm_bell 5
D6 fm_bell 4

# ---- 26-29: periodic noise + tremolo -------------------------------------
# ch0 a wave-7 bassline written four octaves up (heard A1 A1 C2 A1 G1 G1 D2 E2),
# ch1 white-noise hats on wave 5 so both noise modes play at once, ch2 the
# tremolo pad, ch3 a wave-7 tom with a sweep on it.
sfx 26 speed=auto
A5 psg_bass 6
