# The pad's rows are eight times as long as the bass's (speed=64, two rows to
# its thirty-two) for the same reason the FM bell's are: the tremolo LFO is
# measured from NOTE-ON, so a chord restated every 8 frames would restart the
# wobble eight times a bar instead of letting four whole cycles breathe.
sfx 28 speed=64
A3 trem_pad 5
G3 trem_pad 5

sfx 29 speed=auto
E6 psg_tom 6
