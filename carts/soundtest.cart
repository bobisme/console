__meta__
title=Sound Test
author=console-core
version=0

__lua__
-- sound test -- a listening session for the PoC v2 synth.
--
-- UP/DOWN browse the menu, A plays the highlighted entry (every entry is a
-- self-looping music pattern, so it repeats until you stop it), B stops.
-- Nothing here reads the clock or rnd(): the picture is a pure function of
-- (selection, playing, frame counter).

local entries = {
  { n = "WAVE 0  PULSE 12.5%", p = 0,
    d1 = "THIN AND NASAL. CUTS THROUGH", d2 = "A BUSY MIX. CLASSIC NES LEAD." },
  { n = "WAVE 1  PULSE 25%", p = 1,
    d1 = "ROUNDER THAN 12.5%. THE",       d2 = "DEFAULT MELODY VOICE." },
  { n = "WAVE 2  SQUARE 50%", p = 2,
    d1 = "HOLLOW, WOODY, LOUDEST ODD",    d2 = "HARMONICS. GOOD FOR FLUTES." },
  { n = "WAVE 3  TRIANGLE", p = 3,
    d1 = "SOFT AND DARK. BASS AND",       d2 = "KICK DRUMS LIVE HERE." },
  { n = "WAVE 4  SAW", p = 4,
    d1 = "BRIGHT AND BUZZY, EVERY",       d2 = "HARMONIC. BIG LEADS, STRINGS." },
  { n = "WAVE 5  NOISE", p = 5,
    d1 = "LFSR NOISE CLOCKED FROM THE",   d2 = "NOTE. PITCHED HISS, DRUMS." },
  { n = "VIBRATO  OFF", p = 6,
    d1 = "SUSTAINED FLUTE PHRASE, DEAD",  d2 = "FLAT. PLAY THIS THEN THE NEXT." },
  { n = "VIBRATO  ON", p = 7,
    d1 = "SAME PHRASE, VIB=40,8,8: 40",   d2 = "CENTS AT 7.5HZ. WIDER AT THE END." },
  { n = "ARPEGGIO CHORDS", p = 8,
    d1 = "ARP3,7 / ARP4,7 OVER A BASS.",  d2 = "ONE VOICE FAKING A TRIAD." },
  { n = "PITCH SLIDES", p = 9,
    d1 = "SL+7, SL-3, SL+12, SL-14.",     d2 = "PORTAMENTO ACROSS EACH ROW." },
  { n = "DRUM KIT", p = 10,
    d1 = "KICK/SNARE/HAT AS INSTRUMENTS", d2 = "- SWEEP + ENV, NO SAMPLES." },
  { n = "TWO-PULSE ECHO", p = 11,
    d1 = "CH0 MELODY, CH1 THE SAME TWO",  d2 = "ROWS LATER AND QUIETER." },
  { n = "FULL GROOVE", p = 12,
    d1 = "BASS, VIBRATO LEAD, DRUMS AND", d2 = "AN ARP BED. ALL FOUR CHANNELS." },
}

local sel = 1
local playing = 0     -- 0 = stopped, else the entry index
local frame = 0

function _init()
  sel = 1
  playing = 0
  frame = 0
end

function _update()
  frame = frame + 1
  if btnp(2) then
    sel = sel - 1
    if sel < 1 then sel = #entries end
  end
  if btnp(3) then
    sel = sel + 1
    if sel > #entries then sel = 1 end
  end
  if btnp(4) then
    music(entries[sel].p)
    playing = sel
  end
  if btnp(5) then
    music(-1)
    playing = 0
  end
end

-- A level meter driven by nothing fancier than the entry index: 13 bars, the
-- first `sel` of them lit, the lit tip blinking while something is playing.
local function meter(y)
  for i = 1, #entries do
    local x = 6 + (i - 1) * 10
    local h = 2 + i
    local c = 15
    if i <= sel then
      c = 11
      if i > #entries - 3 then c = 8 elseif i > #entries - 6 then c = 10 end
      if i == sel and playing ~= 0 and frame % 30 < 15 then c = 12 end
    end
    rectfill(x, y + 16 - h, x + 6, y + 16, c)
  end
end

function _draw()
  cls(1)

  -- header
  rectfill(0, 0, 143, 16, 15)
  print("SOUND TEST", 4, 3, 12)
  print("A PLAY  B STOP", 4, 10, 13)

  -- menu
  local top = 22
  for i = 1, #entries do
    local y = top + (i - 1) * 9
    local c = 13
    if i == sel then
      rectfill(2, y - 1, 141, y + 6, 15)
      c = 12
      print(">", 4, y, 10)
    end
    if i == playing then
      print("*", 136, y, 11)
      c = 11
    end
    print(entries[i].n, 10, y, c)
  end

  -- meter
  meter(150)

  -- description of the highlighted entry
  local e = entries[sel]
  rectfill(2, 176, 141, 205, 15)
  print(e.n, 5, 179, 10)
  print(e.d1, 5, 188, 12)
  print(e.d2, 5, 195, 12)

  -- status
  if playing ~= 0 then
    print("PLAYING: " .. entries[playing].n, 4, 214, 11)
    print("PATTERN " .. entries[playing].p .. "  LOOPING", 4, 222, 13)
  else
    print("STOPPED", 4, 214, 8)
    print("UP/DOWN BROWSE   A AUDITIONS", 4, 222, 13)
  end
  print("13 ENTRIES  " .. sel .. "/" .. #entries, 4, 236, 6)
  print("112 BPM  4 ROWS/BEAT  SPEED=AUTO", 4, 244, 6)
end

__instruments__
# Melodic voices. `env`'s sustain is an *absolute* level, not a fraction of
# the row volume, so an instrument that carries an envelope is only used with
# row volumes at or above its sustain - otherwise quiet rows swell back up to
# it. Voices that want per-row dynamics (lead, chord) simply carry no env.
#
# Vibrato rate is LFO phase units per frame out of 64, so one cycle takes
# 64/rate frames: rate 8 = 7.5Hz, rate 12 = 11.25Hz. The delay has to fit
# inside the row or the vibrato never gets to speak - the 24-frame flute rows
# can afford 8 frames of delay, the 8-frame groove rows only 2.
inst lead      wave=1
inst lead_vib  wave=1 vib=16,12,2
inst flute     wave=2 env=8,10,5
inst flute_vib wave=2 env=8,10,5 vib=28,8,8
inst pluck     wave=1 env=0,10,3
inst bass      wave=3 env=0,6,4
inst chord     wave=0
inst echo      wave=1 env=0,6,2

# Percussion is just instruments: an ordinary note row gives the sweep its
# start pitch and the envelope does the rest.
inst kick      wave=3 sweep=-18,4 env=0,8,0
inst snare     wave=5 sweep=-8,3  env=0,5,0
inst hat       wave=5 env=0,2,0

